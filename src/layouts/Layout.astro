---
import { ClientRouter } from "astro:transitions";
import AppShell from "../components/AppShell";
import { db } from "../db";
import { profile } from "../db/schema";
import { eq } from "drizzle-orm";
import { AUTH_COOKIE, isAuthed } from "../lib/auth";
import "../styles/global.css";

// 字体自托管（@fontsource）：同源加载不依赖 Google，大陆网络不再受 fonts.googleapis.com 波动影响；
// CSS 内建 unicode-range 分片，中文只下载页面实际用到的字库切片
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource/noto-sans-sc/400.css";
import "@fontsource/noto-sans-sc/500.css";
import "@fontsource/noto-sans-sc/700.css";
import "@fontsource/noto-serif-sc/400.css";
import "@fontsource/noto-serif-sc/500.css";
import "@fontsource/noto-serif-sc/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";

interface Props {
  title: string;
  description?: string;
  /** 封面图路径（/uploads/...），社交分享卡片用；data URL 等无效形式由调用方过滤 */
  ogImage?: string;
  ogType?: string;
}

const { title, description, ogImage, ogType = "website" } = Astro.props;

// OG / canonical 需要绝对地址：以当前请求的协议 + 域名 + 端口为基准
const siteOrigin = Astro.url.origin.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageAbs = ogImage ? new URL(ogImage, siteOrigin).href : undefined;
const desc = description || title;

// 登录态和用户名在服务端就绪，作为 props 下发给岛屿：
// 客户端不用再发 /api/auth/me + /api/profile，登录用户也不会先闪一下「登录」按钮
const authed = isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value);
const row = db.select({ name: profile.name, avatar: profile.avatar }).from(profile).where(eq(profile.id, 1)).get();
const userName = row?.name || "kaven";
const userAvatar = row?.avatar || "";
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <title>{title} | kaven的个人网页</title>
    <!-- 页面转场：ClientRouter 拦截导航做客户端换页，默认交叉淡入淡出 -->
    <ClientRouter />
    <!-- Open Graph / Twitter Card：聊天与社交平台分享链接时的卡片数据 -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="kaven的个人网页" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    <meta name="twitter:card" content={ogImageAbs ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="kaven的个人网页" href="/rss.xml" />
    <!-- 外观偏好定档：深色/主题色/字号/字体/护眼，全部走 localStorage；
         apply 同时挂 astro:after-swap——ClientRouter 转场会用新页面的 SSR html 属性
         覆盖当前值导致偏好丢失（实测踩坑），转场完成后需重新应用 -->
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const saved = localStorage.getItem("theme");
            const dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.classList.toggle("dark", dark);
            // 主题色板：珊瑚红（默认）/青/紫/琥珀/玫红，存于 localStorage["theme-color"]
            const color = localStorage.getItem("theme-color");
            if (color && color !== "coral") document.documentElement.dataset.theme = color;
            else delete document.documentElement.dataset.theme;
            // 阅读偏好：正文字号 / 字体风格 / 护眼模式
            const fs = localStorage.getItem("font-size");
            if (fs && fs !== "normal") document.documentElement.dataset.fontSize = fs;
            else delete document.documentElement.dataset.fontSize;
            const font = localStorage.getItem("font-style");
            if (font && font !== "serif") document.documentElement.dataset.font = font;
            else delete document.documentElement.dataset.font;
            if (localStorage.getItem("eye-comfort") === "on") document.documentElement.dataset.eye = "on";
            else delete document.documentElement.dataset.eye;
          } catch {}
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <!-- 自托管字体声明（postbuild 从主 CSS 抽出 626 个 @font-face）：非阻塞加载，
         主 CSS 不再被 732KB 字体表拖住首屏；字体 display:swap 异步晚到无妨。
         dev 模式无 postbuild 产物，404 回退系统字体，属预期 -->
    <link rel="stylesheet" href="/fonts.css" media="print" onload="this.media='all'" />
  </head>
  <body>
    <AppShell client:load authed={authed} userName={userName} userAvatar={userAvatar}>
      <slot />
    </AppShell>
  </body>
</html>
