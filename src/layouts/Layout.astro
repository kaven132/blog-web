---
import AppShell from "../components/AppShell";
import { db } from "../db";
import { profile } from "../db/schema";
import { eq } from "drizzle-orm";
import { AUTH_COOKIE, isAuthed } from "../lib/auth";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// 登录态和用户名在服务端就绪，作为 props 下发给岛屿：
// 客户端不用再发 /api/auth/me + /api/profile，登录用户也不会先闪一下「登录」按钮
const authed = isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value);
const row = db.select({ name: profile.name }).from(profile).where(eq(profile.id, 1)).get();
const userName = row?.name || "kaven";
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || title} />
    <title>{title} | kaven的个人网页</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 非阻塞加载：大陆访问 googleapis 不稳定，不能让它挡住首屏渲染；
         加载完成前用系统字体显示（字体本身就是 display=swap） -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Noto+Serif+SC:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Noto+Serif+SC:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>
  </head>
  <body>
    <AppShell client:load authed={authed} userName={userName}>
      <slot />
    </AppShell>
  </body>
</html>
