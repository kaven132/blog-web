---
import Layout from "../../layouts/Layout.astro";
import TagFilter from "../../components/TagFilter.astro";
import Pagination from "../../components/Pagination.astro";
import { db } from "../../db";
import { comments, posts, likes } from "../../db/schema";
import { desc, eq, sql } from "drizzle-orm";
import { parseTags, buildTagFacets } from "../../lib/tags";
import { AUTH_COOKIE, isAuthed } from "../../lib/auth";
import { formatDateCN } from "../../lib/datetime";

if (!isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value)) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const l1 = Astro.url.searchParams.get("l1") || "";
const l2 = Astro.url.searchParams.get("l2") || "";
const l3 = Astro.url.searchParams.get("l3") || "";

// 管理列表只取元数据，不带 content 大字段
const allPosts = db
  .select({
    id: posts.id,
    title: posts.title,
    slug: posts.slug,
    excerpt: posts.excerpt,
    tags: posts.tags,
    coverImage: posts.coverImage,
    published: posts.published,
    createdAt: posts.createdAt,
  })
  .from(posts)
  .orderBy(desc(posts.createdAt))
  .all()
  .map((p) => ({ ...p, tagList: parseTags(p.tags) }));

const filtered = allPosts.filter((p) => {
  if (l1 && p.tagList[0] !== l1) return false;
  if (l2 && p.tagList[1] !== l2) return false;
  if (l3 && p.tagList[2] !== l3) return false;
  return true;
});

// 分页：计数（l1Counts 等）始终基于全量，只有渲染的列表按页切片
const PAGE_SIZE = 30;
const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(totalPages, Math.max(1, Number(Astro.url.searchParams.get("page")) || 1));
const pageItems = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const pageUrl = (p: number) => {
  const q = new URLSearchParams();
  if (l1) q.set("l1", l1);
  if (l2) q.set("l2", l2);
  if (l3) q.set("l3", l3);
  if (p > 1) q.set("page", String(p));
  const qs = q.toString();
  return qs ? `/admin?${qs}` : "/admin";
};

const isFiltering = Boolean(l1 || l2 || l3);
const breadcrumb = [l1, l2, l3].filter(Boolean).join(" · ");
const facets = buildTagFacets(allPosts.map((p) => p.tagList), l1, l2);

// ── 数据总览：全站统计 + 浏览量 Top5 ──
const totalViews = db.select({ v: sql<number>`coalesce(sum(${posts.views}), 0)` }).from(posts).get()?.v ?? 0;
const totalLikes = db.select({ v: sql<number>`coalesce(sum(${likes.count}), 0)` }).from(likes).get()?.v ?? 0;
const totalComments = db.select({ n: sql<number>`count(*)` }).from(comments).get()?.n ?? 0;
const totalPosts = allPosts.filter((p) => p.published).length;
const draftCount = allPosts.length - totalPosts;
const topViewed = db
  .select({ title: posts.title, slug: posts.slug, views: posts.views })
  .from(posts)
  .where(eq(posts.published, true))
  .orderBy(desc(posts.views))
  .limit(5)
  .all();

// 最新评论（管理）：联文章标题，倒序 20 条
const recentComments = db
  .select({
    id: comments.id,
    author: comments.author,
    content: comments.content,
    createdAt: comments.createdAt,
    parentId: comments.parentId,
    postTitle: posts.title,
  })
  .from(comments)
  .leftJoin(posts, eq(comments.postId, posts.id))
  .orderBy(desc(comments.createdAt))
  .limit(20)
  .all();
---

<Layout title="文章管理">
  <div class="max-w-4xl mx-auto py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-1">Admin</p>
        <h1 class="text-2xl font-bold tracking-[-0.01em]">文章管理</h1>
      </div>
      <a
        href="/write"
        class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-semibold rounded-xl bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" strokeWidth={2} viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        写文章
      </a>
    </div>

    <!-- 数据总览 -->
    <section class="mb-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {[
          { label: "已发布文章", value: String(totalPosts), sub: `草稿 ${draftCount}` },
          { label: "总浏览量", value: String(totalViews), sub: "详情页累计" },
          { label: "总点赞", value: String(totalLikes), sub: "全部文章" },
          { label: "总评论", value: String(totalComments), sub: "含回复" },
        ].map((s) => (
          <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4">
            <p class="text-[10px] font-semibold tracking-[0.12em] uppercase text-[var(--color-text-subtle)]">{s.label}</p>
            <p class="text-2xl font-bold tabular-nums text-[var(--color-text)] mt-1">{s.value}</p>
            <p class="text-[11px] text-[var(--color-text-subtle)] mt-0.5">{s.sub}</p>
          </div>
        ))}
      </div>

      {topViewed.length > 0 && (
        <div class="mt-3 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4">
          <p class="text-[10px] font-semibold tracking-[0.12em] uppercase text-[var(--color-text-subtle)] mb-2.5">
            浏览量 Top 5
          </p>
          <ol class="space-y-1.5">
            {topViewed.map((p, i) => (
              <li class="flex items-center gap-2.5 text-sm">
                <span
                  class={`w-5 h-5 flex-shrink-0 flex items-center justify-center rounded text-[11px] font-bold ${
                    i === 0
                      ? "bg-[var(--color-accent)] text-white"
                      : "bg-[var(--color-accent-muted)] text-[var(--color-accent)]"
                  }`}
                >
                  {i + 1}
                </span>
                <a
                  href={`/posts/${encodeURIComponent(p.slug)}`}
                  class="flex-1 min-w-0 truncate text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
                >
                  {p.title}
                </a>
                <span class="text-xs tabular-nums text-[var(--color-text-subtle)]">{p.views} 次浏览</span>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>

    <!-- 评论管理 -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-3">
        <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)]">评论管理</p>
        <span class="text-xs text-[var(--color-text-subtle)] font-mono">最新 {recentComments.length} 条</span>
      </div>
      <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl divide-y divide-[var(--color-border)]">
        {
          recentComments.length === 0 ? (
            <p class="text-center text-sm text-[var(--color-text-subtle)] py-8 font-serif">暂无评论</p>
          ) : (
            recentComments.map((cm) => (
              <div class="flex items-start gap-3 px-4 py-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-semibold text-[var(--color-text)]">{cm.author}</span>
                    <span class="text-[11px] text-[var(--color-text-subtle)]">评于「{cm.postTitle}」</span>
                    {cm.parentId && <span class="text-[10px] text-[var(--color-text-subtle)]">（回复）</span>}
                    <span class="text-[11px] text-[var(--color-text-subtle)]">{formatDateCN(cm.createdAt)}</span>
                  </div>
                  <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mt-1 line-clamp-2">{cm.content}</p>
                </div>
                <button
                  type="button"
                  data-del-comment={cm.id}
                  data-cdel-text={cm.content}
                  aria-label={`删除 ${cm.author} 的评论`}
                  class="flex-shrink-0 inline-flex items-center justify-center gap-1 px-3 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-red-400 hover:text-red-500 hover:border-red-200 hover:bg-red-50 transition-all"
                >
                  删除
                </button>
              </div>
            ))
          )
        }
      </div>
    </section>

    <!-- Tag filter -->
    <div class="mb-6">
      <TagFilter base="/admin" l1={l1} l2={l2} l3={l3} facets={facets} />

      <div class="flex items-center gap-3 mt-3">
        {
          isFiltering ? (
            <a
              href="/admin"
              class="inline-flex items-center gap-1 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
            >
              <span>←</span> 清除全部筛选
            </a>
          ) : (
            <span class="text-xs text-[var(--color-text-subtle)] font-mono">{allPosts.length} 篇全部文章</span>
          )
        }
        {isFiltering && (
          <span class="text-xs text-[var(--color-text-subtle)] font-mono">{breadcrumb} · {filtered.length} 篇</span>
        )}
      </div>
    </div>

    {
      filtered.length === 0 ? (
        <div class="text-center py-24">
          <p class="text-[var(--color-text-muted)] text-base mb-3 font-serif">没有符合条件的文章</p>
          {isFiltering && (
            <a href="/admin" class="text-sm text-[var(--color-accent)] hover:underline">清除筛选</a>
          )}
        </div>
      ) : (
        <div class="space-y-3">
          {pageItems.map((post, i) => (
            <article
              class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl p-5 hover:border-[var(--color-border-hover)] transition-colors duration-200"
              style={{ animation: `slide-up 0.4s ease-out ${i * 0.05}s both` }}
            >
              <div class="flex items-start gap-4">
                <!-- Cover thumbnail -->
                <a
                  href={`/posts/${post.slug}`}
                  class="hidden sm:flex flex-shrink-0 w-32 h-20 rounded-xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-bg)]"
                >
                  {post.coverImage ? (
                    <img src={post.coverImage} alt={post.title} loading="lazy" class="w-full h-full object-cover" />
                  ) : (
                    <span class="w-full h-full flex items-center justify-center text-[var(--color-text-subtle)]/50">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" strokeWidth={1.2} viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A1.5 1.5 0 0021.75 19.5V4.5A1.5 1.5 0 0020.25 3H3.75A1.5 1.5 0 002.25 4.5v15A1.5 1.5 0 003.75 21z" />
                      </svg>
                    </span>
                  )}
                </a>

                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 mb-1.5">
                    <h2 class="text-base font-semibold text-[var(--color-text)] tracking-[-0.01em] truncate">{post.title}</h2>
                    {post.published ? (
                      <span class="flex-shrink-0 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-green-50 text-green-600">
                        已发布
                      </span>
                    ) : (
                      <span class="flex-shrink-0 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[var(--color-border)] text-[var(--color-text-subtle)]">
                        草稿
                      </span>
                    )}
                  </div>
                  <p class="text-xs text-[var(--color-text-subtle)] font-mono mb-2">/posts/{post.slug}</p>
                  {post.tagList.length > 0 && (
                    <div class="flex flex-wrap items-center gap-1.5 mb-2">
                      {post.tagList.map((tag, ti) => (
                        <span
                          key={`${post.id}-${ti}`}
                          class={`text-[10px] font-medium px-2 py-0.5 rounded-md ${
                            ti === 0
                              ? "bg-[var(--color-accent)] text-white"
                              : "bg-[var(--color-accent-muted)] text-[var(--color-accent)]"
                          }`}
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  {post.excerpt && (
                    <p class="text-xs text-[var(--color-text-muted)] leading-relaxed line-clamp-2 font-serif">{post.excerpt}</p>
                  )}
                  <time class="text-[11px] text-[var(--color-text-subtle)]/70 mt-2 block">
                    {formatDateCN(post.createdAt)}
                  </time>
                </div>

                <!-- Actions -->
                <div class="flex flex-col gap-2 flex-shrink-0">
                  <a
                    href={`/write?edit=${post.slug}`}
                    class="inline-flex items-center justify-center gap-1 px-3.5 py-2 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] hover:bg-[var(--color-bg)] transition-all"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" strokeWidth={1.8} viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" />
                    </svg>
                    编辑
                  </a>
                  <button
                    data-delete={post.id}
                    data-title={post.title}
                    class="inline-flex items-center justify-center gap-1 px-3.5 py-2 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-red-400 hover:text-red-500 hover:border-red-200 hover:bg-red-50 transition-all"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" strokeWidth={1.8} viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                    删除
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }

    <!-- Pagination -->
    <Pagination page={page} totalPages={totalPages} total={filtered.length} pageUrl={pageUrl} />
  </div>

  <!-- Delete confirm modal -->
  <div
    id="delete-modal"
    class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/40 backdrop-blur-sm p-4"
  >
    <div class="w-full max-w-xs bg-[var(--color-surface)] rounded-2xl shadow-2xl shadow-black/10 overflow-hidden" style="animation:scale-in 0.15s ease-out">
      <div class="h-1 bg-red-400" />
      <div class="px-6 pt-6 pb-2 text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-red-50 text-red-400 flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" strokeWidth={1.5} viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-text)] tracking-[-0.01em] mb-1.5">删除文章</h3>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed font-serif">
          确定要删除「<span id="delete-title"></span>」吗？<br />此操作不可撤销。
        </p>
      </div>
      <div class="flex border-t border-[var(--color-border)] mt-4">
        <button
          id="cancel-delete"
          class="flex-1 py-3 text-sm font-medium text-[var(--color-text-muted)] hover:bg-[var(--color-bg)] transition-colors border-r border-[var(--color-border)]"
        >
          取消
        </button>
        <button
          id="confirm-delete"
          class="flex-1 py-3 text-sm font-semibold text-red-500 hover:bg-red-50 transition-colors"
        >
          删除
        </button>
      </div>
    </div>
  </div>

  <!-- Comment delete confirm modal -->
  <div
    id="comment-del-modal"
    class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-black/40 backdrop-blur-sm p-4"
  >
    <div class="w-full max-w-xs bg-[var(--color-surface)] rounded-2xl shadow-2xl shadow-black/10 overflow-hidden" style="animation:scale-in 0.15s ease-out">
      <div class="h-1 bg-red-400" />
      <div class="px-6 pt-6 pb-2 text-center">
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-red-50 text-red-400 flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" strokeWidth={1.5} viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--color-text)] tracking-[-0.01em] mb-1.5">删除评论</h3>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed font-serif break-all">
          确定要删除「<span id="cdel-text"></span>」吗？<br />此操作不可撤销。
        </p>
      </div>
      <div class="flex border-t border-[var(--color-border)] mt-4">
        <button
          id="cdel-cancel"
          class="flex-1 py-3 text-sm font-medium text-[var(--color-text-muted)] hover:bg-[var(--color-bg)] transition-colors border-r border-[var(--color-border)]"
        >
          取消
        </button>
        <button
          id="cdel-confirm"
          class="flex-1 py-3 text-sm font-semibold text-red-500 hover:bg-red-50 transition-colors"
        >
          删除
        </button>
      </div>
    </div>
  </div>
  <script data-astro-rerun>
    // 文章删除 + 评论删除（页面转场后需重新绑定，data-astro-rerun 保证脚本重执行）
    // 注意：data-astro-rerun 按 is:inline 原样内联，不经过 TS 编译——只能写纯 JS
    (() => {
      const modal = document.getElementById("delete-modal");
      const deleteTitle = document.getElementById("delete-title");
      const cancelBtn = document.getElementById("cancel-delete");
      const confirmBtn = document.getElementById("confirm-delete");
      const cModal = document.getElementById("comment-del-modal");
      const cdelText = document.getElementById("cdel-text");
      const cdelCancel = document.getElementById("cdel-cancel");
      const cdelConfirm = document.getElementById("cdel-confirm");
      if (!modal || !deleteTitle || !cancelBtn || !confirmBtn || !cModal || !cdelText || !cdelCancel || !cdelConfirm) return;
      let deleteId = null;
      let cdelId = null;

      const closeModal = () => {
        modal.classList.add("hidden");
        deleteId = null;
      };

      const closeCdel = () => {
        cModal.classList.add("hidden");
        cdelId = null;
      };

      for (const btn of document.querySelectorAll("[data-delete]")) {
        btn.addEventListener("click", () => {
          deleteId = Number(btn.dataset.delete);
          deleteTitle.textContent = btn.dataset.title || "";
          modal.classList.remove("hidden");
        });
      }

      // 评论删除：先弹确认框，确认后走 DELETE /api/comment?id=，服务端级联删其回复
      for (const btn of document.querySelectorAll("[data-del-comment]")) {
        btn.addEventListener("click", () => {
          cdelId = Number(btn.dataset.delComment);
          cdelText.textContent = btn.dataset.cdelText || "";
          cModal.classList.remove("hidden");
        });
      }

      cancelBtn.addEventListener("click", closeModal);
      cdelCancel.addEventListener("click", closeCdel);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
      cModal.addEventListener("click", (e) => {
        if (e.target === cModal) closeCdel();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeModal();
          closeCdel();
        }
      });

      confirmBtn.addEventListener("click", async () => {
        if (!deleteId) return;
        try {
          const res = await fetch(`/api/posts?id=${deleteId}`, { method: "DELETE" });
          if (res.ok) {
            window.location.reload();
          } else {
            alert("删除失败，请重试");
            closeModal();
          }
        } catch {
          alert("网络错误");
          closeModal();
        }
      });

      cdelConfirm.addEventListener("click", async () => {
        if (!cdelId) return;
        try {
          const res = await fetch(`/api/comment?id=${cdelId}`, { method: "DELETE" });
          if (res.ok) {
            window.location.reload();
          } else {
            alert("删除失败，请重试");
            closeCdel();
          }
        } catch {
          alert("网络错误");
          closeCdel();
        }
      });
    })();
  </script>
</Layout>
