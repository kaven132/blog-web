  </div>
  <script data-astro-rerun>
    // 文章删除 + 评论删除（页面转场后需重新绑定，data-astro-rerun 保证脚本重执行）
    // 注意：data-astro-rerun 按 is:inline 原样内联，不经过 TS 编译——只能写纯 JS
    (() => {
      // ── 文章 / 评论 / 相册 / 视频 Tab 切换：状态落在 ?tab=，删除后 reload 也停在当前 Tab ──
      const tabBtns = document.querySelectorAll("[data-admin-tab]");
      const panels = {
        posts: document.getElementById("tab-posts"),
        comments: document.getElementById("tab-comments"),
        galleries: document.getElementById("tab-galleries"),
        videos: document.getElementById("tab-videos"),
      };
      // 顶部主按钮随板块切换：文章=写文章、评论=隐藏、相册=新建相册、视频=上传视频
      const headerBtn = document.getElementById("admin-header-action");
      const PLUS_SVG = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>';
      const HEADER_BY_TAB = {
        posts: { href: "/write", label: "写文章" },
        comments: null,
        galleries: { href: "/gallery/edit", label: "新建相册" },
        videos: { href: "/videos/edit", label: "上传视频" },
      };
      if (tabBtns.length && panels.posts && panels.comments && panels.galleries && panels.videos) {
        const applyTab = function (t) {
          if (!panels[t]) t = "posts";
          Object.keys(panels).forEach(function (k) {
            panels[k].classList.toggle("hidden", k !== t);
          });
          tabBtns.forEach(function (b) {
            const active = b.dataset.adminTab === t;
            b.classList.toggle("bg-[var(--color-accent)]", active);
            b.classList.toggle("text-white", active);
            b.classList.toggle("text-[var(--color-text-muted)]", !active);
            b.setAttribute("aria-selected", active ? "true" : "false");
          });
          if (headerBtn) {
            const cfg = HEADER_BY_TAB[t];
            // 用内联 style 控制显隐：按钮自带 inline-flex 工具类，在 Tailwind v4 产物里排在 .hidden 之后，
            // classList 加 hidden 会被顶掉（内联样式优先级最高，不受工具类顺序影响）
            headerBtn.style.display = cfg ? "" : "none";
            if (cfg) {
              headerBtn.setAttribute("href", cfg.href);
              headerBtn.innerHTML = PLUS_SVG + cfg.label;
            }
          }
        };
        tabBtns.forEach(function (b) {
          b.addEventListener("click", function () {
            applyTab(b.dataset.adminTab);
            const u = new URL(location.href);
            if (b.dataset.adminTab === "posts") u.searchParams.delete("tab");
            else u.searchParams.set("tab", b.dataset.adminTab);
            history.replaceState(null, "", u);
          });
        });
        const initialTab = new URLSearchParams(location.search).get("tab");
        if (initialTab && initialTab !== "posts") applyTab(initialTab);
      }

      // ── 相册删除（确认后走 DELETE /api/gallery?id=，照片记录级联删除）──
      for (const btn of document.querySelectorAll("[data-gal-del]")) {
        btn.addEventListener("click", async () => {
          if (!confirm("确定删除整个相册？（照片记录将一并删除）")) return;
          const res = await fetch("/api/gallery?id=" + btn.dataset.galDel, { method: "DELETE" });
          if (res.ok) window.location.reload();
          else alert("删除失败，请重试");
        });
      }

      // ── 视频删除（确认后走 DELETE /api/video?id=，点赞/评论级联删除）──
      for (const btn of document.querySelectorAll("[data-vid-del]")) {
        btn.addEventListener("click", async () => {
          if (!confirm("确定删除该视频？（点赞与评论将一并删除）")) return;
          const res = await fetch("/api/video?id=" + btn.dataset.vidDel, { method: "DELETE" });
          if (res.ok) window.location.reload();
          else alert("删除失败，请重试");
        });
      }

      const modal = document.getElementById("delete-modal");
      const deleteTitle = document.getElementById("delete-title");
      const cancelBtn = document.getElementById("cancel-delete");
      const confirmBtn = document.getElementById("confirm-delete");
      const cModal = document.getElementById("comment-del-modal");
      const cdelText = document.getElementById("cdel-text");
      const cdelCancel = document.getElementById("cdel-cancel");
      const cdelConfirm = document.getElementById("cdel-confirm");
      if (!modal || !deleteTitle || !cancelBtn || !confirmBtn || !cModal || !cdelText || !cdelCancel || !cdelConfirm) return;
      let deleteId = null;
      let cdelId = null;
      let cdelTarget = "post";

      const closeModal = () => {
        modal.classList.add("hidden");
        deleteId = null;
      };

      const closeCdel = () => {
        cModal.classList.add("hidden");
        cdelId = null;
      };

      for (const btn of document.querySelectorAll("[data-delete]")) {
        btn.addEventListener("click", () => {
          deleteId = Number(btn.dataset.delete);
          deleteTitle.textContent = btn.dataset.title || "";
          modal.classList.remove("hidden");
        });
      }

      // 评论删除：先弹确认框，确认后走 DELETE /api/comment?id=，服务端级联删其回复
      for (const btn of document.querySelectorAll("[data-del-comment]")) {
        btn.addEventListener("click", () => {
          cdelId = Number(btn.dataset.delComment);
          cdelTarget = btn.dataset.delTarget || "post";
          cdelText.textContent = btn.dataset.cdelText || "";
          cModal.classList.remove("hidden");
        });
      }

      cancelBtn.addEventListener("click", closeModal);
      cdelCancel.addEventListener("click", closeCdel);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
      cModal.addEventListener("click", (e) => {
        if (e.target === cModal) closeCdel();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeModal();
          closeCdel();
        }
      });

      confirmBtn.addEventListener("click", async () => {
        if (!deleteId) return;
        try {
          const res = await fetch(`/api/posts?id=${deleteId}`, { method: "DELETE" });
          if (res.ok) {
            window.location.reload();
          } else {
            alert("删除失败，请重试");
            closeModal();
          }
        } catch {
          alert("网络错误");
          closeModal();
        }
      });

      cdelConfirm.addEventListener("click", async () => {
        if (!cdelId) return;
        try {
          const delUrl = cdelTarget === "gallery" ? `/api/comment?id=${cdelId}&target=gallery` : `/api/comment?id=${cdelId}`;
          const res = await fetch(delUrl, { method: "DELETE" });
          if (res.ok) {
            window.location.reload();
          } else {
            alert("删除失败，请重试");
            closeCdel();
          }
        } catch {
          alert("网络错误");
          closeCdel();
        }
      });
    })();
  </script>
</Layout>
