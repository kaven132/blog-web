---
import Layout from "../../layouts/Layout.astro";
import { AUTH_COOKIE, isAuthed } from "../../lib/auth";
import { getFlashGame } from "../../lib/flash-games";
import { getRpgGame } from "../../lib/rpg-games";
import FlashGameBody from "../../components/games/FlashGameBody.astro";
import RpgGameBody from "../../components/games/RpgGameBody.astro";
import { readFileSync } from "node:fs";
import { trackBrowse } from "../../lib/history";

export const prerender = false;

const authed = isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value);
const flash = getFlashGame(Astro.params.id);
const rpg = getRpgGame(Astro.params.id);
const game = flash ?? rpg;
// 未注册的游戏 id 回列表页；存档随账号走，页面只对登录用户开放
if (!game) return Astro.redirect("/games");
if (!authed) return Astro.redirect("/login?next=" + encodeURIComponent("/games/" + Astro.params.id));
// 浏览历史采集（本页全站仅登录可见，走到这里必然已登录）
trackBrowse("game", Astro.params.id, game.title, `/games/${Astro.params.id}`);

// Flash 款需要 Ruffle 版本号进 script URL 破缓存
let ruffleVersion = "dev";
try {
  ruffleVersion = JSON.parse(readFileSync("node_modules/@ruffle-rs/ruffle/package.json", "utf-8")).version;
} catch {
  // 依赖缺失时端点本身会 404，状态栏可见
}
---

<Layout title={game.title} description={`网页游戏「${game.orig}」—— 浏览器运行，存档云端同步`}>
  {flash ? <FlashGameBody game={flash} ruffleVersion={ruffleVersion} /> : rpg ? <RpgGameBody game={rpg} /> : null}
</Layout>
