---
import Layout from "../../layouts/Layout.astro";
import { db } from "../../db";
import { videos } from "../../db/schema";
import { eq } from "drizzle-orm";
import { AUTH_COOKIE, isAuthed } from "../../lib/auth";

export const prerender = false;

if (!isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value)) {
  return Astro.redirect("/login?next=" + encodeURIComponent(Astro.url.pathname + Astro.url.search));
}

// ?id=N 为编辑模式；缺省为新建模式
const id = Number(Astro.url.searchParams.get("id"));
const isEdit = Number.isInteger(id) && id > 0;

let video: { id: number; title: string; description: string; url: string; poster: string; isPrivate: number } | undefined;
if (isEdit) {
  video = db.select().from(videos).where(eq(videos.id, id)).get();
  if (!video) return Astro.redirect("/videos");
}
const vid = isEdit ? video!.id : 0;
---

<Layout title={isEdit ? `编辑视频：${video!.title}` : "上传视频"}>
  <article class="py-10 max-w-3xl mx-auto">
    <header class="mb-8">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Admin · Video</p>
      <h1 class="text-3xl font-bold tracking-[-0.02em] mb-3">{isEdit ? "编辑视频" : "上传视频"}</h1>
      <a href="/videos" class="inline-flex items-center gap-1 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">
        <span aria-hidden="true">←</span> 返回视频
      </a>
    </header>

    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 space-y-5">
      <div>
        <label for="v-title" class="block text-sm font-medium text-[var(--color-text)] mb-1.5">视频标题 <span class="text-red-400" aria-hidden="true">*</span></label>
        <input id="v-title" type="text" maxlength="60" placeholder="视频标题（必填）" value={isEdit ? video!.title : ""}
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm text-[var(--color-text)] outline-none focus:border-[var(--color-accent)]" />
      </div>
      <div>
        <label for="v-desc" class="block text-sm font-medium text-[var(--color-text)] mb-1.5">简介</label>
        <input id="v-desc" type="text" maxlength="300" placeholder="简介（可选）" value={isEdit ? video!.description : ""}
          class="w-full px-3 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-sm text-[var(--color-text)] outline-none focus:border-[var(--color-accent)]" />
      </div>
      <label class="flex items-center gap-2.5 text-sm text-[var(--color-text)] cursor-pointer select-none">
        <input id="v-private" type="checkbox" class="w-4 h-4 accent-[var(--color-accent)]" checked={isEdit && !!video!.isPrivate} />
        隐私视频（仅登录后可见，未登录访客与列表不显示）
      </label>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-sm font-medium text-[var(--color-text)]">视频文件 <span class="text-red-400" aria-hidden="true">*</span></label>
          <span class="text-xs text-[var(--color-text-subtle)]">MP4 / WebM / MOV，单文件 ≤ 500MB</span>
        </div>
        <div id="v-file-box" class="rounded-lg border border-dashed border-[var(--color-border)] px-4 py-4 text-sm">
          <input id="v-file" type="file" accept="video/mp4,video/webm,video/quicktime" class="hidden" />
          {isEdit ? (
            <span class="text-[var(--color-text-muted)]">已有视频文件。要替换时点下面按钮重新上传。</span>
          ) : (
            <span class="text-[var(--color-text-muted)]">尚未上传。</span>
          )}
          <button type="button" id="v-file-btn" class="ml-3 px-3 py-1 rounded-md text-xs font-semibold border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors">
            {isEdit ? "替换视频" : "选择视频"}
          </button>
          <div id="v-progress-wrap" class="hidden mt-3">
            <div class="h-2 rounded-full bg-[var(--color-bg)] overflow-hidden">
              <div id="v-progress-bar" class="h-full bg-[var(--color-accent)] transition-all" style="width:0%"></div>
            </div>
            <p id="v-progress-text" class="text-[11px] text-[var(--color-text-subtle)] mt-1 font-mono">0%</p>
          </div>
        </div>
        <input type="hidden" id="v-url" value={isEdit ? video!.url : ""} />
      </div>

      <div>
        <label class="block text-sm font-medium text-[var(--color-text)] mb-1.5">封面图 <span class="text-xs text-[var(--color-text-subtle)] font-normal">（可选，≤10MB；不传则播放器显示视频首帧）</span></label>
        <div class="flex items-center gap-4">
          <div id="v-poster-preview" class="w-40 aspect-video rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] overflow-hidden flex items-center justify-center text-xs text-[var(--color-text-subtle)]">
            {isEdit && video!.poster ? <img src={video!.poster} alt="封面" class="w-full h-full object-cover" /> : "暂无封面"}
          </div>
          <div class="flex flex-col gap-2">
            <button type="button" id="v-poster-btn" class="px-3 py-1.5 rounded-md text-xs font-semibold border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors">
              上传封面
            </button>
            <button type="button" id="v-poster-remove" class="px-3 py-1.5 rounded-md text-xs font-semibold border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors">
              移除封面
            </button>
          </div>
          <input type="file" id="v-poster-file" accept="image/png,image/jpeg,image/webp" class="hidden" />
        </div>
        <input type="hidden" id="v-poster" value={isEdit ? video!.poster : ""} />
      </div>

      <p id="v-hint" class="hidden text-sm text-[var(--color-text-muted)]"></p>

      <div class="flex items-center gap-3 pt-2 border-t border-[var(--color-border)] flex-wrap">
        <button id="v-save" type="button" data-edit={isEdit ? "1" : ""} data-vid={vid} class="px-5 py-2.5 text-sm font-semibold rounded-lg bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-colors">保存</button>
        {isEdit && (
          <button id="v-del" type="button" class="px-4 py-2.5 text-sm rounded-lg border border-[var(--color-border)] text-red-400 hover:text-red-500 hover:border-red-200 hover:bg-red-50 transition-colors">删除视频</button>
        )}
        <span class="text-xs text-[var(--color-text-subtle)]">保存后自动返回视频列表</span>
      </div>
    </div>
  </article>

  <script>
    const hint = (t: string) => {
      const el = document.getElementById("v-hint")!;
      el.textContent = t;
      el.classList.remove("hidden");
    };

    // ── 页面模式：isEdit / vid 必须经 data-* 从服务端传入 —— hoisted script 是独立打包的
    // 模块，作用域里没有 frontmatter 变量，直接引用会在点击保存/删除时抛 ReferenceError
    // 且被 catch 误报成「网络错误」 ──
    const saveBtn = document.getElementById("v-save") as HTMLButtonElement;
    const isEdit = saveBtn.dataset.edit === "1";
    const vid = Number(saveBtn.dataset.vid || 0);

    // ── 页面数据请求统一走 XHR ──
    // 本页的视频上传（XHR）在各类环境（含 ZCode 内嵌浏览器）始终可靠，而页面内的 fetch
    // 保存请求曾在内嵌浏览器里出现「点击保存后请求静默未发出」的怪象（同页面同身份下、
    // 主世界注入的完全相同请求毫秒级成功，页面自己的 fetch 却一次都不经过包装器）。
    // 因此保存/封面/删除统一改走 XHR 通道；每次失败新建 XHR（= 换新连接）重试，
    // 15s 硬超时保证任何挂起都会进入下一轮重试而不是永远等下去。
    const xhrSend = (method: string, url: string, body: string | FormData | null, json = false, timeoutMs = 15000) =>
      new Promise<{ status: number; text: string }>((resolve, reject) => {
        const x = new XMLHttpRequest();
        x.open(method, url);
        x.timeout = timeoutMs;
        if (json) x.setRequestHeader("Content-Type", "application/json");
        x.onload = () => resolve({ status: x.status, text: x.responseText });
        x.onerror = () => reject(new Error("network"));
        x.ontimeout = () => reject(new Error("timeout"));
        x.send(body);
      });
    const xhrRetry = async (method: string, url: string, body: string | FormData | null, json = false, attempts = 3) => {
      let lastErr: unknown = null;
      for (let i = 0; i < attempts; i++) {
        try {
          return await xhrSend(method, url, body, json);
        } catch (e) {
          lastErr = e;
          if (i < attempts - 1) await new Promise((r) => setTimeout(r, 500));
        }
      }
      throw lastErr;
    };

    // ── 视频上传（XHR 才有上传进度；fetch 拿不到）──
    const videoUrlInput = document.getElementById("v-url") as HTMLInputElement;
    const wrap = document.getElementById("v-progress-wrap")!;
    const bar = document.getElementById("v-progress-bar")!;
    const progressText = document.getElementById("v-progress-text")!;
    const fileInput = document.getElementById("v-file") as HTMLInputElement;
    const fileBtn = document.getElementById("v-file-btn")!;

    fileBtn.addEventListener("click", () => fileInput.click());

    // 失败分流：上传已到 100% 但响应丢失（dev 服务器偶发连接复位——服务端其实已完整落盘，
    // data/videos 里的成对孤儿文件就是证据）→ 自动换新连接重试一次，与保存接口的既有补丁同款思路
    const failOrRetry = (file, isRetry, why, lastPct) => {
      if (!isRetry && lastPct >= 100) {
        hint("文件已传完但响应丢失 —— 自动换新连接重试…");
        // 先发一个丢弃的 GET 把池内坏连接耗掉，再换连接重传
        try { fetch("/?heal=" + Date.now(), { cache: "no-store" }).catch(() => {}); } catch { /* ignore */ }
        setTimeout(() => {
          bar.style.width = "0%";
          progressText.textContent = "0%";
          sendUpload(file, true);
        }, 400);
      } else {
        hint(isRetry ? "重试仍失败（" + why + "）" : "上传失败（" + why + "）");
        wrap.classList.add("hidden");
      }
    };

    // 视频上传端点按 Content-Type 识别类型并流式读原始 body —— 必须直传文件本体，
    // 不能用 FormData（multipart 会被当成未知类型拒掉）
    const sendUpload = (file, isRetry) => {
      const xhr = new XMLHttpRequest();
      let lastPct = 0;
      xhr.open("POST", "/api/videos/upload");
      xhr.setRequestHeader("Content-Type", file.type || "application/octet-stream");
      xhr.upload.addEventListener("progress", (e) => {
        if (e.lengthComputable) {
          const pct = Math.round((e.loaded / e.total) * 100);
          lastPct = pct;
          bar.style.width = pct + "%";
          progressText.textContent = `${pct}%（${(e.loaded / 1048576).toFixed(1)} / ${(e.total / 1048576).toFixed(1)} MB）`;
        }
      });
      xhr.addEventListener("load", () => {
        try {
          const j = JSON.parse(xhr.responseText);
          if (xhr.status === 200 && j.url) {
            videoUrlInput.value = j.url;
            hint("视频上传完成，记得点「保存」");
          } else {
            hint(j.error || "上传失败");
            wrap.classList.add("hidden");
          }
        } catch {
          failOrRetry(file, isRetry, "响应解析失败", lastPct);
        }
      });
      xhr.addEventListener("error", () => failOrRetry(file, isRetry, "网络错误", lastPct));
      xhr.send(file);
    };

    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      // 客户端预检：与服务端 EXT_BY_MIME 同源的类型白名单 + 500MB 护栏，
      // 免得超限/异型文件把几分钟的上传带宽白耗完才被服务端 413 拒掉
      if (!["video/mp4", "video/webm", "video/quicktime"].includes(file.type)) {
        hint("仅支持 MP4 / WebM / MOV 视频");
        fileInput.value = "";
        return;
      }
      if (file.size > 500 * 1024 * 1024) {
        hint("视频不能超过 500MB");
        fileInput.value = "";
        return;
      }
      wrap.classList.remove("hidden");
      bar.style.width = "0%";
      progressText.textContent = "0%";
      hint(`上传中：${file.name}`);
      sendUpload(file, false);
      // 没有手动封面时，自动截取视频首帧当封面（失败静默，手动通道保留）
      if (!posterInput.value) capturePosterFromVideo(file);
    });

    // ── 封面上传（走 /api/upload/photo，10MB）──
    const posterInput = document.getElementById("v-poster") as HTMLInputElement;
    const posterPreview = document.getElementById("v-poster-preview")!;
    const posterFile = document.getElementById("v-poster-file") as HTMLInputElement;
    document.getElementById("v-poster-btn")!.addEventListener("click", () => posterFile.click());
    posterFile.addEventListener("change", async () => {
      const file = posterFile.files?.[0];
      if (!file) return;
      hint("封面上传中…");
      const fd = new FormData();
      fd.append("file", file);
      try {
        const r = await xhrRetry("POST", "/api/upload/photo", fd);
        let j: Record<string, unknown> = {};
        try { j = JSON.parse(r.text || "{}"); } catch { /* 非 JSON 响应按失败处理 */ }
        if (r.status >= 200 && r.status < 300 && j.url) {
          posterInput.value = j.url as string;
          const img = document.createElement("img");
          img.src = j.url as string;
          img.alt = "封面";
          img.className = "w-full h-full object-cover";
          posterPreview.replaceChildren(img);
          hint("封面上传完成，记得点「保存」");
        } else {
          hint((j.error as string) || "封面上传失败");
        }
      } catch {
        hint("封面上传失败");
      } finally {
        posterFile.value = "";
      }
    });
    document.getElementById("v-poster-remove")!.addEventListener("click", () => {
      posterInput.value = "";
      posterPreview.textContent = "暂无封面";
    });

    // ── 首帧自动封面：本地解码视频 → 多点采样 → 取最亮帧 → JPEG → 复用 /api/upload/photo ──
    // 片头常是黑场淡入，固定取 0.5s 会截到暗帧（与资源管理器缩略图不符）；
    // 候选位置取「开头/10%/25%/40%」四帧，按平均亮度选最亮的一张。
    // 不依赖 ffmpeg；解码失败静默放弃，手动上传通道保留。触发时与落值前双重检查，
    // 用户中途手动选了封面则自动帧让位。
    const capturePosterFromVideo = async (file) => {
      const objUrl = URL.createObjectURL(file);
      let bestDataUrl: string | null = null;
      try {
        const v = document.createElement("video");
        v.preload = "auto";
        v.muted = true;
        v.src = objUrl;
        await new Promise((res, rej) => {
          v.onloadeddata = () => res(null);
          v.onerror = () => rej(new Error("解码失败"));
          setTimeout(() => rej(new Error("解码超时")), 8000);
        });
        const dur = v.duration || 1;
        const vw = v.videoWidth || 960;
        const vh = v.videoHeight || 540;
        const scale = Math.min(1, 960 / vw);
        const canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(vw * scale));
        canvas.height = Math.max(1, Math.round(vh * scale));
        const ctx = canvas.getContext("2d");
        const candidates = [0.1, Math.min(1.5, dur * 0.1), dur * 0.25, dur * 0.4]
          .filter((t, i, arr) => t >= 0 && t < dur && arr.indexOf(t) === i);
        let bestLum = -1;
        for (const t of candidates) {
          v.currentTime = t;
          await new Promise((res) => {
            v.onseeked = () => res(null);
            setTimeout(() => res(null), 2500);
          });
          try { ctx.drawImage(v, 0, 0, canvas.width, canvas.height); } catch { continue; }
          let data;
          try { data = ctx.getImageData(0, 0, canvas.width, canvas.height).data; } catch { continue; }
          // 平均亮度（采样 ~400 个像素点）
          const step = 4 * Math.max(1, Math.floor((canvas.width * canvas.height) / 400));
          let sum = 0, n = 0;
          for (let i = 0; i + 2 < data.length; i += step) {
            sum += 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
            n++;
          }
          const lum = n ? sum / n : 0;
          if (lum > bestLum) {
            bestLum = lum;
            bestDataUrl = canvas.toDataURL("image/jpeg", 0.85);
          }
        }
      } catch { return; /* 截帧失败静默，不影响视频上传 */ }
      finally { URL.revokeObjectURL(objUrl); }
      // 没截到任何帧，或用户在截帧期间已手动选了封面 → 自动帧让位
      if (!bestDataUrl || posterInput.value) return;
      try {
        const bin = atob(bestDataUrl.split(",")[1]);
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        const fd = new FormData();
        fd.append("file", new File([bytes], "poster.jpg", { type: "image/jpeg" }));
        const r = await xhrRetry("POST", "/api/upload/photo", fd);
        let j: Record<string, unknown> = {};
        try { j = JSON.parse(r.text || "{}"); } catch { /* 非 JSON 响应按失败处理 */ }
        if (r.status >= 200 && r.status < 300 && j.url && !posterInput.value) {
          // 二次复查：封面上传窗口内用户手动选了封面则放弃写入（已上传的自动帧作孤儿图，可忽略）
          posterInput.value = j.url as string;
          const img = document.createElement("img");
          img.src = j.url as string;
          img.alt = "封面";
          img.className = "w-full h-full object-cover";
          posterPreview.replaceChildren(img);
          hint("已自动截取视频亮帧作为封面");
        }
      } catch { /* 自动封面文件上传失败静默 */ }
    };

    // ── 保存 / 删除 ──
    saveBtn.addEventListener("click", async () => {
      const title = (document.getElementById("v-title") as HTMLInputElement).value.trim();
      if (!title) { hint("请先填写视频标题"); return; }
      const url = videoUrlInput.value;
      if (!url) { hint("请先上传视频文件"); return; }
      saveBtn.disabled = true;
      hint("保存中…");
      const payload = {
        title,
        description: (document.getElementById("v-desc") as HTMLInputElement).value,
        url,
        poster: posterInput.value,
        isPrivate: (document.getElementById("v-private") as HTMLInputElement).checked ? 1 : 0,
      };
      const doSave = async () => {
        const r = await xhrRetry(isEdit ? "PUT" : "POST", "/api/video", JSON.stringify(isEdit ? { id: vid, ...payload } : payload), true);
        let j: Record<string, unknown> = {};
        try { j = JSON.parse(r.text || "{}"); } catch { /* 非 JSON 响应按通用失败处理 */ }
        if (r.status >= 200 && r.status < 300) return { ok: true as const };
        return { ok: false as const, error: (j.error as string) || "保存失败" };
      };

      // 连接池自愈交给 fetchWithHeal（含踢坏连接 + 退避重试），这里只做结果呈现
      try {
        const r = await doSave();
        if (r.ok) { window.location.href = "/videos"; return; }
        hint(r.error);
      } catch {
        hint("保存失败（网络错误），请再试一次");
      }
      saveBtn.disabled = false;
    });

    const delBtn = document.getElementById("v-del") as HTMLButtonElement | null;
    delBtn?.addEventListener("click", async () => {
      if (!confirm("确定删除这个视频？评论与点赞会一并删除，此操作不可恢复。")) return;
      delBtn.disabled = true;
      try {
        const r = await xhrRetry("DELETE", `/api/video?id=${vid}`, null);
        if (r.status >= 200 && r.status < 300) { window.location.href = "/videos"; return; }
        hint("删除失败，请重试");
      } catch {
        hint("删除失败，请重试");
      }
      delBtn.disabled = false;
    });
  </script>
</Layout>
