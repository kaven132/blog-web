---
import Layout from "../../layouts/Layout.astro";
import LikeButton from "../../components/LikeButton";
import { db } from "../../db";
import { videos, videoLikes, videoComments } from "../../db/schema";
import { and, asc, desc, eq, gt, lt, sql } from "drizzle-orm";
import { AUTH_COOKIE, isAuthed, nsfwOpen } from "../../lib/auth";
import { trackBrowse } from "../../lib/history";
import { shouldCountView } from "../../lib/view-guard";
import { formatDateShort, dbDateToISO } from "../../lib/datetime";
import { sizedImgSrc } from "../../lib/imgsrc";

export const prerender = false;

const authed = isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value);
const id = Number(Astro.params.id);
const video = Number.isInteger(id) && id > 0 ? db.select().from(videos).where(eq(videos.id, id)).get() : undefined;
if (!video) return Astro.redirect("/videos");
// 隐私视频：未登录送登录页（登录后自动回跳）；登录但 NSFW 开关关闭送回列表（列表里本就看不到它）
if (video.isPrivate && !authed) {
  return Astro.redirect("/login?next=" + encodeURIComponent(`/videos/${video.id}`));
}
if (video.isPrivate && !nsfwOpen(Astro.cookies)) {
  return Astro.redirect("/videos");
}

// 浏览量：浏览页每次渲染 +1（先取旧值用于展示，再自增）；爬虫/30 分钟内重复访问不计数
const videoViews = video.views;
if (shouldCountView(Astro.cookies, Astro.request, "video", video.id)) {
  db.update(videos)
    .set({ views: sql`${videos.views} + 1` })
    .where(eq(videos.id, video.id))
    .run();
}
const viewsDisplay = videoViews > 9999 ? `${(videoViews / 10000).toFixed(1)} 万` : String(videoViews);

// 浏览历史采集：仅登录用户记录
if (authed) {
  trackBrowse("video", video.id, video.title, `/videos/${video.id}`);
}

const videoLike = db.select().from(videoLikes).where(eq(videoLikes.videoId, video.id)).get();
const videoCommentRows = db
  .select()
  .from(videoComments)
  .where(eq(videoComments.videoId, video.id))
  .orderBy(videoComments.createdAt)
  .all();

// 评论盖楼：与文章/相册同款（顶层 + 一层回复归并）
const rootComments = videoCommentRows.filter((c) => c.parentId === null);
const repliesOf = (cid: number) => videoCommentRows.filter((c) => c.parentId === cid);
const authorOf = (cid: number | null) => videoCommentRows.find((c) => c.id === cid)?.author;
const created = formatDateShort(video.createdAt);
const createdIso = dbDateToISO(video.createdAt);

// 相邻视频：与列表同序（时间倒序）——上一部 = 更新发布的第一个，下一部 = 更旧的第一个。
// 匿名或 NSFW 关闭时跳过隐私项（列表里看不到的，导航里也不出现）。
const hidePrivate = !authed || !nsfwOpen(Astro.cookies);
const prevVideo = db
  .select({ id: videos.id, title: videos.title, poster: videos.poster })
  .from(videos)
  .where(and(gt(videos.createdAt, video.createdAt), hidePrivate ? eq(videos.isPrivate, 0) : undefined))
  .orderBy(asc(videos.createdAt))
  .limit(1)
  .get();
const nextVideo = db
  .select({ id: videos.id, title: videos.title, poster: videos.poster })
  .from(videos)
  .where(and(lt(videos.createdAt, video.createdAt), hidePrivate ? eq(videos.isPrivate, 0) : undefined))
  .orderBy(desc(videos.createdAt))
  .limit(1)
  .get();
---

<Layout title={`${video.title} · 视频`} description={video.description || `${video.title} —— 在线播放`} ogTag="视频">
  <article class="py-10 md:py-14 max-w-4xl mx-auto">
    <header class="mb-6 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Video</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-3">{video.title}</h1>
      {video.description && <p class="text-base text-[var(--color-text-muted)] leading-relaxed font-serif max-w-2xl">{video.description}</p>}
      <div class="mt-4 flex items-center gap-4 text-sm flex-wrap">
        <a href="/videos" class="inline-flex items-center gap-1 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">
          <span aria-hidden="true">←</span> 返回视频
        </a>
        <time class="text-[var(--color-text-subtle)] whitespace-nowrap" datetime={createdIso}>{created}</time>
        <span class="text-[var(--color-text-subtle)]">{viewsDisplay} 次浏览</span>
      </div>
    </header>

    <!-- 播放器：原生控制条 + 底部增强条（倍速/循环），单击暂停、双击全屏、播放位置记忆 -->
    <div id="v-player" class="relative rounded-2xl bg-black border border-[var(--color-border)] mb-10 animate-[slide-up_0.5s_ease-out_both]">
      <video id="v-video" data-video-id={video.id} class="block w-full max-h-[70vh] mx-auto rounded-t-[15px]" src={video.url} poster={video.poster || undefined} controls preload="metadata" playsinline></video>
      <div id="v-resume" class="hidden absolute top-3 left-3 rounded-full bg-black/70 text-white text-xs px-3 py-1.5 backdrop-blur z-10"></div>
      <div class="flex items-center gap-2 px-3 py-2 bg-[var(--color-surface)] relative rounded-b-[15px]">
        <div class="relative">
          <button type="button" id="v-rate-btn" title="倍速播放" aria-haspopup="true" class="h-7 px-2.5 rounded-lg text-xs font-mono border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/50 transition-colors">1.0x</button>
          <div id="v-rate-menu" class="hidden absolute bottom-full mb-2 left-0 w-20 p-1 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg z-20">
            {["0.5", "0.75", "1.0", "1.25", "1.5", "2.0"].map((r) => (
              <button
                type="button"
                data-rate={r}
                class:list={[
                  "w-full h-7 rounded-lg text-xs font-mono text-center transition-colors hover:bg-[var(--color-bg)] hover:text-[var(--color-text)]",
                  r === "1.0" ? "text-[var(--color-accent)] font-bold" : "text-[var(--color-text-muted)]",
                ]}
              >
                {r}x
              </button>
            ))}
          </div>
        </div>
        <button type="button" id="v-loop-btn" title="循环播放" aria-pressed="false" class="h-7 px-2.5 rounded-lg text-xs border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/50 transition-colors">循环 关</button>
        <span class="ml-auto text-[11px] text-[var(--color-text-subtle)] hidden sm:inline whitespace-nowrap">空格 播放 · ←/→ ±5s · ↑/↓ 音量 · 双击全屏</span>
      </div>
    </div>

    <!-- 相邻视频导航：上一部 / 下一部（与列表时间倒序一致；隐私项对无权限者不可见） -->
    {(prevVideo || nextVideo) && (
      <nav class="grid sm:grid-cols-2 gap-3 mb-10" aria-label="相邻视频">
        {prevVideo && (
          <a href={`/videos/${prevVideo.id}`} class="group flex items-center gap-3 bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] rounded-xl p-3 transition-colors min-w-0">
            {prevVideo.poster && <img src={sizedImgSrc(prevVideo.poster, 320)} alt="" class="w-24 h-14 rounded-lg object-cover flex-shrink-0" loading="lazy" />}
            <span class="min-w-0">
              <span class="block text-[11px] text-[var(--color-text-subtle)] mb-0.5">← 上一部</span>
              <span class="block text-sm font-medium text-[var(--color-text)] truncate group-hover:text-[var(--color-accent)] transition-colors">{prevVideo.title}</span>
            </span>
          </a>
        )}
        {nextVideo && (
          <a href={`/videos/${nextVideo.id}`} class="group flex items-center gap-3 sm:flex-row-reverse bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] rounded-xl p-3 transition-colors min-w-0">
            {nextVideo.poster && <img src={sizedImgSrc(nextVideo.poster, 320)} alt="" class="w-24 h-14 rounded-lg object-cover flex-shrink-0" loading="lazy" />}
            <span class="min-w-0 text-right">
              <span class="block text-[11px] text-[var(--color-text-subtle)] mb-0.5">下一部 →</span>
              <span class="block text-sm font-medium text-[var(--color-text)] truncate group-hover:text-[var(--color-accent)] transition-colors">{nextVideo.title}</span>
            </span>
          </a>
        )}
      </nav>
    )}

    <!-- 点赞 + 评论区（与相册同构） -->
    <section id="comments" class="mt-12 max-w-2xl mx-auto">
      <div class="flex flex-col items-center gap-5 mb-12">
        <p class="text-xs text-[var(--color-text-subtle)] uppercase tracking-widest font-semibold">
          喜欢这个视频吗？
        </p>
        <LikeButton client:load target="video" videoId={video.id} initialCount={videoLike?.count || 0} />
      </div>

      <div class="flex items-center gap-3 mb-8">
        <h2 class="text-lg font-bold tracking-[-0.01em]">评论</h2>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-[var(--color-border)] text-[var(--color-text-subtle)]">
          {videoCommentRows.length}
        </span>
      </div>

      {
        rootComments.length === 0 ? (
          <p class="text-center py-10 text-sm text-[var(--color-text-subtle)] font-serif">
            暂无评论，成为第一个留言的人
          </p>
        ) : (
          <div class="space-y-3 mb-10">
            {rootComments.map((comment) => {
              const replies = repliesOf(comment.id);
              return (
                <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4 hover:border-[var(--color-border-hover)] transition-colors duration-200">
                  <div class="flex items-center gap-2.5 mb-2.5">
                    <div class="w-7 h-7 rounded-full bg-[var(--color-accent-muted)] text-[var(--color-accent)] flex items-center justify-center text-xs font-bold">
                      {comment.author.charAt(0)}
                    </div>
                    <span class="font-semibold text-sm text-[var(--color-text)]">{comment.author}</span>
                    <span class="text-xs text-[var(--color-text-subtle)]">
                      {new Date(comment.createdAt).toLocaleDateString("zh-CN", {
                        month: "short",
                        day: "numeric",
                      })}
                    </span>
                    <button
                      type="button"
                      data-reply-to={comment.id}
                      data-reply-author={comment.author}
                      class="ml-auto text-xs text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] transition-colors"
                    >
                      回复
                    </button>
                  </div>
                  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed pl-9">{comment.content}</p>

                  {replies.length > 0 && (
                    <div class="mt-3 pl-9 space-y-3">
                      {replies.map((reply) => {
                        const target = authorOf(reply.parentId);
                        return (
                          <div class="bg-[var(--color-bg)] rounded-lg p-3">
                            <div class="flex items-center gap-2 mb-1.5">
                              <span class="font-semibold text-xs text-[var(--color-text)]">{reply.author}</span>
                              {target && (
                                <span class="text-[11px] text-[var(--color-text-subtle)]">
                                  回复 @{target}
                                </span>
                              )}
                              <span class="text-[11px] text-[var(--color-text-subtle)]">
                                {new Date(reply.createdAt).toLocaleDateString("zh-CN", {
                                  month: "short",
                                  day: "numeric",
                                })}
                              </span>
                            </div>
                            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{reply.content}</p>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )
      }

      <!-- 评论表单 -->
      <form method="POST" action="/api/comment" class="space-y-3">
        <input type="hidden" name="videoId" value={video.id} />
        <input type="hidden" name="parentId" value="" />
        <div
          id="reply-notice"
          class="hidden items-center gap-2 text-xs text-[var(--color-text-muted)] bg-[var(--color-bg)] border border-[var(--color-border)] rounded-lg px-3 py-2"
        >
          <span>
            回复 <span id="reply-notice-author" class="font-semibold text-[var(--color-accent)]" />
          </span>
          <button type="button" id="reply-cancel" class="text-[var(--color-text-subtle)] hover:text-[var(--color-text)] transition-colors">
            取消
          </button>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="text"
            name="author"
            id="comment-author"
            placeholder="昵称"
            maxlength="20"
            required
            class="sm:w-28 px-3.5 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all duration-300"
          />
          <div class="flex-1 flex gap-2.5">
            <input
              type="text"
              name="content"
              id="comment-content"
              placeholder="写下你的想法..."
              maxlength="500"
              required
              class="flex-1 px-3.5 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all duration-300"
            />
            <div class="relative">
              <button
                type="button"
                id="emoji-toggle"
                aria-label="插入表情"
                title="插入表情"
                class="w-10 h-full flex items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-all duration-300"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 3.75c0 .414.168.75.375.75s.375-.336.375-.75-.168-.75-.375-.75-.375.336-.375.75Zm6.75-3.75c0 .414.168.75.375.75s.375-.336.375-.75-.168-.75-.375-.75-.375.336-.375.75Z" />
                </svg>
              </button>
              <div
                id="emoji-pop"
                class="hidden absolute bottom-full right-0 mb-2 w-[248px] p-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg z-10 grid grid-cols-8 gap-0.5"
              >
                {
                  [
                    "😀", "😄", "😁", "😆", "😊", "😍", "🤩", "😎",
                    "🤔", "😅", "😮", "😭", "😢", "😡", "🤯", "😴",
                    "🥳", "🤗", "🙄", "😤", "🫡", "🤝", "👍", "👎",
                    "👏", "🙏", "💪", "❤️", "🔥", "✨", "🎉", "🚀",
                  ].map((e) => (
                    <button type="button" data-emoji={e} class="w-7 h-7 rounded-md text-base leading-none hover:bg-[var(--color-bg)] transition-colors">
                      {e}
                    </button>
                  ))
                }
              </div>
            </div>
            <button
              type="submit"
              class="px-5 py-2.5 text-sm font-semibold rounded-xl bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-colors duration-200 active:scale-[0.97]"
            >
              发送
            </button>
          </div>
        </div>
      </form>

      <script data-astro-rerun>
        // 评论表单增强：昵称记忆 + 回复定位与取消 + 表情选择器（与文章/相册同款，纯 JS）
        (() => {
          const form = document.querySelector('form[action="/api/comment"]');
          if (!form) return;
          const authorInput = form.querySelector('input[name="author"]');
          const parentInput = form.querySelector('input[name="parentId"]');
          const notice = form.querySelector("#reply-notice");
          const noticeAuthor = form.querySelector("#reply-notice-author");
          const cancelBtn = form.querySelector("#reply-cancel");

          const clearReply = () => {
            if (parentInput) parentInput.value = "";
            notice?.classList.add("hidden");
            notice?.classList.remove("flex");
          };

          try {
            const saved = localStorage.getItem("comment-author");
            if (saved && authorInput && !authorInput.value) authorInput.value = saved;
          } catch {}

          form.addEventListener("submit", () => {
            try {
              if (authorInput) localStorage.setItem("comment-author", authorInput.value);
            } catch {}
          });

          for (const btn of document.querySelectorAll("[data-reply-to]")) {
            btn.addEventListener("click", () => {
              if (!parentInput || !notice) return;
              parentInput.value = btn.dataset.replyTo ?? "";
              if (noticeAuthor) noticeAuthor.textContent = "@" + (btn.dataset.replyAuthor ?? "");
              notice.classList.remove("hidden");
              notice.classList.add("flex");
              form.scrollIntoView({ behavior: "smooth", block: "center" });
              form.querySelector('input[name="content"]')?.focus();
            });
          }
          cancelBtn?.addEventListener("click", clearReply);

          const emojiToggle = form.querySelector("#emoji-toggle");
          const emojiPop = form.querySelector("#emoji-pop");
          const contentInput = form.querySelector('input[name="content"]');
          const closeEmoji = () => emojiPop?.classList.add("hidden");
          if (emojiToggle && emojiPop && contentInput) {
            emojiToggle.addEventListener("click", (e) => {
              e.stopPropagation();
              emojiPop.classList.toggle("hidden");
              if (!emojiPop.classList.contains("hidden")) contentInput.focus();
            });
            emojiPop.addEventListener("click", (e) => {
              const btn = e.target instanceof Element ? e.target.closest("[data-emoji]") : null;
              if (!btn) return;
              const emoji = btn.getAttribute("data-emoji") ?? "";
              const s = contentInput.selectionStart ?? contentInput.value.length;
              const en = contentInput.selectionEnd ?? s;
              contentInput.value = contentInput.value.slice(0, s) + emoji + contentInput.value.slice(en);
              contentInput.selectionStart = contentInput.selectionEnd = s + emoji.length;
              contentInput.focus();
              closeEmoji();
            });
            document.addEventListener("click", (e) => {
              if (!emojiPop.contains(e.target) && !emojiToggle.contains(e.target)) closeEmoji();
            });
            document.addEventListener("keydown", (e) => {
              if (e.key === "Escape") closeEmoji();
            });
          }
        })();
      </script>

      <script data-astro-rerun>
        // 播放器增强：倍速菜单 / 循环 / 键盘 / 双击全屏 / 播放位置记忆（纯 JS，见 data-astro-rerun 约定）
        (() => {
          const video = document.getElementById("v-video");
          if (!video) return;
          const vid = video.dataset.videoId || "0";
          const rateBtn = document.getElementById("v-rate-btn");
          const rateMenu = document.getElementById("v-rate-menu");
          const loopBtn = document.getElementById("v-loop-btn");
          const resumeToast = document.getElementById("v-resume");

          // ── 倍速：菜单选择 + 恢复上次倍速 + 高亮当前项 ──
          const setRate = (r) => {
            if (!Number.isFinite(r) || r <= 0) return;
            video.playbackRate = r;
            if (rateBtn) rateBtn.textContent = r + "x";
            try { localStorage.setItem("video-rate", String(r)); } catch {}
            if (rateMenu) {
              rateMenu.classList.add("hidden");
              for (const b of rateMenu.querySelectorAll("[data-rate]")) {
                const on = b.getAttribute("data-rate") === String(r);
                b.classList.toggle("text-[var(--color-accent)]", on);
                b.classList.toggle("font-bold", on);
              }
            }
          };
          let savedRate = 1.0;
          try { savedRate = parseFloat(localStorage.getItem("video-rate") || "1.0") || 1.0; } catch {}
          setRate(savedRate);

          rateBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            rateMenu?.classList.toggle("hidden");
          });
          rateMenu?.addEventListener("click", (e) => {
            const b = e.target instanceof Element ? e.target.closest("[data-rate]") : null;
            if (!b) return;
            setRate(parseFloat(b.getAttribute("data-rate") || "1"));
          });
          document.addEventListener("click", (e) => {
            if (!(e.target instanceof Element)) return;
            if (rateMenu && !rateMenu.classList.contains("hidden") && !rateMenu.contains(e.target) && !rateBtn?.contains(e.target)) {
              rateMenu.classList.add("hidden");
            }
          });

          // ── 循环开关 ──
          const syncLoop = () => {
            if (!loopBtn) return;
            loopBtn.setAttribute("aria-pressed", video.loop ? "true" : "false");
            loopBtn.textContent = video.loop ? "循环 开" : "循环 关";
            loopBtn.classList.toggle("text-[var(--color-accent)]", video.loop);
            loopBtn.classList.toggle("border-[var(--color-accent)]/50", video.loop);
          };
          loopBtn?.addEventListener("click", () => {
            video.loop = !video.loop;
            syncLoop();
          });
          syncLoop();

          // ── 播放位置记忆：每 3s 落一次 localStorage，看完自动清除；重进页跳回上次位置 ──
          const posKey = "video-pos:" + vid;
          let lastSave = 0;
          video.addEventListener("timeupdate", () => {
            const now = Date.now();
            if (now - lastSave > 3000 && video.currentTime > 1) {
              lastSave = now;
              try { localStorage.setItem(posKey, String(video.currentTime)); } catch {}
            }
          });
          video.addEventListener("ended", () => {
            try { localStorage.removeItem(posKey); } catch {}
          });
          video.addEventListener("loadedmetadata", () => {
            let saved = 0;
            try { saved = parseFloat(localStorage.getItem(posKey) || "0") || 0; } catch {}
            if (saved > 5 && video.duration && saved < video.duration - 5) {
              video.currentTime = saved;
              if (resumeToast) {
                const m = Math.floor(saved / 60);
                const s = String(Math.floor(saved % 60)).padStart(2, "0");
                resumeToast.textContent = "已从 " + m + ":" + s + " 继续播放";
                resumeToast.classList.remove("hidden");
                setTimeout(() => resumeToast.classList.add("hidden"), 2500);
              }
            }
          });

          // ── 键盘：空格/←→/↑↓（输入框与原生控制条聚焦时让位，防双触发）──
          document.addEventListener("keydown", (e) => {
            if (e.target instanceof Element && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
            if (e.target === video) return;
            if (e.key === " ") {
              e.preventDefault();
              if (video.paused) video.play(); else video.pause();
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              video.currentTime = Math.max(0, video.currentTime - 5);
            } else if (e.key === "ArrowRight") {
              e.preventDefault();
              video.currentTime = Math.min(video.duration || Number.MAX_SAFE_INTEGER, video.currentTime + 5);
            } else if (e.key === "ArrowUp") {
              e.preventDefault();
              video.volume = Math.min(1, video.volume + 0.1);
            } else if (e.key === "ArrowDown") {
              e.preventDefault();
              video.volume = Math.max(0, video.volume - 0.1);
            }
          });

          // ── 单击播放/暂停（250ms 延迟区分双击）+ 双击全屏；原生控制条区域让位 ──
          // （控制条在 shadow DOM 里，点击会冒泡到 <video>，不拦会双触发）
          const inControlsZone = (e) => {
            const r = video.getBoundingClientRect();
            return e.clientY - r.top > r.height - 60;
          };
          let clickTimer = null;
          video.addEventListener("click", (e) => {
            if (inControlsZone(e)) return;
            if (clickTimer) {
              clearTimeout(clickTimer);
              clickTimer = null;
              return;
            }
            clickTimer = setTimeout(() => {
              clickTimer = null;
              if (video.paused) video.play(); else video.pause();
            }, 250);
          });
          video.addEventListener("dblclick", (e) => {
            if (inControlsZone(e)) return;
            if (clickTimer) {
              clearTimeout(clickTimer);
              clickTimer = null;
            }
            if (document.fullscreenElement) {
              document.exitFullscreen?.();
            } else {
              video.requestFullscreen?.();
            }
          });
        })();
      </script>
  </article>
</Layout>
