---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — 未找到">
  <div class="flex flex-col items-center justify-center py-28 text-center">
    <p class="text-[10rem] md:text-[14rem] font-bold leading-none tracking-[-0.04em] text-[var(--color-border)] select-none">
      404
    </p>
    <p class="text-lg text-[var(--color-text-muted)] font-serif mb-8 -mt-2">
      这个页面去了遥远的星系
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold rounded-xl bg-[var(--color-text)] text-white hover:bg-[var(--color-text-muted)] transition-colors duration-200"
    >
      返回首页
      <span>→</span>
    </a>
  </div>
</Layout>
