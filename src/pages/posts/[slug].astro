---
import Layout from "../../layouts/Layout.astro";
import LikeButton from "../../components/LikeButton";
import ShareButtons from "../../components/ShareButtons";
import ReadingProgress from "../../components/ReadingProgress";
import TocNav from "../../components/TocNav";
import { db } from "../../db";
import { posts, comments, likes } from "../../db/schema";
import { eq, and, lt, gt, desc, asc, sql } from "drizzle-orm";
import { parseTags, getParentTag, getChildTags } from "../../lib/tags";
import { renderMarkdown, extractHeadings } from "../../lib/markdown";
import { formatDateCN, dbDateToISO } from "../../lib/datetime";
import glossaryRaw from "../../data/glossary.json";

// 术语词典（序列化后经 define:vars 注入内联脚本，供正文术语标注与悬停卡片使用）
const glossaryJson = JSON.stringify(glossaryRaw);
import { optimizeImgSrc, imgSrcSet } from "../../lib/imgsrc";

export const prerender = false;

const { slug } = Astro.params;
const post = db.select().from(posts).where(eq(posts.slug, slug)).get();

if (!post || !post.published) {
  return Astro.redirect("/404");
}

// 浏览量：本次访问之前的累计值先读出来展示，随后 +1（并发下少许误差对博客无碍）
const postViews = post.views;
db.update(posts)
  .set({ views: sql`${posts.views} + 1` })
  .where(eq(posts.id, post.id))
  .run();

const postLikes = db.select().from(likes).where(eq(likes.postId, post.id)).get();
const postComments = db
  .select()
  .from(comments)
  .where(eq(comments.postId, post.id))
  .orderBy(comments.createdAt)
  .all();

// 评论盖楼：顶层评论 + 挂在其下的回复（只做一层）；回复可指向回复，展示时归并到同一顶层
const rootComments = postComments.filter((c) => c.parentId === null);
const repliesOf = (id: number) => postComments.filter((c) => c.parentId === id);
const authorOf = (id: number | null) => postComments.find((c) => c.id === id)?.author;

// 相邻文章（按发布时间，仅已发布）
const prevPost = db
  .select({ title: posts.title, slug: posts.slug })
  .from(posts)
  .where(and(eq(posts.published, true), lt(posts.createdAt, post.createdAt)))
  .orderBy(desc(posts.createdAt))
  .limit(1)
  .get();
const nextPost = db
  .select({ title: posts.title, slug: posts.slug })
  .from(posts)
  .where(and(eq(posts.published, true), gt(posts.createdAt, post.createdAt)))
  .orderBy(asc(posts.createdAt))
  .limit(1)
  .get();

const tagList = parseTags(post.tags);

const parentTag = getParentTag(tagList);
const childTags = getChildTags(tagList);

// createdAt 是 UTC 时间串，formatDateCN 内部会补时区再格式化
const formattedDate = formatDateCN(post.createdAt);

// 目录（h2/h3）与字数、阅读时长
const headings = extractHeadings(post.content);
const contentHtml = renderMarkdown(post.content);
const charCount = post.content.replace(/\s/g, "").length;
const wordCountDisplay = charCount > 9999 ? `${(charCount / 10000).toFixed(1)} 万` : String(charCount);
const readMinutes = Math.max(1, Math.ceil(charCount / 400));
const viewsDisplay = postViews > 9999 ? `${(postViews / 10000).toFixed(1)} 万` : String(postViews);
---

<Layout
  title={post.title}
  description={post.excerpt}
  ogImage={post.coverImage?.startsWith("/") ? post.coverImage : undefined}
  ogType="article"
>
  <ReadingProgress client:load />
  {headings.length >= 3 && <TocNav client:load headings={headings} />}

  <article class="max-w-3xl mx-auto py-10 md:py-14">
    <!-- Back navigation -->
    <a
      href="/posts"
      class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] transition-colors mb-8 group"
    >
      <span class="inline-block transition-transform group-hover:-translate-x-1">←</span>
      返回文章列表
    </a>

    <!-- Header -->
    <header class="mb-10">
      <!-- Tags -->
      <div class="flex flex-wrap items-center gap-1.5 mb-5">
        {parentTag && (
          <span
            class="text-[11px] font-semibold tracking-wide uppercase px-2.5 py-0.5 rounded-md bg-[var(--color-accent)] text-white"
          >
            {parentTag}
          </span>
        )}
        {childTags.map((tag) => (
          <span
            class="text-[11px] font-semibold tracking-wide uppercase px-2.5 py-0.5 rounded-md bg-[var(--color-accent-muted)] text-[var(--color-accent)]"
          >
            {tag}
          </span>
        ))}
      </div>

      <!-- Title -->
      <h1 class="text-3xl md:text-4xl lg:text-[2.5rem] font-bold tracking-[-0.02em] leading-[1.2] mb-5 text-[var(--color-text)]">
        {post.title}
      </h1>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-[var(--color-text-subtle)] font-medium">
        <time datetime={dbDateToISO(post.createdAt)}>{formattedDate}</time>
        {
          post.updatedAt !== post.createdAt && (
            <>
              <span class="w-1 h-1 rounded-full bg-[var(--color-text-subtle)]" />
              <span>更新于 {formatDateCN(post.updatedAt, { year: "numeric", month: "long", day: "numeric" })}</span>
            </>
          )
        }
        <span class="w-1 h-1 rounded-full bg-[var(--color-text-subtle)]" />
        <span>{wordCountDisplay} 字</span>
        <span class="w-1 h-1 rounded-full bg-[var(--color-text-subtle)]" />
        <span>约 {readMinutes} 分钟阅读</span>
        <span class="w-1 h-1 rounded-full bg-[var(--color-text-subtle)]" />
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          {viewsDisplay} 次浏览
        </span>
      </div>
    </header>

    <!-- Cover image -->
    {
      post.coverImage && (
        <img
          src={optimizeImgSrc(post.coverImage)}
          srcset={imgSrcSet(post.coverImage, [768, 1536])}
          sizes="(max-width: 768px) 100vw, 768px"
          alt={post.title}
          loading="lazy"
          class="w-full rounded-2xl border border-[var(--color-border)] object-cover mb-12"
        />
      )
    }

    <!-- Content -->
    {/* TTS 听全文控制条 */}
    <div class="flex items-center gap-2 mb-5 -mt-2 text-sm">
      <button
        type="button"
        id="tts-btn"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium text-[var(--color-text-muted)] bg-[var(--color-bg)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/40 hover:text-[var(--color-accent)] transition-all"
      >
        🔊 听全文
      </button>
      <button
        type="button"
        id="tts-rate"
        class="px-3 py-1.5 rounded-full text-xs font-medium text-[var(--color-text-subtle)] bg-[var(--color-bg)] border border-[var(--color-border)] hover:text-[var(--color-accent)] transition-all tabular-nums"
        title="切换语速"
      >
        1x
      </button>
      <span id="tts-status" class="text-xs text-[var(--color-text-subtle)]"></span>
    </div>
    {/* TTS 听全文：控制入口在导航「设置」下拉（TopNav），此处仅保留状态显示 */}
    <div id="tts-bar" hidden>
      <button
        type="button"
        id="tts-btn"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium text-[var(--color-text-muted)] bg-[var(--color-bg)] border border-[var(--color-border)]"
      >
        🔊 听全文
      </button>
      <button
        type="button"
        id="tts-rate"
        class="ml-2 px-3 py-1.5 rounded-full text-xs font-medium text-[var(--color-text-subtle)] bg-[var(--color-bg)] border border-[var(--color-border)] tabular-nums"
      >
        1x
      </button>
      <span id="tts-status" class="ml-2 text-xs text-[var(--color-text-subtle)]"></span>
    </div>
    <div class="prose max-w-none mb-14" set:html={contentHtml} />

    <!-- Divider -->
    <div class="flex items-center gap-4 mb-10">
      <div class="flex-1 h-px bg-[var(--color-border)]" />
      <span class="text-xs text-[var(--color-text-subtle)] uppercase tracking-widest font-semibold">End</span>
      <div class="flex-1 h-px bg-[var(--color-border)]" />
    </div>

    <!-- Like + Share section -->
    <div class="flex flex-col items-center gap-4 mb-14">
      <p class="text-xs text-[var(--color-text-subtle)] uppercase tracking-widest font-semibold">
        这篇文章对你有帮助吗？
      </p>
      <LikeButton client:load postId={post.id} initialCount={postLikes?.count || 0} />
      <ShareButtons client:load title={post.title} coverImage={post.coverImage} date={formatDateCN(post.createdAt)} />
    </div>

    <!-- Prev / Next -->
    <nav class="grid sm:grid-cols-2 gap-3 mb-14">
      {
        prevPost ? (
          <a
            href={`/posts/${encodeURIComponent(prevPost.slug)}`}
            data-nav-prev
            class="group bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/40 rounded-xl p-4 transition-colors"
          >
            <p class="text-[11px] text-[var(--color-text-subtle)] mb-1.5">← 上一篇</p>
            <p class="text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors leading-snug">
              {prevPost.title}
            </p>
          </a>
        ) : (
          <span />
        )
      }
      {
        nextPost ? (
          <a
            href={`/posts/${encodeURIComponent(nextPost.slug)}`}
            data-nav-next
            class="group bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/40 rounded-xl p-4 transition-colors sm:text-right"
          >
            <p class="text-[11px] text-[var(--color-text-subtle)] mb-1.5">下一篇 →</p>
            <p class="text-sm font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors leading-snug">
              {nextPost.title}
            </p>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <!-- Comments section -->
    <section id="comments" class="max-w-2xl mx-auto">
      <div class="flex items-center gap-3 mb-8">
        <h2 class="text-lg font-bold tracking-[-0.01em]">评论</h2>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-[var(--color-border)] text-[var(--color-text-subtle)]">
          {postComments.length}
        </span>
      </div>

      <!-- Comment list -->
      {
        rootComments.length === 0 ? (
          <p class="text-center py-10 text-sm text-[var(--color-text-subtle)] font-serif">
            暂无评论，成为第一个留言的人
          </p>
        ) : (
          <div class="space-y-3 mb-10">
            {rootComments.map((comment) => {
              const replies = repliesOf(comment.id);
              return (
                <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4 hover:border-[var(--color-border-hover)] transition-colors duration-200">
                  <div class="flex items-center gap-2.5 mb-2.5">
                    <div class="w-7 h-7 rounded-full bg-[var(--color-accent-muted)] text-[var(--color-accent)] flex items-center justify-center text-xs font-bold">
                      {comment.author.charAt(0)}
                    </div>
                    <span class="font-semibold text-sm text-[var(--color-text)]">{comment.author}</span>
                    <span class="text-xs text-[var(--color-text-subtle)]">
                      {new Date(comment.createdAt).toLocaleDateString("zh-CN", {
                        month: "short",
                        day: "numeric",
                      })}
                    </span>
                    <button
                      type="button"
                      data-reply-to={comment.id}
                      data-reply-author={comment.author}
                      class="ml-auto text-xs text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] transition-colors"
                    >
                      回复
                    </button>
                  </div>
                  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed pl-9">{comment.content}</p>

                  {replies.length > 0 && (
                    <div class="mt-3 pl-9 space-y-3">
                      {replies.map((reply) => {
                        const target = authorOf(reply.parentId);
                        return (
                          <div class="bg-[var(--color-bg)] rounded-lg p-3">
                            <div class="flex items-center gap-2 mb-1.5">
                              <span class="font-semibold text-xs text-[var(--color-text)]">{reply.author}</span>
                              {target && (
                                <span class="text-[11px] text-[var(--color-text-subtle)]">
                                  回复 @{target}
                                </span>
                              )}
                              <span class="text-[11px] text-[var(--color-text-subtle)]">
                                {new Date(reply.createdAt).toLocaleDateString("zh-CN", {
                                  month: "short",
                                  day: "numeric",
                                })}
                              </span>
                            </div>
                            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{reply.content}</p>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )
      }

      <!-- Comment form -->
      <form method="POST" action="/api/comment" class="space-y-3">
        <input type="hidden" name="postId" value={post.id} />
        <input type="hidden" name="slug" value={slug} />
        <input type="hidden" name="parentId" value="" />
        {/* 回复目标提示条 */}
        <div
          id="reply-notice"
          class="hidden items-center gap-2 text-xs text-[var(--color-text-muted)] bg-[var(--color-bg)] border border-[var(--color-border)] rounded-lg px-3 py-2"
        >
          <span>
            回复 <span id="reply-notice-author" class="font-semibold text-[var(--color-accent)]" />
          </span>
          <button type="button" id="reply-cancel" class="text-[var(--color-text-subtle)] hover:text-[var(--color-text)] transition-colors">
            取消
          </button>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="text"
            name="author"
            id="comment-author"
            placeholder="昵称"
            maxlength="20"
            required
            class="sm:w-28 px-3.5 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all duration-300"
          />
          <div class="flex-1 flex gap-2.5">
            <input
              type="text"
              name="content"
              id="comment-content"
              placeholder="写下你的想法..."
              maxlength="500"
              required
              class="flex-1 px-3.5 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all duration-300"
            />
            <div class="relative">
              <button
                type="button"
                id="emoji-toggle"
                aria-label="插入表情"
                title="插入表情"
                class="w-10 h-full flex items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-all duration-300"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 3.75c0 .414.168.75.375.75s.375-.336.375-.75-.168-.75-.375-.75-.375.336-.375.75Zm6.75-3.75c0 .414-.168.75-.375.75S15 10.164 15 9.75 15.168 9 15.375 9s.375.336.375.75Zm-.375 3.75c0 .414.168.75.375.75s.375-.336.375-.75-.168-.75-.375-.75-.375.336-.375.75Z" />
                </svg>
              </button>
              <div
                id="emoji-pop"
                class="hidden absolute bottom-full right-0 mb-2 w-[248px] p-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg z-10 grid grid-cols-8 gap-0.5"
              >
                {
                  [
                    "😀", "😄", "😁", "😆", "😊", "😍", "🤩", "😎",
                    "🤔", "😅", "😮", "😭", "😢", "😡", "🤯", "😴",
                    "🥳", "🤗", "🙄", "😤", "🫡", "🤝", "👍", "👎",
                    "👏", "🙏", "💪", "❤️", "🔥", "✨", "🎉", "🚀",
                  ].map((e) => (
                    <button type="button" data-emoji={e} class="w-7 h-7 rounded-md text-base leading-none hover:bg-[var(--color-bg)] transition-colors">
                      {e}
                    </button>
                  ))
                }
              </div>
            </div>
            <button
              type="submit"
              class="px-5 py-2.5 text-sm font-semibold rounded-xl bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-colors duration-200 active:scale-[0.97]"
            >
              发送
            </button>
          </div>
        </div>
      </form>

      <script data-astro-rerun>
        // 评论表单增强：昵称记忆（localStorage）+ 回复定位与取消 + 表情选择器
        // data-astro-rerun：ClientRouter 换页回到本文时重新执行（表单是新 DOM 需重新绑定）
        (() => {
          const form = document.querySelector('form[action="/api/comment"]');
          if (!form) return;
          const authorInput = form.querySelector('input[name="author"]');
          const parentInput = form.querySelector('input[name="parentId"]');
          const notice = form.querySelector("#reply-notice");
          const noticeAuthor = form.querySelector("#reply-notice-author");
          const cancelBtn = form.querySelector("#reply-cancel");

          const clearReply = () => {
            if (parentInput) parentInput.value = "";
            notice?.classList.add("hidden");
            notice?.classList.remove("flex");
          };

          try {
            const saved = localStorage.getItem("comment-author");
            if (saved && authorInput && !authorInput.value) authorInput.value = saved;
          } catch {}

          form.addEventListener("submit", () => {
            try {
              if (authorInput) localStorage.setItem("comment-author", authorInput.value);
            } catch {}
          });

          for (const btn of document.querySelectorAll("[data-reply-to]")) {
            btn.addEventListener("click", () => {
              if (!parentInput || !notice) return;
              parentInput.value = btn.dataset.replyTo ?? "";
              if (noticeAuthor) noticeAuthor.textContent = `@${btn.dataset.replyAuthor ?? ""}`;
              notice.classList.remove("hidden");
              notice.classList.add("flex");
              form.scrollIntoView({ behavior: "smooth", block: "center" });
              form.querySelector('input[name="content"]')?.focus();
            });
          }
          cancelBtn?.addEventListener("click", clearReply);

          // 表情选择器：点击插入到光标处，点外部 / Esc / 选中后收起
          const emojiToggle = form.querySelector("#emoji-toggle");
          const emojiPop = form.querySelector("#emoji-pop");
          const contentInput = form.querySelector('input[name="content"]');
          const closeEmoji = () => emojiPop?.classList.add("hidden");
          if (emojiToggle && emojiPop && contentInput) {
            emojiToggle.addEventListener("click", (e) => {
              e.stopPropagation();
              emojiPop.classList.toggle("hidden");
              if (!emojiPop.classList.contains("hidden")) contentInput.focus();
            });
            emojiPop.addEventListener("click", (e) => {
              // data-astro-rerun 脚本按 is:inline 原样内联，不经过 TS 编译——只能写纯 JS
              const btn = e.target instanceof Element ? e.target.closest("[data-emoji]") : null;
              if (!btn) return;
              const emoji = btn.getAttribute("data-emoji") ?? "";
              const s = contentInput.selectionStart ?? contentInput.value.length;
              const en = contentInput.selectionEnd ?? s;
              contentInput.value = contentInput.value.slice(0, s) + emoji + contentInput.value.slice(en);
              contentInput.selectionStart = contentInput.selectionEnd = s + emoji.length;
              contentInput.focus();
              closeEmoji();
            });
            document.addEventListener("click", (e) => {
              if (!emojiPop.contains(e.target) && !emojiToggle.contains(e.target)) closeEmoji();
            });
            document.addEventListener("keydown", (e) => {
              if (e.key === "Escape") closeEmoji();
            });
          }
        })();
      </script>

      <script data-astro-rerun>
        // 键盘快捷键：←/→ 切上/下篇，T 收展目录。
        // document 只绑一次（事件里实时查 DOM，换页后天然服务新内容）；输入焦点与修饰键下不生效
        (() => {
          if (document.documentElement.dataset.kbdNavBound) return;
          document.documentElement.dataset.kbdNavBound = "1";
          document.addEventListener("keydown", (e) => {
            if (e.ctrlKey || e.metaKey || e.altKey) return;
            const t = e.target;
            if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable)) return;
            if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
              const link = document.querySelector(e.key === "ArrowLeft" ? "[data-nav-prev]" : "[data-nav-next]");
              if (link) {
                e.preventDefault();
                link.click();
              }
            } else if (e.key === "t" || e.key === "T") {
              const btn = document.querySelector("[aria-label='收起目录'], [aria-label='展开目录']");
              if (btn) btn.click();
            }
          });
        })();
      </script>

      <script data-astro-rerun define:vars={{ glossaryJson }}>
        // 术语悬停提示：正文首次出现的术语加虚线标注，悬停/点击弹出解释。
        // 词典由服务端注入（glossary.json）；纯 JS：data-astro-rerun 按 is:inline 不做 TS 编译。
        (() => {
          const prose = document.querySelector(".prose");
          if (!prose || prose.dataset.termsDone) return;
          prose.dataset.termsDone = "1";
          const TERMS = JSON.parse(glossaryJson);
          // 英文术语大小写不敏感：小写键 → 原键的映射（显示与查解释用原键）
          const LUT = {};
          for (const k of Object.keys(TERMS)) LUT[k.toLowerCase()] = k;
          const keys = Object.keys(TERMS).sort((a, b) => b.length - a.length);
          const esc = (t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          // 首尾是英文字母/数字的术语加词边界：避免 GitHub 内的 git、agent 内的 age 这类子串误标
          const wrapBoundary = (k) => {
            const e = esc(k);
            const head = /^[A-Za-z0-9]/.test(k) ? "\\b" : "";
            const tail = /[A-Za-z0-9]$/.test(k) ? "\\b" : "";
            return head + e + tail;
          };
          const testRe = new RegExp("(" + keys.map(wrapBoundary).join("|") + ")", "i");
          const globalRe = new RegExp("(" + keys.map(wrapBoundary).join("|") + ")", "gi");

          // TreeWalker 收集含术语的文本节点（跳过代码/链接/已标注）
          const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
              const parent = node.parentElement;
              if (!parent || parent.closest("pre, code, a, .term, button")) return NodeFilter.FILTER_REJECT;
              return testRe.test(node.textContent) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
            },
          });
          const nodes = [];
          while (walker.nextNode()) nodes.push(walker.currentNode);

          // 网址段保护：URL 文本整体跳过术语标注（避免 github.com 里的 git 等被误标）
          const urlRe = /(https?:\/\/\S+|www\.\S+)/gi;
          const annotate = (text, frag) => {
            let last = 0;
            globalRe.lastIndex = 0;
            let m;
            while ((m = globalRe.exec(text))) {
              if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
              const key = LUT[m[0].toLowerCase()] || m[0];
              const span = document.createElement("span");
              span.className = "term";
              span.dataset.term = key;
              span.textContent = m[0];
              frag.appendChild(span);
              last = m.index + m[0].length;
            }
            if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
          };
          const annotateNode = (node) => {
            const frag = document.createDocumentFragment();
            const text = node.textContent;
            let pos = 0;
            urlRe.lastIndex = 0;
            let um;
            while ((um = urlRe.exec(text))) {
              annotate(text.slice(pos, um.index), frag);
              frag.appendChild(document.createTextNode(text.slice(um.index, urlRe.lastIndex)));
              pos = urlRe.lastIndex;
            }
            annotate(text.slice(pos), frag);
            node.parentNode.replaceChild(frag, node);
          };

          for (const node of nodes) annotateNode(node);

          // 悬停卡片：全局委托 + 惰性创建（转场后 DOM 重建也不受影响）
          let tip = null;
          let hideTimer = null;
          const ensureTip = () => {
            if (!tip || !document.body.contains(tip)) {
              tip = document.createElement("div");
              tip.className = "term-card";
              document.body.appendChild(tip);
            }
            return tip;
          };
          const showTip = (el) => {
            clearTimeout(hideTimer);
            const card = ensureTip();
            const term = el.dataset.term || "";
            card.textContent = "";
            const b = document.createElement("b");
            b.textContent = term;
            const span = document.createElement("span");
            span.textContent = TERMS[term] || "";
            card.appendChild(b);
            card.appendChild(span);
            const r = el.getBoundingClientRect();
            card.classList.add("show");
            const cw = card.offsetWidth;
            const ch = card.offsetHeight;
            let x = Math.min(Math.max(8, r.left + r.width / 2 - cw / 2), innerWidth - cw - 8);
            let y = r.bottom + 8;
            if (y + ch > innerHeight - 8) y = r.top - ch - 8;
            card.style.left = x + "px";
            card.style.top = Math.max(8, y) + "px";
          };
          const hideTip = () => {
            clearTimeout(hideTimer);
            hideTimer = setTimeout(() => {
              if (tip) tip.classList.remove("show");
            }, 120);
          };
          document.addEventListener("mouseover", (e) => {
            const t = e.target && e.target.closest ? e.target.closest(".term") : null;
            if (t) showTip(t);
          });
          document.addEventListener("mouseout", (e) => {
            const t = e.target && e.target.closest ? e.target.closest(".term") : null;
            if (t) hideTip();
          });
          document.addEventListener("click", (e) => {
            const t = e.target && e.target.closest ? e.target.closest(".term") : null;
            if (t) showTip(t);
          });
          window.addEventListener("scroll", hideTip, true);
          document.addEventListener("astro:before-swap", hideTip);
        })();
      </script>

      <script data-astro-rerun>
        // TTS 听全文：分段朗读 + 段落高亮 + 暂停续播 + 语速切换。
        // 用浏览器原生 SpeechSynthesis（零依赖）；纯 JS：data-astro-rerun 不做 TS 编译。
        (() => {
          const btn = document.getElementById("tts-btn");
          const rateBtn = document.getElementById("tts-rate");
          const statusEl = document.getElementById("tts-status");
          if (!btn || !rateBtn) return;
          if (!("speechSynthesis" in window)) {
            btn.textContent = "⚠ 当前浏览器不支持朗读";
            btn.disabled = true;
            return;
          }
          const synth = window.speechSynthesis;
          const rates = [1, 1.25, 1.5, 0.75];
          // 全局状态（window 级：转场重进本文时重置）；token 是代际令牌：
          // 每次停止/重定位时 +1，旧 utterance 的 onend 回调比对不一致即自行退出——
          // 否则 cancel() 触发的 onend 会把下一句重新排入队列，暂停永远停不下来（实测踩坑）
          const S = window.__kavenTTS || (window.__kavenTTS = { items: [], idx: 0, playing: false, rate: 1, highlight: null, token: 0 });
          const prose = document.querySelector(".prose");

          const collect = () => {
            if (!prose) return [];
            const out = [];
            prose.querySelectorAll("p, h2, h3, li, blockquote").forEach((el) => {
              if (el.closest("pre") || el.querySelector("pre, code, img")) return;
              const t = (el.textContent || "").replace(/\s+/g, " ").trim();
              if (t.length >= 2) out.push({ el, text: t });
            });
            return out;
          };

          const clearHi = () => {
            if (S.highlight) {
              S.highlight.classList.remove("tts-active");
              S.highlight = null;
            }
          };
          const pickVoice = () => {
            const vs = synth.getVoices();
            // 用户在设置面板选过音色则优先（按 voiceURI 与名称双匹配，防跨会话 URI 变化）
            let pref = null;
            try { pref = localStorage.getItem("tts-voice"); } catch { /* ignore */ }
            if (pref) {
              const m = vs.find((v) => v.voiceURI === pref || v.name === pref);
              if (m) return m;
            }
            return vs.find((v) => /^zh(-|_)?CN/i.test(v.lang)) || vs.find((v) => /^zh/i.test(v.lang)) || null;
          };
          const stop = (msg) => {
            S.token++;
            synth.cancel();
            S.playing = false;
            clearHi();
            btn.textContent = "🔊 听全文";
            statusEl.textContent = msg || "";
          };
          const speakNext = () => {
            clearHi();
            if (!S.playing) return;
            if (S.idx >= S.items.length) {
              stop("朗读完毕");
              return;
            }
            const item = S.items[S.idx];
            const sentences = item.text.split(/(?<=[。！？；!?])/).filter((t) => t.trim());
            let si = 0;
            const myToken = S.token;
            const speakSentence = () => {
              if (!S.playing || myToken !== S.token) return;
              if (si >= sentences.length) {
                S.idx++;
                speakNext();
                return;
              }
              const u = new SpeechSynthesisUtterance(sentences[si]);
              u.lang = "zh-CN";
              u.rate = S.rate;
              const v = pickVoice();
              if (v) u.voice = v;
              u.onstart = () => {
                if (myToken !== S.token) return;
                clearHi();
                item.el.classList.add("tts-active");
                S.highlight = item.el;
              };
              u.onend = () => {
                if (myToken !== S.token) return;
                si++;
                speakSentence();
              };
              u.onerror = () => {
                if (myToken !== S.token) return;
                si++;
                speakSentence();
              };
              synth.speak(u);
            };
            speakSentence();
          };

          btn.addEventListener("click", () => {
            if (S.playing) {
              stop("已暂停");
              btn.textContent = "▶ 继续朗读";
              return;
            }
            if (!S.items.length) S.items = collect();
            if (!S.items.length) {
              statusEl.textContent = "正文没有可朗读的内容";
              return;
            }
            S.playing = true;
            btn.textContent = "⏸ 暂停";
            statusEl.textContent = ""; // 清掉「已暂停」等残留状态文字
            speakNext();
          });

          rateBtn.addEventListener("click", () => {
            S.rate = rates[(rates.indexOf(S.rate) + 1) % rates.length];
            rateBtn.textContent = S.rate + "x";
            if (S.playing) speakFrom(S.idx); // speakFrom 递增 token，旧朗读链自动作废
          });

          synth.getVoices(); // 触发音色列表异步加载
          document.addEventListener("astro:before-swap", () => {
            synth.cancel();
            S.playing = false;
            clearHi();
          });
          window.addEventListener("beforeunload", () => synth.cancel());
        })();
      </script>
    </section>

    <!-- 代码块复制 / 语言标签 / 图片灯箱（静态增强，无框架依赖） -->
    <script>
      (() => {
        const prose = document.querySelector(".prose");
        if (!prose || prose.dataset.enhanced) return;
        prose.dataset.enhanced = "1";

        // 代码块：语言标签 + 复制按钮
        for (const pre of prose.querySelectorAll("pre")) {
          pre.classList.add("relative");
          const lang = pre.dataset.lang;
          if (lang) {
            const tag = document.createElement("span");
            tag.className = "code-lang";
            tag.textContent = lang;
            pre.appendChild(tag);
          }
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "code-copy";
          btn.textContent = "复制";
          btn.addEventListener("click", () => {
            navigator.clipboard?.writeText(pre.querySelector("code")?.textContent ?? "").then(() => {
              btn.textContent = "已复制";
              setTimeout(() => (btn.textContent = "复制"), 1500);
            });
          });
          pre.appendChild(btn);
        }

        // 图片灯箱：点击放大，Esc / 点击空白关闭
        const openLightbox = (src: string, alt: string) => {
          document.querySelector(".lightbox")?.remove();
          const box = document.createElement("div");
          box.className = "lightbox";
          const img = document.createElement("img");
          img.src = src;
          img.alt = alt;
          box.appendChild(img);
          box.addEventListener("click", () => box.remove());
          document.body.appendChild(box);
        };
        for (const img of prose.querySelectorAll("img")) {
          img.addEventListener("click", () => openLightbox(img.getAttribute("src") ?? "", img.alt));
          img.style.cursor = "zoom-in";
        }
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") document.querySelector(".lightbox")?.remove();
        });
      })();
    </script>
  </article>
</Layout>
