---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard";
import SearchBar from "../../components/SearchBar";
import TagFilter from "../../components/TagFilter.astro";
import Pagination from "../../components/Pagination.astro";
import { db } from "../../db";
import { posts, likes, comments } from "../../db/schema";
import { eq, desc, sql } from "drizzle-orm";
import { parseTags, buildTagFacets } from "../../lib/tags";

const searchQuery = Astro.url.searchParams.get("search") || "";
const l1 = Astro.url.searchParams.get("l1") || "";
const l2 = Astro.url.searchParams.get("l2") || "";
const l3 = Astro.url.searchParams.get("l3") || "";

// 排序：时间 / 点赞数 / 评论数 × 升降序（默认时间倒序）；URL 参数白名单校验
const SORT_KEYS = ["time", "likes", "comments"];
const sort: string = SORT_KEYS.includes(Astro.url.searchParams.get("sort") || "")
  ? (Astro.url.searchParams.get("sort") as string)
  : "time";
const order: string = Astro.url.searchParams.get("order") === "asc" ? "asc" : "desc";
const sortActive = sort !== "time" || order !== "desc";

// 列表只取元数据 + 点赞/评论计数（点赞每篇一行，评论按篇聚合），不带 content 大字段
const allPosts = db
  .select({
    title: posts.title,
    slug: posts.slug,
    excerpt: posts.excerpt,
    tags: posts.tags,
    coverImage: posts.coverImage,
    createdAt: posts.createdAt,
    likeCount: sql<number>`coalesce(${likes.count}, 0)`,
    commentCount: sql<number>`count(${comments.id})`,
  })
  .from(posts)
  .leftJoin(likes, eq(likes.postId, posts.id))
  .leftJoin(comments, eq(comments.postId, posts.id))
  .where(eq(posts.published, true))
  .groupBy(posts.id)
  .orderBy(desc(posts.createdAt))
  .all()
  .map((p) => ({ ...p, tagList: parseTags(p.tags) }));

// 搜索：标题/摘要/标签，忽略大小写。注意 tags 要先 parse，
// 对 JSON 原文 includes 会把引号、方括号也算进匹配
const q = searchQuery.trim().toLowerCase();
const filtered = allPosts.filter((p) => {
  if (q) {
    const inTags = p.tagList.some((t) => t.toLowerCase().includes(q));
    if (!(p.title.toLowerCase().includes(q) || p.excerpt.toLowerCase().includes(q) || inTags)) {
      return false;
    }
  }
  if (l1 && p.tagList[0] !== l1) return false;
  if (l2 && p.tagList[1] !== l2) return false;
  if (l3 && p.tagList[2] !== l3) return false;
  return true;
});

// 排序（筛选后内存排序；createdAt 格式固定，字符串比较即时间比较）
const dir = order === "asc" ? 1 : -1;
filtered.sort((a, b) => {
  if (sort === "likes") return (a.likeCount - b.likeCount) * dir;
  if (sort === "comments") return (a.commentCount - b.commentCount) * dir;
  return a.createdAt < b.createdAt ? -dir : a.createdAt > b.createdAt ? dir : 0;
});

// 分页：计数与筛选基于全量，渲染按页切片
const PAGE_SIZE = 24;
const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
const page = Math.min(totalPages, Math.max(1, Number(Astro.url.searchParams.get("page")) || 1));
const pageItems = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const facets = buildTagFacets(allPosts.map((p) => p.tagList), l1, l2);

const pageUrl = (p: number) => {
  const params = new URLSearchParams();
  if (searchQuery) params.set("search", searchQuery);
  if (l1) params.set("l1", l1);
  if (l2) params.set("l2", l2);
  if (l3) params.set("l3", l3);
  if (sortActive) {
    params.set("sort", sort);
    params.set("order", order);
  }
  if (p > 1) params.set("page", String(p));
  const qs = params.toString();
  return qs ? `/posts?${qs}` : "/posts";
};

// 排序链接：点 inactive 项按其默认方向（倒序，多数在前）；点 active 项反转方向
const sortUrl = (key: string, nextOrder: string) => {
  const params = new URLSearchParams();
  if (searchQuery) params.set("search", searchQuery);
  if (l1) params.set("l1", l1);
  if (l2) params.set("l2", l2);
  if (l3) params.set("l3", l3);
  if (!(key === "time" && nextOrder === "desc")) {
    params.set("sort", key);
    params.set("order", nextOrder);
  }
  const qs = params.toString();
  return qs ? `/posts?${qs}` : "/posts";
};

const isFiltering = Boolean(searchQuery || l1 || l2 || l3);
const showClear = isFiltering || sortActive;
const pageTitle = [l1, l2, l3].filter(Boolean).join(" · ") || (searchQuery ? `搜索: ${searchQuery}` : "文章列表");
---

<Layout title={pageTitle} description="浏览所有博客文章">
  <div class="py-8 md:py-12">
    <!-- Search（独立一行置顶） -->
    <div class="flex justify-center mb-10">
      <SearchBar client:load placeholder="搜索文章..." defaultValue={searchQuery} />
    </div>

    <!-- Header -->
    <div class="mb-6">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-2">Articles</p>
      <h1 class="text-3xl font-bold tracking-[-0.015em]">
        {searchQuery ? `"${searchQuery}" 的搜索结果` : [l1, l2, l3].filter(Boolean).join(" · ") || "所有文章"}
      </h1>
      <p class="text-sm text-[var(--color-text-muted)] mt-2 font-serif">共 {filtered.length} 篇文章</p>
    </div>

    <!-- Sort（点 inactive 项按倒序生效；再点一次切升降序） -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-subtle)] mr-1">排序</span>
      {
        [
          { key: "time", label: "时间" },
          { key: "likes", label: "点赞数" },
          { key: "comments", label: "评论数" },
        ].map(({ key, label }) => {
          const active = sort === key;
          const nextOrder = active && order === "desc" ? "asc" : "desc";
          return (
            <a
              href={sortUrl(key, nextOrder)}
              class={`inline-flex items-center gap-1 px-3 py-1 text-xs font-medium rounded-full border transition-all ${
                active
                  ? "bg-[var(--color-accent-muted)] text-[var(--color-accent)] border-[var(--color-accent)]/40"
                  : "bg-[var(--color-surface)] text-[var(--color-text-muted)] border-[var(--color-border)] hover:border-[var(--color-accent)]/50"
              }`}
            >
              {label}
              {active && <span aria-hidden="true">{order === "asc" ? "↑" : "↓"}</span>}
            </a>
          );
        })
      }
    </div>

    <!-- Category filter（清除筛选靠右，有筛选或非默认排序时才出现） -->
    <TagFilter base="/posts" l1={l1} l2={l2} l3={l3} searchQuery={searchQuery} facets={facets}>
      {
        showClear && (
          <a
            href="/posts"
            slot="extra"
            class="ml-auto inline-flex items-center gap-1 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
          >
            <span>←</span> 清除全部筛选
          </a>
        )
      }
    </TagFilter>

    <!-- Post grid -->
    {
      filtered.length === 0 ? (
        <div class="text-center py-24">
          <p class="text-[var(--color-text-muted)] text-base mb-3 font-serif">
            {searchQuery ? `没有找到与 "${searchQuery}" 相关的文章` : "没有找到符合条件的文章"}
          </p>
          {!isFiltering && (
            <p class="text-[var(--color-text-subtle)] text-sm">
              运行 <code class="bg-[var(--color-border)] px-2 py-0.5 rounded text-xs font-mono">npm run db:seed</code> 填充示例数据
            </p>
          )}
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {pageItems.map((post, i) => (
            <PostCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              tags={post.tags}
              coverImage={post.coverImage ?? undefined}
              createdAt={post.createdAt}
              likeCount={post.likeCount}
              index={i}
            />
          ))}
        </div>
      )
    }

    <!-- Pagination -->
    <Pagination page={page} totalPages={totalPages} total={filtered.length} pageUrl={pageUrl} />
  </div>
</Layout>
