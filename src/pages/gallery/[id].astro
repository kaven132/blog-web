    const lbImg = document.getElementById("lb-img");
    const lbCounter = document.getElementById("lb-counter");
    const lbLabel = document.getElementById("lb-zoom-label");
    const MIN_SCALE = 1, MAX_SCALE = 5;
    let lbOpen = false, lbScale = 1, lbTx = 0, lbTy = 0;

    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    // 平移边界：放大后的图不允许拖出视野
    const panLimit = () => ({
      x: Math.max(0, (lbImg.clientWidth * lbScale - lb.clientWidth) / 2),
      y: Math.max(0, (lbImg.clientHeight * lbScale - lb.clientHeight) / 2),
    });
