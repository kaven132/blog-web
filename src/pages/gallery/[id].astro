      applyLb();
    };
    const resetLbZoom = () => { lbScale = 1; lbTx = 0; lbTy = 0; applyLb(); };

    const openLb = () => {
      lbOpen = true;
      lb.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      lbImg.src = photos[idx];
      if (lbCounter) lbCounter.textContent = (idx + 1) + " / " + photos.length;
      resetLbZoom();
