---
import Layout from "../../layouts/Layout.astro";
import LikeButton from "../../components/LikeButton";
import { db } from "../../db";
import { galleries, galleryPhotos, galleryLikes, galleryComments } from "../../db/schema";
import { asc, eq, sql } from "drizzle-orm";
import { AUTH_COOKIE, isAuthed, nsfwOpen } from "../../lib/auth";
import { parseCategoryPath, categoryLabel } from "../../lib/gallery-categories";
import { trackBrowse } from "../../lib/history";
import { shouldCountView } from "../../lib/view-guard";
import { sizedImgSrc } from "../../lib/imgsrc";

export const prerender = false;

const authed = isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value);
const id = Number(Astro.params.id);
const gallery = Number.isInteger(id) && id > 0
  ? db.select().from(galleries).where(eq(galleries.id, id)).get()
  : undefined;
if (!gallery) return Astro.redirect("/gallery");
// 隐私相册：未登录送登录页（登录后自动回跳）；登录但 NSFW 开关关闭送回列表（列表里本就看不到它）
if (gallery.isPrivate && !authed) {
  return Astro.redirect("/login?next=" + encodeURIComponent(`/gallery/${gallery.id}`));
}
if (gallery.isPrivate && !nsfwOpen(Astro.cookies)) {
  return Astro.redirect("/gallery");
}

// 浏览量：浏览页每次渲染 +1（先取旧值用于展示，再自增）；爬虫/30 分钟内重复访问不计数
const galleryViews = gallery.views;
if (shouldCountView(Astro.cookies, Astro.request, "gallery", gallery.id)) {
  db.update(galleries)
    .set({ views: sql`${galleries.views} + 1` })
    .where(eq(galleries.id, gallery.id))
    .run();
}
const viewsDisplay = galleryViews > 9999 ? `${(galleryViews / 10000).toFixed(1)} 万` : String(galleryViews);

// 浏览历史采集：仅登录用户记录
if (authed) {
  trackBrowse("gallery", gallery.id, gallery.title, `/gallery/${gallery.id}`);
}

const photos = db
  .select({ path: galleryPhotos.path })
  .from(galleryPhotos)
  .where(eq(galleryPhotos.galleryId, gallery.id))
  .orderBy(asc(galleryPhotos.sort), asc(galleryPhotos.id))
  .all()
  .map((p) => p.path);

const galleryLike = db.select().from(galleryLikes).where(eq(galleryLikes.galleryId, gallery.id)).get();
const galleryCommentRows = db
  .select()
  .from(galleryComments)
  .where(eq(galleryComments.galleryId, gallery.id))
  .orderBy(galleryComments.createdAt)
  .all();

// 评论盖楼：与文章页同款（顶层 + 一层回复归并）
const rootComments = galleryCommentRows.filter((c) => c.parentId === null);
const repliesOf = (cid: number) => galleryCommentRows.filter((c) => c.parentId === cid);
const authorOf = (cid: number | null) => galleryCommentRows.find((c) => c.id === cid)?.author;
---

<Layout title={`${gallery.title} · 相册`} description={gallery.description || `${gallery.title} —— ${photos.length} 张照片`}>
  <article class="py-10 md:py-14 max-w-5xl mx-auto">
    <!-- Header -->
    <header class="mb-6 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Gallery · {categoryLabel(parseCategoryPath(gallery.category))}</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-3">{gallery.title}</h1>
      {gallery.description && <p class="text-base text-[var(--color-text-muted)] leading-relaxed font-serif max-w-2xl">{gallery.description}</p>}
      <div class="mt-4 flex items-center gap-4 text-sm flex-wrap">
        <a href="/gallery" class="inline-flex items-center gap-1 text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors">
          <span aria-hidden="true">←</span> 返回相册
        </a>
        <span class="text-[var(--color-text-subtle)]">共 {photos.length} 张 · {viewsDisplay} 次浏览 · 键盘 ←/→ 可翻页</span>
      </div>
    </header>

    {photos.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-[var(--color-border)] p-10 text-center text-sm text-[var(--color-text-subtle)]">
        这个相册还没有照片
      </div>
    ) : (
      <div id="viewer-root" data-photos={JSON.stringify(photos)}>
        <!-- 大图舞台 -->
        <div id="viewer-stage" class="relative rounded-2xl overflow-hidden bg-black select-none animate-[slide-up_0.5s_ease-out_both] cursor-zoom-in" title="点击放大查看">
          <img id="viewer-img" src={photos[0]} alt="" class="block w-full max-h-[70vh] object-contain mx-auto pointer-events-none transition-opacity duration-200" draggable="false" />
          <!-- 左右切换 -->
          {photos.length > 1 && (
            <>
              <button type="button" id="btn-prev" aria-label="上一张"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full bg-black/50 text-white text-xl leading-none hover:bg-black/70 transition-colors">‹</button>
              <button type="button" id="btn-next" aria-label="下一张"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full bg-black/50 text-white text-xl leading-none hover:bg-black/70 transition-colors">›</button>
            </>
          )}
          <!-- 幻灯片控制 + 计数（多图时）；单图仅保留计数 -->
          {photos.length > 1 ? (
            <div class="absolute bottom-3 right-3 flex items-center gap-1.5">
              <button type="button" id="btn-play" aria-label="播放幻灯片" title="幻灯片播放" class="w-8 h-8 flex items-center justify-center rounded-full bg-black/55 text-white hover:bg-black/75 transition-colors">
                <svg data-icon-play class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                <svg data-icon-pause class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
              </button>
              <button type="button" id="btn-speed" title="切换播放间隔" class="h-8 px-2.5 rounded-full bg-black/55 text-white text-xs font-mono hover:bg-black/75 transition-colors">5s</button>
              <span id="viewer-counter" class="rounded-full bg-black/50 text-white text-xs px-2.5 py-1 font-mono"></span>
            </div>
          ) : (
            <span id="viewer-counter" class="absolute bottom-3 right-3 rounded-full bg-black/50 text-white text-xs px-2.5 py-1 font-mono"></span>
          )}
          <!-- 幻灯片进度条 -->
          {photos.length > 1 && (
            <div id="sl-progress" class="absolute bottom-0 left-0 h-[3px] bg-[var(--color-accent)]" style="width:0%"></div>
          )}
          <!-- 网格总览入口 -->
          {photos.length > 1 && (
            <button type="button" id="btn-grid" aria-label="查看全部照片" title="查看全部照片" class="absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-full bg-black/55 text-white hover:bg-black/75 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" /></svg>
            </button>
          )}
        </div>

        <!-- 缩略图条 -->
        {photos.length > 1 && (
          <div id="viewer-thumbs" class="mt-3 flex gap-2 overflow-x-auto scrollbar-none pb-1">
            {photos.map((p, i) => (
              <button type="button" data-thumb={i} class="flex-shrink-0 rounded-lg overflow-hidden border-2 border-transparent transition-colors" aria-label={`第 ${i + 1} 张`}>
                <img src={sizedImgSrc(p, 128)} alt="" class="h-14 w-auto block" loading="lazy" draggable="false" />
              </button>
            ))}
          </div>
        )}

        <!-- 全屏灯箱：点击大图打开，滚轮/按钮/双击缩放，拖拽平移 -->
        <div id="lightbox" class="hidden fixed inset-0 z-[300] bg-black/95 select-none" style="touch-action:none">
          <div class="absolute inset-0 flex items-center justify-center">
            <img id="lb-img" src={photos[0]} alt="" class="max-w-[94vw] max-h-[88vh] will-change-transform transition-opacity duration-200" draggable="false" />
          </div>
          <!-- 工具条 -->
          <div class="absolute top-3 left-1/2 -translate-x-1/2 flex items-center gap-0.5 rounded-full bg-black/60 backdrop-blur px-1.5 py-1 text-white">
            <button type="button" id="lb-zoom-out" aria-label="缩小" class="w-8 h-8 rounded-full hover:bg-white/15 text-lg leading-none transition-colors">−</button>
            <span id="lb-zoom-label" class="w-12 text-center text-xs font-mono">100%</span>
            <button type="button" id="lb-zoom-in" aria-label="放大" class="w-8 h-8 rounded-full hover:bg-white/15 text-lg leading-none transition-colors">+</button>
            <button type="button" id="lb-zoom-reset" class="px-2.5 h-8 rounded-full text-xs hover:bg-white/15 transition-colors">适应屏幕</button>
            {photos.length > 1 && (
              <>
                <span class="w-px h-4 bg-white/25 mx-1"></span>
                <button type="button" id="lb-play" aria-label="播放幻灯片" title="幻灯片播放（空格）" class="w-8 h-8 rounded-full hover:bg-white/15 transition-colors flex items-center justify-center">
                  <svg data-icon-play class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  <svg data-icon-pause class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
                </button>
                <button type="button" id="lb-speed" title="切换播放间隔" class="px-2 h-8 rounded-full text-xs font-mono hover:bg-white/15 transition-colors">5s</button>
                <button type="button" id="lb-grid" aria-label="查看全部照片" title="查看全部照片" class="w-8 h-8 rounded-full hover:bg-white/15 transition-colors flex items-center justify-center">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" /></svg>
                </button>
              </>
            )}
            <span class="w-px h-4 bg-white/25 mx-1"></span>
            <button type="button" id="lb-close" aria-label="关闭" class="w-8 h-8 rounded-full hover:bg-white/15 transition-colors">
              <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
          {photos.length > 1 && (
            <>
              <button type="button" id="lb-prev" aria-label="上一张" class="absolute left-3 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-black/50 text-white text-2xl leading-none hover:bg-black/70 transition-colors">‹</button>
              <button type="button" id="lb-next" aria-label="下一张" class="absolute right-3 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-black/50 text-white text-2xl leading-none hover:bg-black/70 transition-colors">›</button>
            </>
          )}
          <span id="lb-counter" class="absolute bottom-14 right-4 rounded-full bg-black/50 text-white text-xs px-2.5 py-1 font-mono"></span>
          {photos.length > 1 && (
            <div id="lb-sl-progress" class="absolute bottom-0 left-0 h-[3px] bg-[var(--color-accent)]" style="width:0%"></div>
          )}
          <p class="absolute bottom-4 left-1/2 -translate-x-1/2 text-[11px] text-white/50 whitespace-nowrap">滚轮缩放 · 拖拽平移 · 双击放大 · ←/→ 切换 · 空格 幻灯片 · Esc 关闭</p>
        </div>

        <!-- 网格总览：全部照片一屏速览，点击直达（叠在灯箱之上 z-[320]） -->
        <div id="grid-modal" class="hidden fixed inset-0 z-[320] bg-black/90 select-none">
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-white">
            <span class="text-sm font-medium">全部照片 · {photos.length} 张</span>
            <button type="button" id="grid-close" aria-label="关闭总览" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/15 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <div class="absolute inset-0 top-14 bottom-4 overflow-y-auto px-4 sm:px-6">
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2 max-w-6xl mx-auto">
              {photos.map((p, i) => (
                <button type="button" data-grid-cell={i} aria-label={`第 ${i + 1} 张`} class="relative aspect-square rounded-lg overflow-hidden border-2 border-transparent hover:border-white/40 transition-colors">
                  <img src={sizedImgSrc(p, 320)} alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" draggable="false" />
                  <span class="absolute bottom-1 right-1 rounded bg-black/55 text-white text-[10px] px-1.5 py-0.5 font-mono">{i + 1}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 点赞 + 评论区（与文章页同构） -->
    <section id="comments" class="mt-12 max-w-2xl mx-auto">
      <div class="flex flex-col items-center gap-5 mb-12">
        <p class="text-xs text-[var(--color-text-subtle)] uppercase tracking-widest font-semibold">
          喜欢这个相册吗？
        </p>
        <LikeButton client:load target="gallery" galleryId={gallery.id} initialCount={galleryLike?.count || 0} />
      </div>

      <div class="flex items-center gap-3 mb-8">
        <h2 class="text-lg font-bold tracking-[-0.01em]">评论</h2>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-[var(--color-border)] text-[var(--color-text-subtle)]">
          {galleryCommentRows.length}
        </span>
      </div>

      {
        rootComments.length === 0 ? (
          <p class="text-center py-10 text-sm text-[var(--color-text-subtle)] font-serif">
            暂无评论，成为第一个留言的人
          </p>
        ) : (
          <div class="space-y-3 mb-10">
            {rootComments.map((comment) => {
              const replies = repliesOf(comment.id);
              return (
                <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4 hover:border-[var(--color-border-hover)] transition-colors duration-200">
                  <div class="flex items-center gap-2.5 mb-2.5">
                    <div class="w-7 h-7 rounded-full bg-[var(--color-accent-muted)] text-[var(--color-accent)] flex items-center justify-center text-xs font-bold">
                      {comment.author.charAt(0)}
                    </div>
                    <span class="font-semibold text-sm text-[var(--color-text)]">{comment.author}</span>
                    <span class="text-xs text-[var(--color-text-subtle)]">
                      {new Date(comment.createdAt).toLocaleDateString("zh-CN", {
                        month: "short",
                        day: "numeric",
                      })}
                    </span>
                    <button
                      type="button"
                      data-reply-to={comment.id}
                      data-reply-author={comment.author}
                      class="ml-auto text-xs text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] transition-colors"
                    >
                      回复
                    </button>
                  </div>
                  <p class="text-sm text-[var(--color-text-muted)] leading-relaxed pl-9">{comment.content}</p>

                  {replies.length > 0 && (
                    <div class="mt-3 pl-9 space-y-3">
                      {replies.map((reply) => {
                        const target = authorOf(reply.parentId);
                        return (
                          <div class="bg-[var(--color-bg)] rounded-lg p-3">
                            <div class="flex items-center gap-2 mb-1.5">
                              <span class="font-semibold text-xs text-[var(--color-text)]">{reply.author}</span>
                              {target && (
                                <span class="text-[11px] text-[var(--color-text-subtle)]">
                                  回复 @{target}
                                </span>
                              )}
                              <span class="text-[11px] text-[var(--color-text-subtle)]">
                                {new Date(reply.createdAt).toLocaleDateString("zh-CN", {
                                  month: "short",
                                  day: "numeric",
                                })}
                              </span>
                            </div>
                            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{reply.content}</p>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )
      }

      <!-- 评论表单 -->
      <form method="POST" action="/api/comment" class="space-y-3">
        <input type="hidden" name="galleryId" value={gallery.id} />
        <input type="hidden" name="parentId" value="" />
        <div
          id="reply-notice"
          class="hidden items-center gap-2 text-xs text-[var(--color-text-muted)] bg-[var(--color-bg)] border border-[var(--color-border)] rounded-lg px-3 py-2"
        >
          <span>
            回复 <span id="reply-notice-author" class="font-semibold text-[var(--color-accent)]" />
          </span>
          <button type="button" id="reply-cancel" class="text-[var(--color-text-subtle)] hover:text-[var(--color-text)] transition-colors">
            取消
          </button>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="text"
            name="author"
            id="comment-author"
            placeholder="昵称"
            maxlength="20"
            required
            class="sm:w-28 px-3.5 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all duration-300"
          />
          <div class="flex-1 flex gap-2.5">
            <input
              type="text"
              name="content"
              id="comment-content"
              placeholder="写下你的想法..."
              maxlength="500"
              required
              class="flex-1 px-3.5 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all duration-300"
            />
            <div class="relative">
              <button
                type="button"
                id="emoji-toggle"
                aria-label="插入表情"
                title="插入表情"
                class="w-10 h-full flex items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-all duration-300"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 3.75c0 .414.168.75.375.75s.375-.336.375-.75-.168-.75-.375-.75-.375.336-.375.75Zm6.75-3.75c0 .414.168.75.375.75s.375-.336.375-.75-.168-.75-.375-.75-.375.336-.375.75Z" />
                </svg>
              </button>
              <div
                id="emoji-pop"
                class="hidden absolute bottom-full right-0 mb-2 w-[248px] p-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg z-10 grid grid-cols-8 gap-0.5"
              >
                {
                  [
                    "😀", "😄", "😁", "😆", "😊", "😍", "🤩", "😎",
                    "🤔", "😅", "😮", "😭", "😢", "😡", "🤯", "😴",
                    "🥳", "🤗", "🙄", "😤", "🫡", "🤝", "👍", "👎",
                    "👏", "🙏", "💪", "❤️", "🔥", "✨", "🎉", "🚀",
                  ].map((e) => (
                    <button type="button" data-emoji={e} class="w-7 h-7 rounded-md text-base leading-none hover:bg-[var(--color-bg)] transition-colors">
                      {e}
                    </button>
                  ))
                }
              </div>
            </div>
            <button
              type="submit"
              class="px-5 py-2.5 text-sm font-semibold rounded-xl bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-colors duration-200 active:scale-[0.97]"
            >
              发送
            </button>
          </div>
        </div>
      </form>

      <script data-astro-rerun>
        // 评论表单增强：昵称记忆（localStorage）+ 回复定位与取消 + 表情选择器（与文章页同款）
        (() => {
          const form = document.querySelector('form[action="/api/comment"]');
          if (!form) return;
          const authorInput = form.querySelector('input[name="author"]');
          const parentInput = form.querySelector('input[name="parentId"]');
          const notice = form.querySelector("#reply-notice");
          const noticeAuthor = form.querySelector("#reply-notice-author");
          const cancelBtn = form.querySelector("#reply-cancel");

          const clearReply = () => {
            if (parentInput) parentInput.value = "";
            notice?.classList.add("hidden");
            notice?.classList.remove("flex");
          };

          try {
            const saved = localStorage.getItem("comment-author");
            if (saved && authorInput && !authorInput.value) authorInput.value = saved;
          } catch {}

          form.addEventListener("submit", () => {
            try {
              if (authorInput) localStorage.setItem("comment-author", authorInput.value);
            } catch {}
          });

          for (const btn of document.querySelectorAll("[data-reply-to]")) {
            btn.addEventListener("click", () => {
              if (!parentInput || !notice) return;
              parentInput.value = btn.dataset.replyTo ?? "";
              if (noticeAuthor) noticeAuthor.textContent = `@${btn.dataset.replyAuthor ?? ""}`;
              notice.classList.remove("hidden");
              notice.classList.add("flex");
              form.scrollIntoView({ behavior: "smooth", block: "center" });
              form.querySelector('input[name="content"]')?.focus();
            });
          }
          cancelBtn?.addEventListener("click", clearReply);

          // 表情选择器：点击插入到光标处，点外部 / Esc / 选中后收起
          const emojiToggle = form.querySelector("#emoji-toggle");
          const emojiPop = form.querySelector("#emoji-pop");
          const contentInput = form.querySelector('input[name="content"]');
          const closeEmoji = () => emojiPop?.classList.add("hidden");
          if (emojiToggle && emojiPop && contentInput) {
            emojiToggle.addEventListener("click", (e) => {
