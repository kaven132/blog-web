---
import Layout from "../layouts/Layout.astro";
import { db } from "../db";
import { galleries, galleryPhotos, galleryLikes } from "../db/schema";
import { asc, desc, eq, sql } from "drizzle-orm";
import { AUTH_COOKIE, isAuthed } from "../lib/auth";
import { parseCategoryPath, categoryLabel } from "../lib/gallery-categories";

export const prerender = false;

const authed = isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value);

// ── URL 参数（与文章页同构：分类两级 + 排序 + 归档视图）──
const cat1 = Astro.url.searchParams.get("cat1") || "";
const cat2 = Astro.url.searchParams.get("cat2") || "";
const SORT_KEYS = ["time", "views", "likes", "photos"];
const sortParamRaw = Astro.url.searchParams.get("sort") || "";
const sort: string = SORT_KEYS.includes(sortParamRaw) ? sortParamRaw : "time";
const order: string = Astro.url.searchParams.get("order") === "asc" ? "asc" : "desc";
const sortActive = sort !== "time" || order !== "desc";
const view = Astro.url.searchParams.get("view") === "archive" ? "archive" : "card";

// ── 数据：匿名只看公开相册 ──
const allRows = db
  .select({
    id: galleries.id,
    title: galleries.title,
    category: galleries.category,
    description: galleries.description,
    views: galleries.views,
    isPrivate: galleries.isPrivate,
    createdAt: galleries.createdAt,
    likeCount: sql<number>`coalesce(${galleryLikes.count}, 0)`,
  })
  .from(galleries)
  .leftJoin(galleryLikes, eq(galleryLikes.galleryId, galleries.id))
  .orderBy(desc(galleries.createdAt))
  .all();
const allPhotos = db
  .select({ galleryId: galleryPhotos.galleryId, path: galleryPhotos.path })
  .from(galleryPhotos)
  .orderBy(asc(galleryPhotos.sort), asc(galleryPhotos.id))
  .all();

const byGallery = new Map();
for (const p of allPhotos) {
  let arr = byGallery.get(p.galleryId);
  if (!arr) {
    arr = [];
    byGallery.set(p.galleryId, arr);
  }
  arr.push(p.path);
}

let cards = allRows.map((g) => {
  const photos = byGallery.get(g.id) ?? [];
  const catPath = parseCategoryPath(g.category);
  return {
    id: g.id,
    title: g.title,
    cat1: catPath[0] ?? "其他",
    cat2: catPath[1] ?? "",
    label: categoryLabel(catPath),
    description: g.description,
    isPrivate: !!g.isPrivate,
    cover: photos[0] ?? "",
    count: photos.length,
    views: g.views,
    likeCount: g.likeCount,
    yearMonth: g.createdAt.slice(0, 7),
    createdAt: g.createdAt.slice(0, 10),
  };
});
// 隐私相册：未登录直接从列表剔除
if (!authed) cards = cards.filter((c) => !c.isPrivate);

// ── 分类过滤（两级）──
const filtered = cards.filter((c) => (cat1 ? c.cat1 === cat1 : true) && (cat2 ? c.cat2 === cat2 : true));

// ── 分类 facets：一级（含数量）+ 选中一级下的二级（含数量）──
const l1Facets = [];
const l2Facets = [];
{
  const l1Map = new Map();
  const l2Map = new Map();
  for (const c of cards) {
    l1Map.set(c.cat1, (l1Map.get(c.cat1) ?? 0) + 1);
    if (cat1 && c.cat1 === cat1) l2Map.set(c.cat2, (l2Map.get(c.cat2) ?? 0) + 1);
  }
  for (const [name, n] of l1Map) l1Facets.push({ name, count: n });
  for (const [name, n] of l2Map) l2Facets.push({ name, count: n });
}

// ── 排序（筛选后内存排序；createdAt 格式固定，字符串比较即时间比较）──
const dir = order === "asc" ? 1 : -1;
filtered.sort((a, b) => {
  if (sort === "views") return (a.views - b.views) * dir;
  if (sort === "likes") return (a.likeCount - b.likeCount) * dir;
  if (sort === "photos") return (a.count - b.count) * dir;
  return a.createdAt < b.createdAt ? -dir : a.createdAt > b.createdAt ? dir : 0;
});

// ── 归档视图：按年月分组 ──
const archiveGroups = [];
if (view === "archive") {
  const m = new Map();
  for (const c of filtered) {
    const ym = c.createdAt.slice(0, 7);
    if (!m.has(ym)) m.set(ym, []);
    m.get(ym).push(c);
  }
  for (const [ym, list] of [...m.entries()].sort((a, b) => (a[0] < b[0] ? 1 : -1))) {
    archiveGroups.push({ ym, list });
  }
}

// ── 链接构造（保留其余参数）──
const baseParams = () => {
  const q = new URLSearchParams();
  if (cat1) q.set("cat1", cat1);
  if (cat2) q.set("cat2", cat2);
  if (sortActive) {
    q.set("sort", sort);
    q.set("order", order);
  }
  if (view === "archive") q.set("view", "archive");
  return q;
};
const catUrl = (c1: string, c2: string) => {
  const q = baseParams();
  if (c1) q.set("cat1", c1);
  else q.delete("cat1");
  if (c2) q.set("cat2", c2);
  else q.delete("cat2");
  const qs = q.toString();
  return qs ? `/gallery?${qs}` : "/gallery";
};
const sortUrl = (key: string, nextOrder: string) => {
  const q = baseParams();
  if (key === "time" && nextOrder === "desc") {
    q.delete("sort");
    q.delete("order");
  } else {
    q.set("sort", key);
    q.set("order", nextOrder);
  }
  const qs = q.toString();
  return qs ? `/gallery?${qs}` : "/gallery";
};
const viewUrl = (v: string) => {
  const q = baseParams();
  if (v === "archive") q.set("view", "archive");
  else q.delete("view");
  const qs = q.toString();
  return qs ? `/gallery?${qs}` : "/gallery";
};
const isFiltering = Boolean(cat1 || cat2) || sortActive;

// ── 标签样式全部前置计算（与文章页 TagFilter 同款胶囊样式）──
const tabBase = "inline-flex items-center gap-1.5 px-3.5 py-1.5 text-sm font-medium rounded-full border transition-all";
const tabOn = "bg-[var(--color-accent)] text-white border-[var(--color-accent)]";
const tabOff = "bg-[var(--color-surface)] text-[var(--color-text-muted)] border-[var(--color-border)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]";
const badgeOn = "bg-white/20 text-white";
const badgeOff = "bg-[var(--color-accent-muted)] text-[var(--color-accent)]";

const cat1Tabs = [{ name: "", label: "全部", count: cards.length }, ...l1Facets.map((f) => ({ name: f.name, label: f.name, count: f.count }))].map(
  (t) => {
    const active = cat1 === t.name;
    return {
      name: t.name,
      label: t.label,
      count: t.count,
      href: catUrl(t.name, ""),
      cls: `${tabBase} ${active ? tabOn : tabOff}`,
      badgeCls: active ? badgeOn : badgeOff,
    };
  },
);
const l2Select = cat1
  ? l2Facets.map((f) => ({
      name: f.name,
      count: f.count,
      href: catUrl(cat1, f.name),
      selected: cat2 === f.name,
    }))
  : [];
const sortTabs = [
  { key: "time", label: "时间" },
  { key: "views", label: "浏览量" },
  { key: "likes", label: "点赞数" },
  { key: "photos", label: "照片数" },
].map(({ key, label }) => {
  const active = sort === key;
  const nextOrder = active && order === "desc" ? "asc" : "desc";
  return {
    key,
    label: active ? `${label} ${order === "asc" ? "↑" : "↓"}` : label,
    href: sortUrl(key, nextOrder),
    cls: `${tabBase} ${active ? tabOn : tabOff}`,
  };
});
---

<Layout title="相册" description="按类型存放的相册 —— 点开即可左右切换浏览">
  <article class="py-12 md:py-16">
    <!-- Header -->
    <header class="mb-8">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-2">Gallery</p>
      <h1 class="text-3xl font-bold tracking-[-0.015em] mb-3">相册</h1>
      <div class="flex items-center gap-3 flex-wrap text-sm">
        <span class="text-[var(--color-text-muted)]">共 {filtered.length} 个相册</span>
        <a
          href={viewUrl(view === "archive" ? "card" : "archive")}
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-colors shadow-sm"
          title={view === "archive" ? "卡片视图" : "按年月浏览全部相册"}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
          {view === "archive" ? "卡片视图" : "归档"}
        </a>
        {
          authed && (
            <a
              href="/admin?tab=galleries"
              class="ml-auto inline-flex items-center gap-1 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
            >
              管理相册
            </a>
          )
        }
      </div>
    </header>

    <!-- 排序（点 inactive 项按倒序生效；再点一次切升降序） -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-subtle)] mr-1">排序</span>
      {
        sortTabs.map((t) => (
          <a href={t.href} class={t.cls}>
            {t.label}
          </a>
        ))
      }
    </div>

    <!-- 分类标签：一级胶囊（含计数徽章）+ 二级下拉（选中一级后出现）；清除筛选靠右（与文章页对齐） -->
    <div class="flex flex-wrap items-center gap-2 mb-6">
      <span class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-subtle)] mr-1">分类</span>
      {
        cat1Tabs.map((t) => (
          <a href={t.href} class={t.cls} role="tab">
            {t.label}
            <span class={`text-[10px] font-semibold px-1.5 py-0.5 rounded-full ${t.badgeCls}`}>{t.count}</span>
          </a>
        ))
      }
      {
        cat1 && l2Select.length > 0 && (
          <>
            <span class="text-[var(--color-text-subtle)] select-none" aria-hidden="true">›</span>
            <select
              class="px-3 py-1.5 text-sm font-medium rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:border-[var(--color-accent)] transition-all cursor-pointer"
              onchange="if (this.value) location.href = this.value;"
            >
              <option value={catUrl(cat1, "")} selected={!cat2}>全部</option>
              {l2Select.map((f) => (
                <option value={catUrl(cat1, f.name)} selected={f.selected}>{f.name}（{f.count}）</option>
              ))}
            </select>
          </>
        )
      }
      {
        isFiltering && (
          <a
            href={`/gallery${view === "archive" ? "?view=archive" : ""}`}
            class="ml-auto inline-flex items-center gap-1 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
          >
            <span>←</span> 清除全部筛选
          </a>
        )
      }
    </div>

    <!-- 相册卡片视图 -->
    {
      view !== "archive" && filtered.length > 0 && (
        <div class="grid gap-5 sm:grid-cols-2">
          {filtered.map((g, i) => (
            <a
              href={`/gallery/${g.id}`}
              class={`group block bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] rounded-2xl overflow-hidden transition-all duration-300 animate-[slide-up_0.5s_ease-out_both] ${
                i >= 2 ? "[animation-delay:150ms]" : i === 1 ? "[animation-delay:100ms]" : ""
              }`}
            >
              <div class="relative h-48 bg-[var(--color-bg)] border-b border-[var(--color-border)] overflow-hidden">
                {g.cover ? (
                  <img
                    src={g.cover}
                    alt={`${g.title} 封面`}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-4xl opacity-20" aria-hidden="true">🖼️</div>
                )}
                <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-surface)]/90 backdrop-blur border border-[var(--color-border)] px-2.5 py-1 text-[11px] font-medium text-[var(--color-text-muted)]">
                  {g.count} 张
                </span>
                {g.isPrivate && (
                  <span class="absolute top-3 left-3 inline-flex items-center gap-1 rounded-full bg-black/60 backdrop-blur px-2.5 py-1 text-[11px] font-medium text-white">
                    🔒 隐私
                  </span>
                )}
              </div>
              <div class="p-5">
                <div class="flex items-baseline gap-2.5">
                  <h2 class="text-lg font-bold text-[var(--color-text)]">{g.title}</h2>
                  <span class="text-[11px] font-mono tracking-[0.18em] uppercase text-[var(--color-text-subtle)]">{g.label}</span>
                </div>
                {g.description && <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-2">{g.description}</p>}
                <div class="mt-4 pt-4 border-t border-[var(--color-border)] flex items-center justify-between">
                  <span class="text-xs text-[var(--color-text-subtle)]">{g.createdAt}</span>
                  <span class="inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)]">
                    浏览
                    <span class="transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true">→</span>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )
    }

    <!-- 归档视图：按年月分组 -->
    {
      view === "archive" && filtered.length > 0 && (
        <div class="space-y-10">
          {archiveGroups.map((grp) => (
            <section>
              <h2 class="text-sm font-semibold tracking-wider text-[var(--color-text-subtle)] mb-3">{grp.ym}</h2>
              <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl divide-y divide-[var(--color-border)]">
                {grp.list.map((g) => (
                  <a href={`/gallery/${g.id}`} class="flex items-center gap-3 px-4 py-3 hover:bg-[var(--color-bg)] transition-colors">
                    <span class="flex-1 min-w-0 truncate text-sm font-medium text-[var(--color-text)]">{g.title}</span>
                    <span class="text-xs text-[var(--color-text-subtle)]">{g.label}</span>
                    <span class="text-xs text-[var(--color-text-subtle)]">{g.count} 张</span>
                    <span class="text-xs text-[var(--color-text-subtle)]">{g.createdAt}</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }

    {
      filtered.length === 0 && (
        <div class="rounded-2xl border border-dashed border-[var(--color-border)] p-8 text-center text-sm text-[var(--color-text-subtle)]">
          该分类下暂无相册
        </div>
      )
    }

    {
      authed && (
        <div class="mt-8 flex justify-end">
          <a href="/admin?tab=galleries" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors">
            管理相册
          </a>
        </div>
      )
    }
  </article>
</Layout>
