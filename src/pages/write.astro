---
import Layout from "../layouts/Layout.astro";
import { db } from "../db";
import { posts } from "../db/schema";
import { eq } from "drizzle-orm";

// Require auth
const authCookie = Astro.cookies.get("auth")?.value;
if (authCookie !== "true") {
  return Astro.redirect("/login");
}

// Edit mode: /write?edit=<slug>
const editSlug = Astro.url.searchParams.get("edit");
const editing = Boolean(editSlug);
const post = editSlug ? db.select().from(posts).where(eq(posts.slug, editSlug)).get() : undefined;
if (editing && !post) {
  return Astro.redirect("/write");
}

const editTags = (() => {
  if (!post) return "";
  try {
    return (JSON.parse(post.tags) as string[]).join(", ");
  } catch {
    return post.tags.replace(/[\[\]"]/g, "");
  }
})();

const pageTitle = editing ? "编辑文章" : "写文章";
---

<Layout title={pageTitle}>
  <div class="max-w-3xl mx-auto py-8">
    {
      editing && (
        <a
          href="/admin"
          class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-subtle)] hover:text-[var(--color-accent)] transition-colors mb-6 group"
        >
          <span class="inline-block transition-transform group-hover:-translate-x-1">←</span>
          返回文章管理
        </a>
      )
    }

    <h1 class="text-2xl font-bold tracking-[-0.01em] mb-8">{pageTitle}</h1>

    <form id="write-form" class="space-y-5">
      <input type="hidden" name="id" value={post?.id ?? ""} />
      <div>
        <label class="text-xs font-semibold text-[var(--color-text-subtle)] uppercase tracking-wider block mb-1.5">标题</label>
        <input
          type="text"
          name="title"
          placeholder="文章标题"
          maxlength={120}
          required
          value={post?.title ?? ""}
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all"
        />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-semibold text-[var(--color-text-subtle)] uppercase tracking-wider block mb-1.5">Slug（URL标识）</label>
          <input
            type="text"
            name="slug"
            placeholder="my-article-slug"
            maxlength={100}
            required
            value={post?.slug ?? ""}
            class="w-full px-4 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all"
          />
        </div>
        <div>
          <label class="text-xs font-semibold text-[var(--color-text-subtle)] uppercase tracking-wider block mb-1.5">标签（逗号分隔）</label>
          <input
            type="text"
            name="tags"
            placeholder="前端, React, TypeScript"
            maxlength={200}
            value={editTags}
            class="w-full px-4 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all"
          />
        </div>
      </div>

      <div>
        <label class="text-xs font-semibold text-[var(--color-text-subtle)] uppercase tracking-wider block mb-1.5">摘要</label>
        <textarea
          name="excerpt"
          placeholder="简短的文章摘要…"
          maxlength={300}
          rows={2}
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all resize-none"
        >{post?.excerpt ?? ""}</textarea>
      </div>

      <div>
        <label class="text-xs font-semibold text-[var(--color-text-subtle)] uppercase tracking-wider block mb-1.5">
          内容（Markdown 格式）
        </label>
        <textarea
          name="content"
          placeholder="## 标题&#10;&#10;正文内容…&#10;&#10;- 列表项"
          rows={16}
          required
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder:text-[var(--color-text-subtle)]/50 focus:outline-none focus:border-[var(--color-accent)] transition-all resize-y font-mono leading-relaxed"
        >{post?.content ?? ""}</textarea>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button
          type="submit"
          id="submit-btn"
          class="px-6 py-2.5 text-sm font-semibold rounded-xl bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-colors"
        >
          {editing ? "保存修改" : "发布文章"}
        </button>
        <a
          href={editing ? "/admin" : "/"}
          class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
        >
          取消
        </a>
        <p id="error" class="text-xs text-red-500 hidden ml-auto"></p>
        <p id="success" class="text-xs text-green-600 hidden ml-auto"></p>
      </div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById("write-form")!;
  const btn = document.getElementById("submit-btn")! as HTMLButtonElement;
  const error = document.getElementById("error")!;
  const success = document.getElementById("success")!;

  // Auto-generate slug from title
  const titleInput = form.querySelector("[name='title']") as HTMLInputElement;
  const slugInput = form.querySelector("[name='slug']") as HTMLInputElement;
  titleInput.addEventListener("input", () => {
    if (!slugInput.dataset.manual) {
      slugInput.value = titleInput.value
        .toLowerCase()
        .replace(/[^a-z0-9一-鿿]+/g, "-")
        .replace(/^-|-$/g, "")
        .slice(0, 80);
    }
  });
  slugInput.addEventListener("input", () => {
    slugInput.dataset.manual = "true";
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const postId = (form.querySelector("[name='id']") as HTMLInputElement).value;
    const editing = Boolean(postId);
    btn.textContent = editing ? "保存中…" : "发布中…";
    btn.disabled = true;
    error.classList.add("hidden");
    success.classList.add("hidden");

    const formData = new FormData(form);
    const tags = formData.get("tags")?.toString() || "";
    const tagArray = tags
      .split(/[,，]/)
      .map((t) => t.trim())
      .filter(Boolean);

    const body: Record<string, unknown> = {
      title: formData.get("title"),
      slug: formData.get("slug"),
      excerpt: formData.get("excerpt"),
      content: formData.get("content"),
      tags: JSON.stringify(tagArray),
    };
    if (editing) body.id = Number(postId);

    try {
      const res = await fetch("/api/posts", {
        method: editing ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (res.ok) {
        success.textContent = editing ? "保存成功！即将跳转…" : "发布成功！即将跳转…";
        success.classList.remove("hidden");
        setTimeout(() => {
          window.location.href = `/posts/${data.slug}`;
        }, 800);
      } else {
        error.textContent = data.error || (editing ? "保存失败" : "发布失败");
        error.classList.remove("hidden");
        btn.textContent = editing ? "保存修改" : "发布文章";
        btn.disabled = false;
      }
    } catch {
      error.textContent = "网络错误";
      error.classList.remove("hidden");
      btn.textContent = editing ? "保存修改" : "发布文章";
      btn.disabled = false;
    }
  });
</script>
