---
import Layout from "../layouts/Layout.astro";
import { db } from "../db";
import { posts, likes, comments, galleries, videos } from "../db/schema";
import { eq, sql, desc } from "drizzle-orm";
import { TRAVEL_CITIES } from "../lib/travel-cities";
import { FLASH_GAMES } from "../lib/flash-games";
import { RPG_GAMES } from "../lib/rpg-games";

export const prerender = false;

const travelCityCount = Object.keys(TRAVEL_CITIES).length;

// ── 内容统计 ──
const all = db
  .select({
    title: posts.title,
    content: posts.content,
    views: posts.views,
    createdAt: posts.createdAt,
    tags: posts.tags,
  })
  .from(posts)
  .where(eq(posts.published, true))
  .orderBy(desc(posts.createdAt))
  .all();

const totalPosts = all.length;
const totalWords = all.reduce((n, p) => n + p.content.replace(/\s/g, "").length, 0);
const totalViews = db.select({ v: sql<number>`coalesce(sum(${posts.views}), 0)` }).from(posts).where(eq(posts.published, true)).get()?.v ?? 0;
const totalLikes = db.select({ v: sql<number>`coalesce(sum(${likes.count}), 0)` }).from(likes).get()?.v ?? 0;
const totalComments = db.select({ n: sql<number>`count(*)` }).from(comments).get()?.n ?? 0;

// 标签数（一级分类）
const tagSet = new Set<string>();
for (const p of all) {
  try {
    const arr = JSON.parse(p.tags);
    if (Array.isArray(arr) && arr[0]) tagSet.add(arr[0]);
  } catch { /* 忽略坏数据 */ }
}

// 建站天数：最早一篇已发布文章起算
const earliest = all.reduce((min, p) => (p.createdAt < min ? p.createdAt : min), all[0]?.createdAt ?? "");
const days = earliest
  ? Math.max(1, Math.ceil((Date.now() - new Date(earliest.replace(" ", "T") + "Z").getTime()) / 86400000))
  : 0;
const earliestYear = earliest ? earliest.slice(0, 4) : "—";

// 趣味数据：最长的文章 / 发布最多的月份
const longest = all.reduce((m, p) => (p.content.length > m.content.length ? p : m), all[0]);
const monthCount = new Map<string, number>();
for (const p of all) {
  const key = p.createdAt.slice(0, 7); // YYYY-MM
  monthCount.set(key, (monthCount.get(key) ?? 0) + 1);
}
let bestMonth = "—", bestMonthN = 0;
for (const [k, v] of monthCount) if (v > bestMonthN) { bestMonth = k; bestMonthN = v; }

const fmt = (n: number) => (n >= 10000 ? `${(n / 10000).toFixed(1)} 万` : String(n));

// 媒体与游戏板块规模（仅公开内容；游戏数取注册表实时长度）
const publicGalleryCount = db.select({ n: sql<number>`count(*)` }).from(galleries).where(eq(galleries.isPrivate, 0)).get()?.n ?? 0;
const publicVideoCount = db.select({ n: sql<number>`count(*)` }).from(videos).where(eq(videos.isPrivate, 0)).get()?.n ?? 0;
// 游戏总数 = 内置经典 + Flash/RPG 注册表实时长度（游戏区整区受 NSFW 开关统控，无单款隐私标记，故全量计入）
const BUILTIN_GAMES = 5;
const totalGameCount = BUILTIN_GAMES + FLASH_GAMES.length + RPG_GAMES.length;

const cards = [
  { label: "建站天数", value: String(days), sub: `自 ${earliest.slice(0, 4)} 年起步` },
  { label: "文章总数", value: String(totalPosts), sub: `涵盖 ${tagSet.size} 个分类 · 另有相册 ${publicGalleryCount} · 视频 ${publicVideoCount} · 游戏 ${totalGameCount}` },
  { label: "总字数", value: fmt(totalWords), sub: "正文累计" },
  { label: "总浏览量", value: fmt(totalViews), sub: "详情页累计" },
];

const cards2 = [
  { label: "总点赞", value: String(totalLikes), sub: "读者认可" },
  { label: "总评论", value: String(totalComments), sub: "包括回复" },
  { label: "旅行足迹", value: `${travelCityCount} 城`, sub: "地图已点亮" },
  { label: "高产月份", value: bestMonth !== "—" ? `${bestMonthN} 篇` : "—", sub: bestMonth !== "—" ? bestMonth.replace("-", " 年 ") + " 月" : "暂无" },
];
---

<Layout title="关于本站" description="这个网站的技术栈、内容统计与运行状态">
  <article class="py-12 md:py-16 max-w-3xl mx-auto">
    <header class="mb-10 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">About This Site</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-3">关于本站</h1>
      <p class="text-sm text-[var(--color-text-muted)] font-serif leading-relaxed">
        一个由代码与好奇心驱动的角落 —— 这里记录它的规模与心跳。
      </p>
    </header>

    {/* 统计卡片 */}
    <div class="grid grid-cols-2 gap-3 mb-3 animate-[slide-up_0.5s_ease-out_both]">
      {cards.map((c) => (
        <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl p-5">
          <p class="text-[10px] font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)]">{c.label}</p>
          <p class="text-3xl font-bold tabular-nums tracking-tight text-[var(--color-text)] mt-1.5">{c.value}</p>
          <p class="text-[11px] text-[var(--color-text-subtle)] mt-1">{c.sub}</p>
        </div>
      ))}
    </div>
    <div class="grid grid-cols-2 gap-3 mb-10 animate-[slide-up_0.5s_ease-out_both] [animation-delay:100ms]">
      {cards2.map((c) => (
        <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl p-5">
          <p class="text-[10px] font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)]">{c.label}</p>
          <p class="text-3xl font-bold tabular-nums tracking-tight text-[var(--color-text)] mt-1.5">{c.value}</p>
          <p class="text-[11px] text-[var(--color-text-subtle)] mt-1">{c.sub}</p>
        </div>
      ))}
    </div>

    {/* 站点档案 */}
    <section class="mb-10 animate-[slide-up_0.5s_ease-out_both] [animation-delay:150ms]">
      <h2 class="text-lg font-bold tracking-tight text-[var(--color-text)] mb-4">站点档案</h2>
      <dl class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl divide-y divide-[var(--color-border)] text-sm">
        {[
          ["最早一篇文章", earliest ? `${earliest.slice(0, 4)} 年 ${Number(earliest.slice(5, 7))} 月` : "—"],
          ["最长的一篇", longest ? `《${longest.title}》（约 ${fmt(longest.content.replace(/\s/g, "").length)} 字）` : "—"],
          ["内容引擎", "Astro SSR · React Islands · Tailwind CSS v4"],
          ["数据层", "SQLite（better-sqlite3 + Drizzle ORM）+ FTS5 全文搜索"],
          ["字体与图片", "自托管字体 · 图片按需转 WebP 与响应式多尺寸"],
          ["媒体库", `相册 ${publicGalleryCount} 个 · 视频 ${publicVideoCount} 部 —— 隐私内容可上锁，上传图片自动转 WebP`],
          ["游戏板块", `内置经典 ×${BUILTIN_GAMES} · Flash 怀旧款 ×${FLASH_GAMES.length}（Ruffle 模拟器）· RPG Maker ×${RPG_GAMES.length} —— 登录游玩，存档云端同步`],
          ["站点功能", "侧栏实时天气 · 浏览历史 · TTS 听全文 · 显示设置（深色 / 护眼 / NSFW 开关）"],
        ].map(([k, v]) => (
          <div class="flex items-start gap-4 px-5 py-3.5">
            <dt class="w-28 flex-shrink-0 text-xs font-semibold text-[var(--color-text-subtle)] pt-0.5">{k}</dt>
            <dd class="flex-1 min-w-0 text-[var(--color-text-muted)] leading-relaxed font-serif break-words">{v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <p class="text-xs text-[var(--color-text-subtle)] leading-relaxed">
      统计数据每次打开本页实时计算。
      <a href="/about" class="text-[var(--color-accent)] hover:underline">了解我 →</a>
      <a href="/archive" class="text-[var(--color-accent)] hover:underline ml-3">归档 →</a>
    </p>
  </article>
</Layout>
