---
import Layout from "../layouts/Layout.astro";
import AccountPanel from "../components/AccountPanel.tsx";
import { db } from "../db";
import { profile } from "../db/schema";
import { eq } from "drizzle-orm";
import { AUTH_COOKIE, isAuthed } from "../lib/auth";

// 登录守卫：未登录去登录页，登录后回跳本页
const authed = isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value);
if (!authed) {
  return Astro.redirect("/login?next=/account");
}

const row = db.select().from(profile).where(eq(profile.id, 1)).get();
const initial = {
  name: row?.name ?? "kaven",
  bio: row?.bio ?? "",
  city: row?.city ?? "",
  gender: row?.gender ?? "",
  avatar: row?.avatar ?? "",
  github: row?.github ?? "",
  website: row?.website ?? "",
};
---

<Layout title="账户设置" description="账户信息、头像与密码管理">
  <div class="py-12 md:py-16">
    <header class="mb-8 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Account</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em]">账户设置</h1>
      <p class="mt-4 text-base text-[var(--color-text-muted)] leading-relaxed font-serif max-w-xl">
        管理头像、个人资料与登录密码 —— 改完即时生效。
      </p>
    </header>
    <div class="animate-[slide-up_0.5s_ease-out_both] [animation-delay:80ms]">
      <AccountPanel client:load initial={initial} />
    </div>
  </div>
</Layout>
