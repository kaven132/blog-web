---
import Layout from "../layouts/Layout.astro";
import LoginModal from "../components/LoginModal";
import { AUTH_COOKIE, isAuthed } from "../lib/auth";

// Redirect if already logged in
if (isAuthed(Astro.cookies.get(AUTH_COOKIE)?.value)) {
  return Astro.redirect("/write");
}

// ?next=/write：登录成功后回到来源页（write/admin 未登录跳转时带上）。
// 只接受站内路径，防开放跳转
const next = Astro.url.searchParams.get("next") || "/";
const safeNext = next.startsWith("/") && !next.startsWith("//") ? next : "/";
---

<Layout title="登录">
  <div class="max-w-sm mx-auto py-20 text-center">
    <h1 class="text-2xl font-bold tracking-[-0.01em] mb-2">登录</h1>
    <p class="text-sm text-[var(--color-text-muted)] font-serif">登录以管理博客内容</p>
  </div>

  <!-- 登录表单与顶栏弹窗是同一个组件（原先 /login 页另写一份，重复 ~110 行） -->
  <LoginModal client:load open={true} redirect={safeNext} closeRedirect="/" />
</Layout>
