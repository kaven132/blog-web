---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard";
import SearchBar from "../components/SearchBar";
import { db } from "../db";
import { posts, likes, galleries, galleryPhotos, galleryLikes } from "../db/schema";
import { desc, eq, sql, asc, inArray } from "drizzle-orm";

const recentPosts = db
  .select({
    title: posts.title,
    slug: posts.slug,
    excerpt: posts.excerpt,
    tags: posts.tags,
    coverImage: posts.coverImage,
    createdAt: posts.createdAt,
    likeCount: sql<number>`coalesce(${likes.count}, 0)`,
    views: posts.views,
    contentLen: sql<number>`length(${posts.content})`,
  })
  .from(posts)
  .leftJoin(likes, eq(likes.postId, posts.id))
  .where(eq(posts.published, true))
  .orderBy(desc(posts.createdAt))
  .limit(3)
  .all();

// 最新相册（仅公开）：3 个，封面取相册第一张照片
const recentGalleries = db
  .select({
    id: galleries.id,
    title: galleries.title,
    views: galleries.views,
    likeCount: sql<number>`coalesce(${galleryLikes.count}, 0)`,
    photoCount: sql<number>`(select count(*) from gallery_photos gp where gp.gallery_id = ${galleries.id})`,
  })
  .from(galleries)
  .leftJoin(galleryLikes, eq(galleryLikes.galleryId, galleries.id))
  .where(eq(galleries.isPrivate, 0))
  .orderBy(desc(galleries.createdAt))
  .limit(3)
  .all();
const recentGalleryIds = recentGalleries.map((g) => g.id);
const allGalleryPhotos = recentGalleryIds.length
  ? db
      .select({ galleryId: galleryPhotos.galleryId, path: galleryPhotos.path })
      .from(galleryPhotos)
      .where(inArray(galleryPhotos.galleryId, recentGalleryIds))
      .orderBy(asc(galleryPhotos.sort), asc(galleryPhotos.id))
      .all()
  : [];
const galleryCover = new Map();
for (const p of allGalleryPhotos) {
  if (!galleryCover.has(p.galleryId)) galleryCover.set(p.galleryId, p.path);
}
const recentGalleryCards = recentGalleries.map((g) => ({
  ...g,
  cover: galleryCover.get(g.id) ?? "",
}));
---

<Layout title="首页" description="一个专注于 Web 开发与工程实践的个人博客">
  <!-- Hero -->
  <section class="py-10 md:py-16 text-center">
    <div class="max-w-xl mx-auto">
      <div class="animate-[slide-up_0.5s_0.1s_ease-out_both]">
        <SearchBar client:load placeholder="搜索文章..." />
      </div>
    </div>
  </section>

  <!-- Latest posts -->
  <section class="pb-12">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-2">Latest</p>
        <h2 class="text-2xl font-bold tracking-[-0.01em]">最新文章</h2>
      </div>
      {
        recentPosts.length > 0 && (
          <a
            href="/posts"
            class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors group flex items-center gap-1"
          >
            查看全部
            <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        )
      }
    </div>

    {
      recentPosts.length === 0 ? (
        <div class="text-center py-24">
          <p class="text-[var(--color-text-muted)] text-base mb-3 font-serif">还没有文章</p>
          <p class="text-[var(--color-text-subtle)] text-sm">
            运行 <code class="bg-[var(--color-border)] px-2 py-0.5 rounded text-xs font-mono">npm run db:seed</code> 填充示例数据
          </p>
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post, i) => (
            <PostCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              tags={post.tags}
              coverImage={post.coverImage ?? undefined}
              createdAt={post.createdAt}
              likeCount={post.likeCount}
              views={post.views}
              contentLen={post.contentLen}
              index={i}
            />
          ))}
        </div>
      )
    }
  </section>

  <!-- Latest galleries -->
  {
    recentGalleryCards.length > 0 && (
      <section class="pb-12">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-2">Gallery</p>
            <h2 class="text-2xl font-bold tracking-[-0.01em]">最新相册</h2>
          </div>
          <a
            href="/gallery"
            class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors group flex items-center gap-1"
          >
            查看全部
            <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>

        <div class="grid gap-5 sm:grid-cols-3">
          {recentGalleryCards.map((g, i) => (
            <a
              href={`/gallery/${g.id}`}
              class={`group block bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] rounded-2xl overflow-hidden transition-all duration-300 animate-[slide-up_0.5s_ease-out_both] ${
                i === 0 ? "" : "[animation-delay:100ms]"
              }`}
            >
              <div class="relative h-40 bg-[var(--color-bg)] border-b border-[var(--color-border)] overflow-hidden">
                {g.cover ? (
                  <img
                    src={g.cover}
                    alt={`${g.title} 封面`}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center text-4xl opacity-20" aria-hidden="true">🖼️</div>
                )}
                <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-surface)]/90 backdrop-blur border border-[var(--color-border)] px-2.5 py-1 text-[11px] font-medium text-[var(--color-text-muted)]">
                  {g.photoCount} 张
                </span>
              </div>
              <div class="p-4">
                <h3 class="text-base font-semibold text-[var(--color-text)] truncate">{g.title}</h3>
                <p class="text-xs text-[var(--color-text-subtle)] mt-1.5">{g.likeCount} 点赞 · {g.views} 浏览</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Layout>