---
import Layout from "../layouts/Layout.astro";
import { db } from "../db";
import { posts, galleries, videos } from "../db/schema";
import { eq } from "drizzle-orm";
import { parseTags, getParentTag } from "../lib/tags";

export const prerender = false;

// ── 筛选参数：全部 / 文章 / 相册 / 视频（SSR 过滤，计数与分组始终真实） ──
const KINDS = [
  { id: "all", label: "全部" },
  { id: "post", label: "文章" },
  { id: "gallery", label: "相册" },
  { id: "video", label: "视频" },
] as const;
type KindId = (typeof KINDS)[number]["id"];
const kindParam = Astro.url.searchParams.get("kind") || "all";
const kind: KindId = KINDS.some((k) => k.id === kindParam) ? (kindParam as KindId) : "all";

interface ArchiveItem {
  kind: KindId;
  title: string;
  url: string;
  dateISO: string;
  year: string;
  month: number;
  day: number;
  /** 文章显示所属标签；相册/视频固定角标 */
  badge: string;
}

const toDateParts = (createdAt: string) => {
  const d = new Date(createdAt.replace(" ", "T") + "Z");
  return {
    dateISO: isNaN(d.getTime()) ? "" : d.toISOString(),
    year: isNaN(d.getTime()) ? "未知" : String(d.getFullYear()),
    month: isNaN(d.getTime()) ? 0 : d.getMonth() + 1,
    day: isNaN(d.getTime()) ? 0 : d.getDate(),
  };
};

const postItems: ArchiveItem[] = db
  .select({ title: posts.title, slug: posts.slug, createdAt: posts.createdAt, tags: posts.tags })
  .from(posts)
  .where(eq(posts.published, true))
  .all()
  .map((p) => ({
    kind: "post" as const,
    title: p.title,
    url: `/posts/${p.slug}`,
    ...toDateParts(p.createdAt),
    badge: getParentTag(parseTags(p.tags)),
  }));

const galleryItems: ArchiveItem[] = db
  .select({ id: galleries.id, title: galleries.title, createdAt: galleries.createdAt })
  .from(galleries)
  .where(eq(galleries.isPrivate, 0))
  .all()
  .map((g) => ({
    kind: "gallery" as const,
    title: g.title,
    url: `/gallery/${g.id}`,
    ...toDateParts(g.createdAt),
    badge: "相册",
  }));

const videoItems: ArchiveItem[] = db
  .select({ id: videos.id, title: videos.title, createdAt: videos.createdAt })
  .from(videos)
  .where(eq(videos.isPrivate, 0))
  .all()
  .map((v) => ({
    kind: "video" as const,
    title: v.title,
    url: `/videos/${v.id}`,
    ...toDateParts(v.createdAt),
    badge: "视频",
  }));

const everything = [...postItems, ...galleryItems, ...videoItems].sort((a, b) =>
  b.dateISO.localeCompare(a.dateISO)
);
const kindCount = (k: KindId) => everything.filter((i) => i.kind === k).length;
const totalCounts = { all: everything.length, post: kindCount("post"), gallery: kindCount("gallery"), video: kindCount("video") };

const items = kind === "all" ? everything : everything.filter((i) => i.kind === kind);

// 按年 → 月两级分组（倒序：近的在前）
const byYear = new Map<string, Map<number, ArchiveItem[]>>();
for (const p of items) {
  if (!byYear.has(p.year)) byYear.set(p.year, new Map());
  const m = byYear.get(p.year)!;
  if (!m.has(p.month)) m.set(p.month, []);
  m.get(p.month)!.push(p);
}
const years = [...byYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
for (const [, months] of years) {
  const sorted = [...months.entries()].sort((a, b) => b[0] - a[0]);
  months.clear();
  for (const [k, v] of sorted) months.set(k, v);
}
const spanYears = years.length;
const kindLabel = KINDS.find((k) => k.id === kind)?.label ?? "内容";
---

<Layout title="归档" description="全部内容的时间线归档 —— 文章、相册与视频按年月倒序，一路走来的每一步">
  <article class="py-12 md:py-16 max-w-3xl mx-auto">
    <header class="mb-8 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Archive</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-3">归档</h1>
      <p class="text-sm text-[var(--color-text-muted)] font-serif leading-relaxed">
        共 {items.length} 条{spanYears > 0 && <span> · 跨越 {spanYears} 年</span>} —— 写过的、拍过的、剪过的，都在这条时间线上。
      </p>
    </header>

    <!-- 类型筛选（SSR 参数过滤，计数恒为全量） -->
    {
      totalCounts.all > 0 && (
        <div class="flex items-center gap-2 flex-wrap mb-8 animate-[slide-up_0.5s_ease-out_both]">
          {KINDS.map((k) => {
            const active = kind === k.id;
            return (
              <a
                href={k.id === "all" ? "/archive" : `/archive?kind=${k.id}`}
                class={`px-3.5 py-1.5 rounded-full text-sm font-medium border transition-colors ${
                  active
                    ? "bg-[var(--color-accent)] text-white border-[var(--color-accent)]"
                    : "border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)]"
                }`}
              >
                {k.label}
                <span class="tabular-nums opacity-70 ml-1">{totalCounts[k.id]}</span>
              </a>
            );
          })}
        </div>
      )
    }

    {
      years.map(([year, months], yi) => (
        <section
          class="mb-10 animate-[slide-up_0.5s_ease-out_both]"
          style={`animation-delay: ${Math.min(yi * 80, 400)}ms`}
        >
          <div class="flex items-baseline gap-3 mb-4">
            <span class="text-2xl font-bold tabular-nums tracking-tight text-[var(--color-text)]">{year}</span>
            <span class="text-xs text-[var(--color-text-subtle)] font-mono">
              {[...months.values()].reduce((n, list) => n + list.length, 0)} 条
            </span>
            <span class="flex-1 h-px bg-[var(--color-border)]" />
          </div>

          {[...months.entries()].map(([month, list]) => (
            <div class="mb-6 sm:pl-2">
              <p class="text-xs font-semibold text-[var(--color-text-subtle)] mb-2 font-mono">
                {String(month).padStart(2, "0")} 月 · {list.length} 条
              </p>
              <ul class="space-y-1 border-l-2 border-[var(--color-border)] ml-1">
                {list.map((p) => (
                  <li>
                    <a
                      href={p.url}
                      class="group flex items-baseline gap-3 px-4 py-2 -ml-px border-l-2 border-transparent hover:border-[var(--color-accent)] hover:bg-[var(--color-surface)] transition-colors rounded-r-lg"
                    >
                      <time class="text-xs text-[var(--color-text-subtle)] tabular-nums flex-shrink-0 font-mono" dateTime={p.dateISO}>
                        {String(p.month).padStart(2, "0")}.{String(p.day).padStart(2, "0")}
                      </time>
                      <span class="flex-1 min-w-0 truncate text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)] transition-colors font-serif">
                        {p.title}
                      </span>
                      {p.kind === "post" && p.badge ? (
                        <span class="hidden sm:inline-flex flex-shrink-0 text-[10px] font-semibold tracking-wide uppercase px-1.5 py-0.5 rounded bg-[var(--color-accent-muted)] text-[var(--color-accent)]">
                          {p.badge}
                        </span>
                      ) : (
                        <span class="hidden sm:inline-flex flex-shrink-0 items-center gap-1 text-[10px] font-semibold tracking-wide uppercase px-1.5 py-0.5 rounded border border-[var(--color-border)] text-[var(--color-text-subtle)]">
                          {p.kind === "video" && "▶"}
                          {p.badge}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }

    {
      items.length === 0 && (
        <p class="text-center py-20 text-[var(--color-text-subtle)] font-serif">
          {totalCounts.all === 0 ? "还没有发布过内容。" : `还没有${kindLabel}。`}
        </p>
      )
    }
  </article>
</Layout>
