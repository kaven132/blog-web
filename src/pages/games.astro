---
import Layout from "../layouts/Layout.astro";
import GameLauncher from "../components/games/GameLauncher";

/**
 * 小游戏聚合页 —— 四款均已可玩（GameLauncher 岛屿弹窗对局）；
 * 新游戏上线：实现组件 → GameLauncher 加分支 → 下方 games 数组加一张卡片。
 */
const games = [
  {
    id: "tetris",
    title: "俄罗斯方块",
    subtitle: "TETRIS",
    desc: "经典落块益智游戏 —— 旋转、消行、连击加速，方块间见缝插针的几何美学。",
    tags: ["益智", "经典", "键盘操作"],
  },
  {
    id: "snake",
    title: "贪吃蛇",
    subtitle: "SNAKE",
    desc: "控制小蛇吃掉食物不断变长，撞墙或咬到自己即告终局，看谁的蛇更长。",
    tags: ["休闲", "街机", "键盘操作"],
  },
  {
    id: "2048",
    title: "2048",
    subtitle: "2048",
    desc: "滑动合并相同数字，直到拼出 2048 —— 越合越上瘾的数字益智经典。",
    tags: ["益智", "数字", "滑动操作"],
  },
  {
    id: "mines",
    title: "扫雷",
    subtitle: "MINESWEEPER",
    desc: "根据数字推理地雷位置，翻开所有安全格 —— 点击开路，长按插旗。",
    tags: ["推理", "经典", "点击操作"],
  },
];
---

<Layout title="小游戏" description="休息一下 —— 俄罗斯方块与贪吃蛇，即将上线">
  <article class="py-12 md:py-16">
    <!-- Header -->
    <header class="mb-10 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Games</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-4">小游戏</h1>
      <p class="text-base text-[var(--color-text-muted)] leading-relaxed font-serif max-w-xl">
        写代码之余放松一下。四款经典小游戏全部上线，不用装 App，打开浏览器就能来一局。
      </p>
    </header>

    <!-- Game cards -->
    <div class="grid gap-5 sm:grid-cols-2">
      {games.map((game, i) => (
        <div
          class={`group bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] rounded-2xl overflow-hidden transition-all duration-300 animate-[slide-up_0.5s_ease-out_both] ${
            i === 0 ? "" : "[animation-delay:100ms]"
          }`}
        >
          <!-- 预览区（占位示意图） -->
          <div class="relative h-36 bg-[var(--color-bg)] border-b border-[var(--color-border)] overflow-hidden">
            {game.id === "tetris" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <defs>
                  <pattern id="grid-tetris" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M20 0H0V20" fill="none" stroke="var(--color-border)" stroke-width="1" />
                  </pattern>
                </defs>
                <rect width="240" height="140" fill="url(#grid-tetris)" opacity="0.55" />
                <!-- 底部堆叠：O / I / L -->
                <g fill="var(--color-accent)">
                  <rect x="21.5" y="101.5" width="17" height="17" rx="2.5" opacity="0.9" />
                  <rect x="41.5" y="101.5" width="17" height="17" rx="2.5" opacity="0.9" />
                  <rect x="21.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.5" />
                  <rect x="41.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.5" />
                  <rect x="81.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="101.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="121.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="141.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="181.5" y="81.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <rect x="181.5" y="101.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <rect x="181.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <rect x="201.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <!-- 下落中的 T -->
                  <rect x="121.5" y="21.5" width="17" height="17" rx="2.5" opacity="0.85" />
                  <rect x="141.5" y="21.5" width="17" height="17" rx="2.5" opacity="0.85" />
                  <rect x="161.5" y="21.5" width="17" height="17" rx="2.5" opacity="0.85" />
                  <rect x="141.5" y="41.5" width="17" height="17" rx="2.5" opacity="0.85" />
                </g>
              </svg>
            )}
            {game.id === "snake" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <defs>
                  <pattern id="grid-snake" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M20 0H0V20" fill="none" stroke="var(--color-border)" stroke-width="1" />
                  </pattern>
                </defs>
                <rect width="240" height="140" fill="url(#grid-snake)" opacity="0.55" />
                <!-- 食物 -->
                <circle cx="190" cy="50" r="10" fill="none" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.35" />
                <circle cx="190" cy="50" r="5.5" fill="var(--color-accent)" />
                <!-- 蛇身 -->
                <polyline
                  points="50,90 50,70 110,70 110,110 150,110"
                  fill="none"
                  stroke="var(--color-accent)"
                  stroke-width="10"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  opacity="0.75"
                />
                <!-- 蛇头 + 眼睛 -->
                <circle cx="150" cy="110" r="7.5" fill="var(--color-accent-hover)" />
                <circle cx="152.5" cy="107.5" r="1.3" fill="white" />
              </svg>
            )}
            {game.id === "2048" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                {/* 4×4 底格 */}
                {Array.from({ length: 16 }).map((_, i) => {
                  const col = i % 4;
                  const row = Math.floor(i / 4);
                  return <rect x={63.5 + col * 29} y={13.5 + row * 29} width="26" height="26" rx="4" fill="#eae3d6" opacity="0.5" />;
                })}
                {/* 已拼出的数字块 */}
                <g font-family="inherit" font-weight="bold" text-anchor="middle">
                  <rect x={63.5} y={13.5} width="26" height="26" rx="4" fill="#f0e9dc" />
                  <text x={76.5} y={30.5} font-size="11" fill="#6b6357">2</text>
                  <rect x={92.5} y={13.5} width="26" height="26" rx="4" fill="#f0e9dc" />
                  <text x={105.5} y={30.5} font-size="11" fill="#6b6357">2</text>
                  <rect x={63.5} y={42.5} width="26" height="26" rx="4" fill="#eccfa5" />
                  <text x={76.5} y={59.5} font-size="11" fill="#fff">8</text>
                  <rect x={150.5} y={42.5} width="26" height="26" rx="4" fill="#e8bc85" />
                  <text x={163.5} y={59.5} font-size="10" fill="#fff">16</text>
                  <rect x={92.5} y={71.5} width="26" height="26" rx="4" fill="#db8b50" />
                  <text x={105.5} y={88.5} font-size="10" fill="#fff">64</text>
                  <rect x={121.5} y={100.5} width="26" height="26" rx="4" fill="#d37340" />
                  <text x={134.5} y={117.5} font-size="9" fill="#fff">128</text>
                  <rect x={150.5} y={100.5} width="26" height="26" rx="4" fill="#ca5c36" />
                  <text x={163.5} y={117.5} font-size="9" fill="#fff">256</text>
                </g>
              </svg>
            )}
            {game.id === "mines" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                {/* 5×3 迷你雷区 */}
                {[
                  // row 0
                  { x: 29, y: 16, covered: true }, { x: 66, y: 16, n: 1, color: "#8ba3b5" }, { x: 103, y: 16, covered: true }, { x: 140, y: 16, flag: true }, { x: 177, y: 16, covered: true },
                  // row 1
                  { x: 29, y: 53, n: 2, color: "#9cb491" }, { x: 66, y: 53, n: 1, color: "#d97a6a" }, { x: 103, y: 53, n: 1, color: "#8ba3b5" }, { x: 140, y: 53, covered: true }, { x: 177, y: 53, covered: true },
                  // row 2
                  { x: 29, y: 90, covered: true }, { x: 66, y: 90, n: 1, color: "#9cb491" }, { x: 103, y: 90, mine: true }, { x: 140, y: 90, covered: true }, { x: 177, y: 90, covered: true },
                ].map((cell) =>
                  cell.covered ? (
                    <rect x={cell.x} y={cell.y} width="34" height="34" rx="5" fill="#fff" stroke="#eae3d6" stroke-width="1.5" />
                  ) : (
                    <g>
                      <rect x={cell.x} y={cell.y} width="34" height="34" rx="5" fill="#f1ebdf" />
                      {cell.n && <text x={cell.x + 17} y={cell.y + 22} font-size="14" font-weight="bold" fill={cell.color} text-anchor="middle">{cell.n}</text>}
                      {cell.flag && (
                        <g>
                          <line x1={cell.x + 13} y1={cell.y + 8} x2={cell.x + 13} y2={cell.y + 26} stroke="#6b6357" stroke-width="2" />
                          <path d={`M${cell.x + 13} ${cell.y + 8} L${cell.x + 27} ${cell.y + 13} L${cell.x + 13} ${cell.y + 18} Z`} fill="var(--color-accent)" />
                        </g>
                      )}
                      {cell.mine && (
                        <g>
                          <circle cx={cell.x + 17} cy={cell.y + 17} r="8" fill="#b85a4a" />
                          <circle cx={cell.x + 14.5} cy={cell.y + 14.5} r="2" fill="#fff" opacity="0.7" />
                        </g>
                      )}
                    </g>
                  )
                )}
              </svg>
            )}
            <!-- 状态角标 -->
            <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-surface)]/90 backdrop-blur border border-[var(--color-border)] px-2.5 py-1 text-[11px] font-medium text-[var(--color-text-muted)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse" />
              可玩
            </span>
          </div>

          <!-- 信息区 -->
          <div class="p-5">
            <div class="flex items-baseline gap-2.5">
              <h2 class="text-lg font-bold text-[var(--color-text)]">{game.title}</h2>
              <span class="text-[11px] font-mono tracking-[0.18em] uppercase text-[var(--color-text-subtle)]">{game.subtitle}</span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{game.desc}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {game.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-full bg-[var(--color-bg)] border border-[var(--color-border)] text-[11px] font-medium text-[var(--color-text-muted)]">
                  {tag}
                </span>
              ))}
            </div>
            <div class="mt-4 pt-4 border-t border-[var(--color-border)] flex items-center justify-between">
              <span class="text-xs text-[var(--color-text-subtle)]">支持键盘 / 触屏</span>
              <GameLauncher client:load game={game.id} title={game.title} subtitle={game.subtitle} />
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- 更多游戏 -->
    <div class="mt-5 rounded-2xl border border-dashed border-[var(--color-border)] p-5 flex items-center gap-3.5 animate-[slide-up_0.5s_ease-out_both] [animation-delay:200ms]">
      <span class="w-9 h-9 flex-shrink-0 flex items-center justify-center rounded-full bg-[var(--color-accent-muted)] text-[var(--color-accent)]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </span>
      <p class="text-sm text-[var(--color-text-subtle)] leading-relaxed">
        更多小游戏排队开发中 —— 有想玩的经典款？欢迎在文章评论区留言点名。
      </p>
    </div>
  </article>
</Layout>
