---
import Layout from "../layouts/Layout.astro";
import GameLauncher from "../components/games/GameLauncher";

/**
 * 小游戏聚合页 —— 五款均已可玩（GameLauncher 岛屿弹窗对局）；
 * 新游戏上线：实现组件 → GameLauncher 加分支 → 下方 games 数组加一张卡片。
 */

const games = [
  {
    id: "tetris",
    title: "俄罗斯方块",
    subtitle: "TETRIS",
    desc: "经典落块益智游戏 —— 旋转、消行、连击加速，方块间见缝插针的几何美学。",
    tags: ["益智", "经典", "键盘操作"],
  },
  {
    id: "snake",
    title: "贪吃蛇",
    subtitle: "SNAKE",
    desc: "控制小蛇吃掉食物不断变长，撞墙或咬到自己即告终局，看谁的蛇更长。",
    tags: ["休闲", "街机", "键盘操作"],
  },
  {
    id: "2048",
    title: "2048",
    subtitle: "2048",
    desc: "滑动合并相同数字，直到拼出 2048 —— 越合越上瘾的数字益智经典。",
    tags: ["益智", "数字", "滑动操作"],
  },
  {
    id: "mines",
    title: "扫雷",
    subtitle: "MINESWEEPER",
    desc: "根据数字推理地雷位置，翻开所有安全格 —— 点击开路，长按插旗。",
    tags: ["推理", "经典", "点击操作"],
  },
  {
    id: "pacman",
    title: "吃豆人",
    subtitle: "PAC-MAN",
    desc: "吃光迷宫里的豆子，躲开四只性格各异的幽灵 —— 能量豆让你反客为主。",
    tags: ["街机", "经典", "键盘操作"],
  },
];
---

<Layout title="小游戏" description="休息一下 —— 五款经典小游戏，打开浏览器就能来一局">
  <article class="py-12 md:py-16">
    <!-- Header -->
    <header class="mb-10 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Games</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-4">小游戏</h1>
      <p class="text-base text-[var(--color-text-muted)] leading-relaxed font-serif max-w-xl">
        写代码之余放松一下。五款经典小游戏全部上线，不用装 App，打开浏览器就能来一局。
      </p>
    </header>

    <!-- Game cards -->
    <div class="grid gap-5 sm:grid-cols-2">
      {games.map((game, i) => (
        <div
          class={`group bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] rounded-2xl overflow-hidden transition-all duration-300 animate-[slide-up_0.5s_ease-out_both] ${
            i === 0 ? "" : "[animation-delay:100ms]"
          }`}
        >
          <!-- 预览区（占位示意图） -->
          <div class="relative h-36 bg-[var(--color-bg)] border-b border-[var(--color-border)] overflow-hidden">
            {game.id === "tetris" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <!-- 底部堆叠：O / I / L -->
                <g fill="var(--color-accent)">
                  <rect x="21.5" y="101.5" width="17" height="17" rx="2.5" opacity="0.9" />
                  <rect x="41.5" y="101.5" width="17" height="17" rx="2.5" opacity="0.9" />
                  <rect x="21.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.5" />
                  <rect x="41.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.5" />
                  <rect x="81.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="101.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="121.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="141.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.3" />
                  <rect x="181.5" y="81.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <rect x="181.5" y="101.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <rect x="181.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <rect x="201.5" y="121.5" width="17" height="17" rx="2.5" opacity="0.6" />
                  <!-- 下落中的 T -->
                  <rect x="121.5" y="21.5" width="17" height="17" rx="2.5" opacity="0.85" />
                  <rect x="141.5" y="21.5" width="17" height="17" rx="2.5" opacity="0.85" />
                  <rect x="161.5" y="21.5" width="17" height="17" rx="2.5" opacity="0.85" />
                  <rect x="141.5" y="41.5" width="17" height="17" rx="2.5" opacity="0.85" />
                </g>
              </svg>
            )}
            {game.id === "snake" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <!-- 食物 -->
                <circle cx="190" cy="50" r="10" fill="none" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.35" />
                <circle cx="190" cy="50" r="5.5" fill="var(--color-accent)" />
                <!-- 蛇身 -->
                <polyline
                  points="50,90 50,70 110,70 110,110 150,110"
                  fill="none"
                  stroke="var(--color-accent)"
                  stroke-width="10"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  opacity="0.75"
                />
                <!-- 蛇头 + 眼睛 -->
                <circle cx="150" cy="110" r="7.5" fill="var(--color-accent-hover)" />
                <circle cx="152.5" cy="107.5" r="1.3" fill="white" />
              </svg>
            )}
            {game.id === "2048" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" aria-hidden="true">
                {/* 4×4 棋盘底 */}
                {Array.from({ length: 16 }).map((_, i) => (
                  <rect x={62 + (i % 4) * 30} y={12 + Math.floor(i / 4) * 30} width="26" height="26" rx="5" fill="var(--color-accent)" opacity="0.07" />
                ))}
                {/* 数字块：同色透明度阶梯 */}
                {[
                  { c: 0, r: 0, v: "2", o: 0.4 }, { c: 1, r: 0, v: "2", o: 0.4 }, { c: 3, r: 0, v: "8", o: 0.6 },
                  { c: 2, r: 1, v: "32", o: 0.75 }, { c: 0, r: 2, v: "4", o: 0.55 }, { c: 3, r: 3, v: "128", o: 1 },
                ].map((t) => (
                  <g>
                    <rect x={62 + t.c * 30} y={12 + t.r * 30} width="26" height="26" rx="5" fill="var(--color-accent)" opacity={t.o} />
                    <text x={62 + t.c * 30 + 13} y={12 + t.r * 30 + 17} text-anchor="middle" font-size={t.v.length > 2 ? 9 : 11} font-weight="bold" fill="#fff">{t.v}</text>
                  </g>
                ))}
              </svg>
            )}
            {game.id === "mines" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" aria-hidden="true">
                {/* 5×3 覆盖格（淡珊瑚） */}
                {Array.from({ length: 15 }).map((_, i) => (
                  <rect x={29 + (i % 5) * 37} y={16 + Math.floor(i / 5) * 37} width="34" height="34" rx="5" fill="var(--color-accent)" opacity="0.08" />
                ))}
                {/* 数字 3 */}
                <text x="83" y="75" text-anchor="middle" font-size="14" font-weight="bold" fill="var(--color-accent)">3</text>
                {/* 旗 */}
                <line x1="157" y1="24" x2="157" y2="42" stroke="var(--color-text-subtle)" stroke-width="2" />
                <path d="M157 24 L169 29.5 L157 35 Z" fill="var(--color-accent)" />
                {/* 雷 */}
                <circle cx="120" cy="107" r="8" fill="var(--color-accent)" />
                <circle cx="117" cy="104" r="2" fill="#fff" opacity="0.7" />
              </svg>
            )}
            {game.id === "pacman" && (
              <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" aria-hidden="true">
                {/* 能量豆 */}
                <circle cx="30" cy="70" r="6" fill="var(--color-accent)" opacity="0.4" />
                {/* 吃豆人（朝右追，张嘴 25°）：sweep=0 才是朝右张嘴的正确弧向 */}
                <path d="M65 70 L79.5 63.2 A16 16 0 1 0 79.5 76.8 Z" fill="var(--color-accent)" />
                {/* 豆子 */}
                <circle cx="105" cy="70" r="3.5" fill="var(--color-accent)" opacity="0.5" />
                <circle cx="130" cy="70" r="3.5" fill="var(--color-accent)" opacity="0.5" />
                <circle cx="155" cy="70" r="3.5" fill="var(--color-accent)" opacity="0.5" />
                {/* 幽灵（被追，与吃豆人等高 32px：圆顶 54 → 裙边 86） */}
                <path d="M173 86 V66 A12 12 0 0 1 197 66 V86 l-3 -2.2 l-3 2.2 l-3 -2.2 l-3 2.2 l-3 -2.2 l-3 2.2 z" fill="var(--color-accent)" opacity="0.85" />
                <circle cx="181" cy="61" r="2.8" fill="#fff" />
                <circle cx="189" cy="61" r="2.8" fill="#fff" />
                <circle cx="180.2" cy="61.6" r="1.3" fill="#3b3a66" />
                <circle cx="189.8" cy="61.6" r="1.3" fill="#3b3a66" />
              </svg>
            )}
            <!-- 状态角标 -->
            <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-surface)]/90 backdrop-blur border border-[var(--color-border)] px-2.5 py-1 text-[11px] font-medium text-[var(--color-text-muted)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse" />
              可玩
            </span>
          </div>

          <!-- 信息区 -->
          <div class="p-5">
            <div class="flex items-baseline gap-2.5">
              <h2 class="text-lg font-bold text-[var(--color-text)]">{game.title}</h2>
              <span class="text-[11px] font-mono tracking-[0.18em] uppercase text-[var(--color-text-subtle)]">{game.subtitle}</span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{game.desc}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {game.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-full bg-[var(--color-bg)] border border-[var(--color-border)] text-[11px] font-medium text-[var(--color-text-muted)]">
                  {tag}
                </span>
              ))}
            </div>
            <div class="mt-4 pt-4 border-t border-[var(--color-border)] flex items-center justify-between">
              <span class="text-xs text-[var(--color-text-subtle)]">支持键盘 / 触屏</span>
              <GameLauncher client:load game={game.id} title={game.title} subtitle={game.subtitle} />
            </div>
          </div>
        </div>
      ))}

      <!-- Flash 游戏：独立页面（Ruffle 模拟器 + 存档云同步），卡片结构与五款内置游戏一致 -->
      <a
      href="/games/kakutoumusume"
      class="group bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] rounded-2xl overflow-hidden transition-all duration-300 animate-[slide-up_0.5s_ease-out_both] [animation-delay:150ms]"
    >
      <div class="relative h-36 bg-[var(--color-bg)] border-b border-[var(--color-border)] overflow-hidden">
        <svg viewBox="0 0 240 140" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          {/* 火柴人战斗：红色飞踢 vs 灰色格挡 */}
          {/* 红方（进攻，飞踢） */}
          <g stroke="var(--color-accent)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none">
            <line x1="80" y1="50" x2="68" y2="82" />
            <polyline points="68,82 100,78 124,72" />
            <polyline points="68,82 60,104 66,120" />
            <polyline points="78,56 56,64 46,74" />
            <polyline points="78,56 94,44 102,32" />
          </g>
          <circle cx="78" cy="38" r="9" fill="var(--color-accent)" />
          {/* 灰方（防守，双臂格挡后仰） */}
          <g stroke="var(--color-text-subtle)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.75">
            <line x1="162" y1="54" x2="170" y2="84" />
            <polyline points="170,84 162,112 168,120" />
            <polyline points="170,84 178,106 176,120" />
            <line x1="162" y1="58" x2="136" y2="50" />
            <line x1="162" y1="68" x2="138" y2="42" />
          </g>
          <circle cx="160" cy="42" r="8" fill="var(--color-text-subtle)" opacity="0.75" />
          {/* 命中冲击星 */}
          <g stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" opacity="0.9">
            <path d="M134 60 l8 -7 M138 70 l10 -2 M132 50 l2 -10" />
          </g>
          {/* 地面 */}
          <line x1="26" y1="124" x2="214" y2="124" stroke="var(--color-border-hover)" stroke-width="2" stroke-linecap="round" opacity="0.7" />
        </svg>
        <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-surface)]/90 backdrop-blur border border-[var(--color-border)] px-2.5 py-1 text-[11px] font-medium text-[var(--color-text-muted)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse" />
          可玩
        </span>
      </div>
      <div class="p-5">
        <div class="flex items-baseline gap-2.5">
          <h2 class="text-lg font-bold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">格斗</h2>
          <span class="text-[11px] font-mono tracking-[0.18em] uppercase text-[var(--color-text-subtle)]">Flash · Ruffle</span>
        </div>
        <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">
          Flash 时代的格斗经典「被误认为仇人 格斗娘」—— Ruffle 模拟器网页运行，剧情 + 战斗，登录后存档自动云同步，还能导入本地 .sol。
        </p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <span class="px-2 py-0.5 rounded-full bg-[var(--color-bg)] border border-[var(--color-border)] text-[11px] font-medium text-[var(--color-text-muted)]">格斗</span>
          <span class="px-2 py-0.5 rounded-full bg-[var(--color-bg)] border border-[var(--color-border)] text-[11px] font-medium text-[var(--color-text-muted)]">剧情</span>
          <span class="px-2 py-0.5 rounded-full bg-[var(--color-bg)] border border-[var(--color-border)] text-[11px] font-medium text-[var(--color-text-muted)]">存档云同步</span>
        </div>
        <div class="mt-4 pt-4 border-t border-[var(--color-border)] flex items-center justify-between">
          <span class="text-xs text-[var(--color-text-subtle)]">首次加载约 46MB</span>
          <span class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-accent)]">
            进入游戏
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </div>
      </div>
      </a>
    </div>

    <!-- 更多游戏 -->
    <div class="mt-5 rounded-2xl border border-dashed border-[var(--color-border)] p-5 flex items-center gap-3.5 animate-[slide-up_0.5s_ease-out_both] [animation-delay:200ms]">
      <span class="w-9 h-9 flex-shrink-0 flex items-center justify-center rounded-full bg-[var(--color-accent-muted)] text-[var(--color-accent)]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </span>
      <p class="text-sm text-[var(--color-text-subtle)] leading-relaxed">
        更多小游戏排队开发中 —— 有想玩的经典款？欢迎在文章评论区留言点名。
      </p>
    </div>
  </article>
</Layout>
