---
/**
 * Flash 游戏（Ruffle 运行）页面主体 —— 由 /games/[id].astro 按 kind 分发渲染。
 */
interface Props {
  game: import("../../lib/flash-games").FlashGame;
  ruffleVersion: string;
}
const { game, ruffleVersion } = Astro.props;
---

  <article class="py-12 md:py-16 max-w-4xl mx-auto">
    <header class="mb-6 animate-[slide-up_0.5s_ease-out_both]">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-subtle)] mb-3">Flash Game · Ruffle</p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-[-0.02em] mb-3">{game.title} <span class="text-lg text-[var(--color-text-subtle)] font-normal">{game.orig}</span></h1>
      <p class="text-base text-[var(--color-text-muted)] leading-relaxed font-serif">
        Ruffle 模拟器网页运行。鼠标点击推进剧情 / 选项，战斗中用键盘方向键移动、Z 轻击 X 重击。
        登录状态下游玩进度自动云同步 —— 换电脑也能续玩，本地 Flash 播放器的 .sol 存档也能导入。
      </p>
      <a href="/games" class="inline-flex items-center gap-1 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors mt-3">
        <span>←</span> 返回小游戏
      </a>
    </header>

    <!-- 存档同步栏（页面仅登录可见，进度随账号走；data-* 供脚本读取游戏标识） -->
    <div id="sync-bar" class="mb-4 flex items-center gap-2 flex-wrap text-sm" data-game={game.id} data-sol={game.solName}>
      <span id="sync-status" class="text-[var(--color-text-subtle)] font-mono text-xs">存档同步：初始化…</span>
      <span class="flex-1"></span>
      <button type="button" id="btn-upload" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors">上传存档</button>
      <button type="button" id="btn-restore" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors">从云端恢复</button>
      <button type="button" id="btn-download" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors">下载 .sol</button>
      <label class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors cursor-pointer">
        导入 .sol<input type="file" id="file-import" accept=".sol" class="hidden" />
      </label>
    </div>

    <!-- 播放控制：音量 / 双全屏 -->
    <div class="mb-4 flex items-center gap-3 flex-wrap text-sm">
      <span class="flex items-center gap-2 text-[var(--color-text-muted)]">
        <span aria-hidden="true">🔊</span>
        <input id="vol-slider" type="range" min="0" max="100" step="1" value="100" class="w-32 accent-[var(--color-accent)]" aria-label="游戏音量" />
      </span>
      <span class="flex-1"></span>
      <button type="button" id="btn-webfs" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors">网页全屏</button>
      <button type="button" id="btn-osfs" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-colors">屏幕全屏</button>
    </div>

    <!-- Ruffle 舞台（player 由脚本动态创建，避免自定义元素注册时序问题） -->
    <div id="stage" class="rounded-2xl overflow-hidden border border-[var(--color-border)] bg-black animate-[slide-up_0.5s_ease-out_both] [animation-delay:100ms]"></div>

    <p class="text-xs text-[var(--color-text-subtle)] mt-4 leading-relaxed">
      本页面为个人收藏性质的本地游玩用途，游戏版权归原作者所有，请勿二次分发；
      {game.footer}，剧情场景按需加载。
    </p>
  </article>

<style is:global>
  /* 网页全屏：舞台脱离文档流铺满视口，播放器保持 4:3 居中 */
  #stage.web-full { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; background: #000; border: none; border-radius: 0; }
  #stage.web-full > ruffle-player { width: auto !important; height: 100% !important; aspect-ratio: 4 / 3 !important; }
  body.web-full-lock { overflow: hidden; }
  /* 屏幕全屏：Fullscreen API 元素铺满，播放器同样 4:3 居中 */
  #stage:fullscreen { display: flex; align-items: center; justify-content: center; background: #000; }
  #stage:fullscreen > ruffle-player { width: auto !important; height: 100% !important; aspect-ratio: 4 / 3 !important; }
</style>

<script src={`/ruffle/ruffle.js?v=${ruffleVersion}`} data-astro-rerun></script>
<script data-astro-rerun>
  // Ruffle 启动 + 存档云同步（页面转场后需重执行，data-astro-rerun 不做 TS 编译——只写纯 JS）
  (() => {
    const bar = document.getElementById("sync-bar");
    const GAME_ID = bar ? bar.dataset.game : "";
    const SOL_NAME = bar ? bar.dataset.sol : "";
    const SOL_EXT = "/" + SOL_NAME;
    const authed = document.getElementById("btn-upload") !== null;
    const statusEl = document.getElementById("sync-status");
    const setStatus = (t) => { if (statusEl) statusEl.textContent = "存档同步：" + t; };
    if (!GAME_ID || !SOL_NAME) { setStatus("配置缺失"); return; }

    // ── sol 键定位：Ruffle 的真实键 = "主机名//sol名"（不含端口、与页面路径无关，游戏启动时即写入）。
    // 读写永远优先真实键；扫描其余后缀匹配键兜底（历史/多路径变体），恢复时把候选也写上，多写的键无害。
    const solKeyCandidates = () => [
      location.hostname + "//" + SOL_NAME,
      location.hostname + (location.pathname.replace(/\/+$/, "") || "/") + SOL_EXT,
      location.hostname + "/games/" + GAME_ID + "/swf/main.swf" + SOL_EXT,
    ];
    const findLocalSol = () => {
      const preferred = location.hostname + "//" + SOL_NAME;
      if (localStorage.getItem(preferred) !== null) return { key: preferred, data: localStorage.getItem(preferred) };
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && k.endsWith(SOL_EXT) && k.startsWith(location.hostname)) {
          return { key: k, data: localStorage.getItem(k) };
        }
      }
      return null;
    };
    const writeLocalSol = (b64) => {
      for (const k of solKeyCandidates()) localStorage.setItem(k, b64);
    };

    // ── 存档归属标记：登录态强制以云端档为准覆盖本地；未登录遇到其他账号残留即清空，保证账号间进度隔离 ──
    const SOL_OWNER = SOL_NAME + "#owner";
    const setOwner = (o) => localStorage.setItem(SOL_OWNER, o);
    const getOwner = () => localStorage.getItem(SOL_OWNER);
    const clearLocalSol = () => {
      const ks = [];
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && k.endsWith(SOL_EXT) && k.startsWith(location.hostname)) ks.push(k);
      }
      for (const k of ks) localStorage.removeItem(k);
    };

    let lastSynced = null; // 上次成功同步到云端的 base64，避免重复上传

    // ── 等待 Ruffle 运行时就绪：转场（ClientRouter）重执行脚本时，外链 ruffle.js 是异步加载的，
    // 而内联 boot 同步先跑 —— 不等待直接 newest() 必报「游戏加载失败」。轮询至 newest 可用（上限 10 秒）。──
    const waitForRuffle = async () => {
      for (let i = 0; i < 100; i++) {
        if (window.RufflePlayer && typeof window.RufflePlayer.newest === "function") return true;
        await new Promise((r) => setTimeout(r, 100));
      }
      return false;
    };

    // ── 云端操作 ──
    const cloudGet = () =>
      fetch("/api/game-save?game=" + GAME_ID, { headers: { Accept: "application/json" } }).then((r) => (r.ok ? r.json() : null));
    const cloudPut = (b64) =>
      fetch("/api/game-save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ game: GAME_ID, data: b64 }),
      });

    // 启动顺序：先同步云端（登录时云端档强制生效），再启动 Ruffle —— 保证游戏首屏读到的就是当前账号的档
    const boot = async () => {
      if (authed) {
        try {
          const cloud = await cloudGet();
          if (cloud && cloud.data) {
            writeLocalSol(cloud.data);
            lastSynced = cloud.data;
            setOwner("admin");
            setStatus("已同步账号存档（" + cloud.size + " 字节）");
          } else if (cloud) {
            clearLocalSol();
            setOwner("admin");
            setStatus("账号暂无存档 —— 已初始化空白进度");
          } else {
            setStatus("云端状态获取失败");
          }
        } catch {
          setStatus("云端状态获取失败");
        }
      } else {
        if (getOwner() !== "anon") {
          clearLocalSol();
          setOwner("anon");
        }
        setStatus("未登录 —— 游玩进度保存在本浏览器，登录后云同步到账号");
      }

      // 启动 Ruffle
      try {
        if (!(await waitForRuffle())) throw new Error("runtime-timeout");
        window.RufflePlayer = window.RufflePlayer || {};
        window.RufflePlayer.config = {
          autoplay: "on",
          unmuteOverlay: "hidden",
          contextMenu: "on", // 右键菜单内置 Save Manager，可手动导入/导出 .sol 兜底
          letterbox: "off",
          scale: "showAll",
        };
        const ruffle = window.RufflePlayer.newest();
        const player = ruffle.createPlayer();
        player.style.cssText = "display:block;width:100%;aspect-ratio:4/3;";
        document.getElementById("stage").appendChild(player);
        // base 指向 SWF 目录：游戏内 sub/xxx.swf 相对路径按 SWF 而非页面 URL 解析
        await player.load({ url: "/games/" + GAME_ID + "/swf/main.swf", base: "/games/" + GAME_ID + "/swf/", allowScriptAccess: false });
        applyVolume();
        setStatus((statusEl.textContent || "").replace("存档同步：", "") + " · 游戏已就绪");
      } catch (e) {
        setStatus(e && e.message === "runtime-timeout" ? "模拟器加载超时 —— 请检查网络后刷新重试" : "游戏加载失败，请刷新重试");
      }
    };

    // ── 自动上传：定期 + 离开页面时，本地档与上次同步不一致就推 ──
    const uploadIfChanged = async () => {
      if (!authed) return false;
      const local = findLocalSol();
      if (!local || !local.data || local.data === lastSynced) return false;
      try {
        const res = await cloudPut(local.data);
        if (res && res.ok) {
          lastSynced = local.data;
          setStatus("已自动上传存档 " + new Date().toLocaleTimeString());
          return true;
        }
      } catch { /* 离线时静默，下次再试 */ }
      return false;
    };

    boot();

    // ── 崩溃自动恢复：Ruffle nightly 偶发核心递归崩溃（Maximum call stack size exceeded，
    // 结局画廊回放/特定场景触发，实例随后死锁白屏）。捕获后自动刷新恢复；
    // sessionStorage 防循环刷新（一次会话只自动恢复一次，再崩则转手动提示）。──
    window.addEventListener("error", (e) => {
      const msg = String((e && e.message) || "");
      if (!/Maximum call stack size exceeded/i.test(msg)) return;
      if (sessionStorage.getItem("ruffle-crash-reloaded")) {
        setStatus("模拟器遇到已知缺陷崩溃了 —— 请手动刷新页面恢复");
        return;
      }
      sessionStorage.setItem("ruffle-crash-reloaded", "1");
      setStatus("模拟器遇到已知缺陷，正在自动恢复…");
      setTimeout(() => location.reload(), 1000);
    });

    // ── 播放控制：音量 / 网页全屏 / 屏幕全屏 ──
    const VOL_KEY = "game-volume";
    const stageEl = document.getElementById("stage");
    const volSlider = document.getElementById("vol-slider");
    const btnWebFs = document.getElementById("btn-webfs");
    const btnOsFs = document.getElementById("btn-osfs");
    const getVolume = () => {
      const v = Number(localStorage.getItem(VOL_KEY));
      return Number.isFinite(v) && v >= 0 && v <= 100 ? v : 100;
    };
    const applyVolume = () => {
      const player = stageEl && stageEl.querySelector("ruffle-player");
      if (!player) return;
      try { player.volume = getVolume() / 100; } catch { /* API 不可用时静默 */ }
    };
    volSlider.value = getVolume();
    volSlider.addEventListener("input", () => {
      localStorage.setItem(VOL_KEY, volSlider.value);
      applyVolume();
    });

    const isWebFull = () => stageEl.classList.contains("web-full");
    const setWebFull = (on) => {
      stageEl.classList.toggle("web-full", on);
      document.body.classList.toggle("web-full-lock", on);
      btnWebFs.textContent = on ? "退出网页全屏" : "网页全屏";
    };
    btnWebFs.addEventListener("click", () => setWebFull(!isWebFull()));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isWebFull() && !document.fullscreenElement) setWebFull(false);
    });
    btnOsFs.addEventListener("click", () => {
      try {
        if (document.fullscreenElement) { document.exitFullscreen(); return; }
        const req = stageEl.requestFullscreen && stageEl.requestFullscreen();
        if (req && req.catch) req.catch(() => setStatus("浏览器拒绝了全屏请求"));
      } catch { setStatus("当前环境不支持屏幕全屏"); }
    });
    document.addEventListener("fullscreenchange", () => {
      btnOsFs.textContent = document.fullscreenElement ? "退出屏幕全屏" : "屏幕全屏";
    });

    setInterval(uploadIfChanged, 60000);
    window.addEventListener("beforeunload", () => { uploadIfChanged(); });
    document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") uploadIfChanged(); });

    // ── 手动按钮 ──
    document.getElementById("btn-upload")?.addEventListener("click", async () => {
      setStatus("上传中…");
      const ok = await uploadIfChanged();
      if (!ok) {
        const local = findLocalSol();
        if (!local) setStatus("本地还没有存档");
        else if (local.data === lastSynced) setStatus("云端已是最新");
        else setStatus("上传失败，请稍后再试");
      }
    });

    document.getElementById("btn-restore")?.addEventListener("click", async () => {
      setStatus("恢复中…");
      try {
        const cloud = await cloudGet();
        if (cloud && cloud.data) {
          writeLocalSol(cloud.data);
          setStatus("已恢复，正在刷新…");
          setTimeout(() => location.reload(), 600);
        } else {
          setStatus("云端暂无存档");
        }
      } catch {
        setStatus("恢复失败，请稍后再试");
      }
    });

    document.getElementById("btn-download")?.addEventListener("click", () => {
      const local = findLocalSol();
      if (!local) { setStatus("本地还没有存档"); return; }
      const bin = atob(local.data.replace(/\s+/g, ""));
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const url = URL.createObjectURL(new Blob([bytes], { type: "application/octet-stream" }));
      const a = document.createElement("a");
      a.href = url;
      a.download = SOL_NAME + ".sol";
      a.click();
      URL.revokeObjectURL(url);
      setStatus("已导出 .sol 文件");
    });

    document.getElementById("file-import")?.addEventListener("change", (ev) => {
      const file = ev.target.files && ev.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        const bytes = new Uint8Array(reader.result);
        let bin = "";
        for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
        const b64 = btoa(bin);
        writeLocalSol(b64);
        setStatus("已导入 " + file.name + "，正在刷新…");
        setTimeout(() => location.reload(), 600);
      };
      reader.readAsArrayBuffer(file);
      ev.target.value = "";
    });
  })();
</script>
